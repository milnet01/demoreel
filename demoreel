class _CaptionText(argparse.Action):
    """`caption --text`: each one starts a new text."""

    def __call__(self, parser, namespace, values, option_string=None):
        texts = list(getattr(namespace, self.dest) or [])
        texts.append({"words": values})
        setattr(namespace, self.dest, texts)


class _CaptionField(argparse.Action):
    """`caption --from`, `--to` and `--text-size` belong to the --text before
    them. One given before any --text is refused: caption never cuts."""

    def __call__(self, parser, namespace, values, option_string=None):
        if not namespace.texts:
            parser.error(tr("{option} belongs to a --text, and none comes "
                            "before it. caption never cuts the video; use trim.",
                            option=option_string))
        namespace.texts[-1][self.dest] = values


_text_fonts = {}


def text_font(name=None, where=None):
    """The drawtext option naming a text's font: the one its line names, else
    the machine's own bold sans, so the same line measures differently on two
    machines (README says so).

    Asked of fontconfig's fc-match and passed as a file. drawtext's own `font`
    option takes a fontconfig pattern, and measured here it ignores the weight
    in one: Sans:bold, Sans:style=Bold and Sans:weight=bold all drew the
    regular face, 310 pixels wide where the bold file draws 332. Without
    fc-match, or with a path the filter syntax cannot carry, the machine's
    font is drawn in the regular face rather than not at all.

    A font the line names is refused rather than swapped. fc-match never says
    no: asked for a font the machine lacks it answers with another (measured:
    "Noto Sans Mono" came back as Liberation Mono). So the family it answers
    with is compared with the one asked for. A name with a slash in it is a
    font file and is used as it is.
    """
    if name in _text_fonts:
        return _text_fonts[name]
    families = ""
    if name and "/" in name:
        found = str(Path(name).expanduser())
        if not Path(found).is_file():
            die(tr("{where}: there is no font file {path}", where=where, path=found))
    else:
        # A hyphen in a fontconfig pattern starts a size, so one in a family's
        # name is escaped: unescaped, "Goha-Tibeb Zemen" came back as Roboto.
        family, colon, rest = (name or "sans:bold").partition(":")
        pattern = family.replace("-", "\\-") + colon + rest
        try:
            answer = subprocess.run(
                ["fc-match", "-f", "%{file}\n%{family}", pattern],
                capture_output=True, text=True, timeout=CALL_TIMEOUT,
                check=False).stdout
        except (OSError, subprocess.TimeoutExpired):
            answer = ""
        found, _, families = answer.strip().partition("\n")
    if name and "/" not in name:
        asked = name.split(":")[0].strip()
        if not found:
            die(tr("{where}: a font is found by its name with fc-match, which "
                   "gave no answer here. Give the font's file instead: "
                   "font /path/to/font.ttf", where=where))
        if asked.lower() not in [f.strip().lower() for f in families.split(",")]:
            die(tr("{where}: this machine has no font named {font}; the "
                   "nearest it offers is {nearest}.\n"
                   "  `fc-list : family` lists the names it has.", where=where,
                   font=repr(asked), nearest=repr(families.split(",")[0])))
    usable = bool(found) and Path(found).is_file() \
        and not set(found) & set("':\\,;[]")
    if name and not usable:
        die(tr("{where}: the font file {path} has a character in its path that "
               "ffmpeg's filters cannot carry. Copy it to a plainer path.",
               where=where, path=found))
    _text_fonts[name] = f"fontfile='{found}'" if usable else "font='Sans'"
    return _text_fonts[name]


_box_can_be_sized = None


def box_can_be_sized():
    """Whether this ffmpeg's drawtext can make its box a size of our choosing
    (`boxw`), which is how a band fades with its text: drawbox cannot change
    with time. Present in ffmpeg 6.1.1 and 8.1.2, the two measured. An ffmpeg
    without it draws its bands with drawbox, and a band that fades is
    refused."""
    global _box_can_be_sized  # noqa: PLW0603 - asked once per run
    if _box_can_be_sized is None:
        try:
            told = subprocess.run(
                ["ffmpeg", "-hide_banner", "-h", "filter=drawtext"],
                capture_output=True, text=True, timeout=CALL_TIMEOUT,
                check=False).stdout
        except (OSError, subprocess.TimeoutExpired):
            told = ""
        _box_can_be_sized = bool(re.search(r"^\s+boxw\s", told, re.MULTILINE))
    return _box_can_be_sized


# A caption's band is this many times its text's height, and a card keeps this
# share of the frame clear at each edge.
CAPTION_BAND = 2.0
CARD_MARGIN = 0.05
# Texts on screen together at one place are stacked (DEMO-0153): two lines off
# a band are this share of the taller one's size apart, and a sliding text
# rises this share of its size into place. The Slipcase builder's 30 px gap
# under 92 px lines, and its 36 px rise on lines of 64 to 92 px.
LINE_GAP = 0.3
SLIDE_RISE = 0.5
# A time may overshoot the end of its file by this much and still mean the
# end: `motion` prints three decimals, so its own figure can round up.
TIME_SLACK = 0.0006


def frame_at(moment, step):
    """The number of the frame on screen at `moment`, with frames `step`
    apart. A moment up to TIME_SLACK before a frame starts means that frame:
    `motion` prints three decimals, so a frame starting at 1.33333 comes back
    as 1.333, and README says its numbers can be used as they are
    (DEMO-0137)."""
    return math.floor((moment + TIME_SLACK) / step + 1e-9)


