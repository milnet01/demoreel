class Scene:
    """One scene of a film: part of a video, or a card.

    `where` names it in an error: "line 3" for a script, the file's name for a
    shortcut. Times on a clip are in its file's own time, as the caller wrote
    them; check_film turns them into times from the scene's start.
    """

    def __init__(self, kind, where):
        self.kind = kind
        self.where = where
        self.path = None        # a clip's video; a card's picture, or None
        self.start = 0.0        # a clip: the part kept
        self.end = None
        self.seconds = None     # a card: how long it lasts
        # A card's colour; a clip's, round its window, only when given.
        self.background = CARD_BACKGROUND if kind == "card" else None
        self.fade_in = self.fade_out = self.crossfade = 0.0
        self.transition = "fade"  # the picture a crossfade takes
        self.fade_at = []
        self.fade_length = FADE_LENGTH
        self.texts = []         # each: words, start, end, size, where
        self.info = None        # what ffprobe says of `path`
        self.frames = 1         # a card's picture: more than 1 if animated
        self.sound = "on"       # a clip: keep its own sound
        self.volume = None      # a clip: dB on its own sound
        self.has_sound = False  # a clip: its file has a sound stream
        self.speed = 1.0        # a clip: 2 plays it twice as fast
        self.hold = 0.0         # a clip: seconds its last frame stays after it
        self.reveal = 0.0       # a card: seconds its picture takes to arrive
        self.window = None      # a clip: its window's share of the room, or None
        self.box = None         # a windowed clip: (x, y, w, h) of its window
        self.push = 0.0         # a windowed clip: % its window grows over the scene
        self.zoom = None        # a windowed clip: its zoom line, a dict, or None
        self.stacks = []        # its texts' stacks, laid out by check_texts


# The film's sound: every stream is made this before it is joined or mixed.
SOUND_RATE = 48000
SOUND_FORMAT = f"aresample={SOUND_RATE},aformat=sample_fmts=fltp:channel_layouts=stereo"
# The music's defaults, which follow the Slipcase trailer (DEMO-0177 § 3).
MUSIC_LEVEL = -30.0
MUSIC_FADE_IN = 1.5
MUSIC_FADE_OUT = 3.0
LEVEL_RAMP = 0.5
# No level puts the music's peak above this, and a film whose loudest moment
# reaches FULL_SCALE gets a note that it may be distorted.
MUSIC_PEAK = -1.0
FULL_SCALE = -0.1


class Music:
    """A film's music: one file under the whole film, repeated to fill it."""

    def __init__(self, path, where):
        self.path = path
        self.where = where
        self.level = None       # None: MUSIC_LEVEL normalised, 0 dB as it is
        self.normalise = "on"
        self.fade_in = self.fade_out = None  # None: the defaults, which shrink to fit
        self.levels = []        # each: level, start, end, ramp, where


def script_number(word, where, what):
    try:
        value = float(word)
    except ValueError:
        value = -1.0
    if value < 0 or not math.isfinite(value):
        # translators: {word} is an edit-script word, such as from or fade-in, and stays
        # in English; {value} is what was written after it, in quotes.
        die(tr("{where}: {word} takes a number of seconds, not {value}.",
               where=where, word=what, value=repr(word)))
    return value


def script_decibels(word, where, what):
    """A level or a volume: a number of dB, which may be below zero."""
    try:
        value = float(word)
    except ValueError:
        value = math.nan
    if not math.isfinite(value):
        # translators: {word} is level or volume, an edit-script word, and stays in
        # English; {value} is what was written after it, in quotes.
        die(tr("{where}: {word} takes a number of decibels, like -6, not {value}.",
               where=where, word=what, value=repr(word)))
    return value


def script_on_off(word, where, what):
    if word not in ("on", "off"):
        # translators: {word} is sound or normalise, an edit-script word; on and off
        # stay in English too.
        die(tr("{where}: {word} is on or off, not {value}.", where=where, word=what,
               value=repr(word)))
    return word


def script_words(target, words, kind, where):
    """Read `word value` pairs after a scene's, a text's or the music's first
    part."""
    names = {"from": "start", "to": "end", "fade-in": "fade_in", "slide-in": "slide_in",
             "fade-out": "fade_out", "fade-length": "fade_length"}
    at = 0
    while at < len(words):
        word = words[at]
        if word not in SCENE_WORDS[kind] and at >= 2 and words[at - 2] == "crossfade":
            # translators: {name} is the word written after a crossfade's seconds, in
            # quotes; {names} lists xfade's transitions. All stay in English.
            die(tr("{where}: {name} is not a transition a crossfade takes. It "
                   "takes: {names}.", where=where, name=repr(word),
                   names=", ".join(TRANSITIONS)))
        if word not in SCENE_WORDS[kind]:
            # translators: {word} is the word written, in quotes; {kind} is clip, card or
            # text; {words} lists the words that line takes. All stay in English.
            die(tr("{where}: {word} is not something a {kind} line takes. "
                   "It takes: {words}.", where=where, word=repr(word), kind=kind,
                   words=", ".join(SCENE_WORDS[kind])))
        if at + 1 >= len(words):
            # translators: {word} is an edit-script word, in quotes, and stays in English.
            die(tr("{where}: {word} needs a value after it.", where=where,
                   word=repr(word)))
        value = words[at + 1]
        at += 2
        if word == "crossfade" and at < len(words) and words[at] in TRANSITIONS:
            target.transition = words[at]
            at += 1
        if word == "window":
            try:
                target.window = float(value)
            except ValueError:
                refuse_window(where, repr(value))
            if not math.isfinite(target.window):
                refuse_window(where, repr(value))
        elif word == "background":
            target.background = value
        elif word in ("sound", "normalise"):
            setattr(target, word, script_on_off(value, where, word))
        elif word in ("volume", "level"):
            setattr(target, word, script_decibels(value, where, word))
        elif kind in ("level", "zoom"):
            target[names.get(word, word)] = script_number(value, where, word)
        elif word == "fade-at":
            target.fade_at.append(script_number(value, where, word))
        elif kind == "text" and word in TEXT_NAMES:
            target[word] = value
        elif kind == "text":
            target[names.get(word, word)] = script_number(value, where, word)
        else:
            setattr(target, names.get(word, word),
                    script_number(value, where, word))


def parse_script(text):
    """Read an `edit` script into scenes, or die naming the line.

    One scene a line, `clip FILE ...` or `card SECONDS [PICTURE] ...`; a
    `text "WORDS" ...` line belongs to the scene above it, and a `zoom FACTOR
    ...` line to the clip above it. A line is split as
    a shell splits one, except that `#` starts a comment only at the start of
    a line: a colour is written `#101418`.

    One `music FILE ...` line may stand anywhere among the scenes, with its
    `level DB ...` lines straight after it. Returns (scenes, music or None).
    """
    scenes, music, above = [], None, None
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        where = tr("line {number}", number=number)
        try:
            words = shlex.split(line)
        except ValueError as exc:
            die(tr("{where} cannot be read: {reason}.", where=where, reason=exc)
                + f"\n  {line}")
        verb, rest = words[0], words[1:]
        if verb in ("text", "zoom") and above in ("music", "level"):
            die(tr("{where}: a text belongs to the scene above it, and the line "
                   "above is a music or level line.", where=where))
        if verb == "music":
            if music is not None:
                die(tr("{where}: a film has one music line, and {first} is already "
                       "one.", where=where, first=music.where))
            if not rest:
                die(tr("{where}: music needs a sound file after it.", where=where))
            music = Music(Path(rest[0]).expanduser(), where)
            script_words(music, rest[1:], "music", where)
        elif verb == "level":
            if above not in ("music", "level"):
                die(tr("{where}: a level line belongs to the music line, and comes "
                       "straight after it or after another level line.", where=where))
            if not rest:
                die(tr("{where}: level needs a number of decibels after it: "
                       "level -40", where=where))
            entry = {"level": script_decibels(rest[0], where, "level"),
                     "where": where}
            script_words(entry, rest[1:], "level", where)
            music.levels.append(entry)
        elif verb == "text":
            if not scenes:
                die(tr("{where}: a text belongs to the scene above it, and no "
                       "scene comes before this one.", where=where))
            if not rest:
                die(tr("{where}: text needs its words, in quotes: "
                       "text \"Saving a file\"", where=where))
            entry = {"words": rest[0], "where": where}
            script_words(entry, rest[1:], "text", where)
            scenes[-1].texts.append(entry)
        elif verb == "zoom":
            if not scenes or scenes[-1].kind != "clip" or above in ("music", "level"):
                # translators: zoom is an edit-script word and stays in English.
                die(tr("{where}: a zoom line belongs to the clip above it, and the "
                       "line above is not part of a clip.", where=where))
            if scenes[-1].zoom is not None:
                die(tr("{where}: a clip takes one zoom line, and {first} is already "
                       "one.", where=where, first=scenes[-1].zoom["where"]))
            try:
                factor = float(rest[0]) if rest else math.nan
            except ValueError:
                factor = math.nan
            if not ZOOM_LOW < factor <= ZOOM_HIGH:
                refuse_zoom(where, repr(rest[0]) if rest else "''")
            entry = {"factor": factor, "where": where}
            script_words(entry, rest[1:], "zoom", where)
            scenes[-1].zoom = entry
        elif verb == "clip":
            if not rest:
                die(tr("{where}: clip needs a video file after it.", where=where))
            scene = Scene("clip", where)
            scene.path = Path(rest[0]).expanduser()
            script_words(scene, rest[1:], "clip", where)
            scenes.append(scene)
        elif verb == "card":
            if not rest:
                die(tr("{where}: card needs its length in seconds: card 3", where=where))
            scene = Scene("card", where)
            scene.seconds = script_number(rest[0], where, "card")
            rest = rest[1:]
            if rest and rest[0] not in SCENE_WORDS["card"]:
                scene.path = Path(rest[0]).expanduser()
                rest = rest[1:]
            script_words(scene, rest, "card", where)
            scenes.append(scene)
        else:
            # translators: {word} is the first word of the line, in quotes.
            die(tr("{where}: a line starts with clip, card, text, zoom, music or "
                   "level, not {word}.", where=where, word=repr(verb)) + f"\n  {line}")
        above = verb if verb != "text" else above
    if not scenes:
        die(tr("the script has no scenes in it. A scene is a line starting with "
               "clip or card."))
    return scenes, music


def probe(path, where):
    """What ffprobe says of a video or a picture: its size, frame rate, length
    and format. Dies if it cannot be read, naming the scene that asked."""
    if not Path(path).is_file():
        die(tr("{where}: there is no file {path}", where=where, path=path))
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "v:0",
             "-show_entries",
             "stream=width,height,avg_frame_rate:format=duration,format_name",
             "-of", "json", str(path)],
            capture_output=True, text=True, timeout=CALL_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        die(tr("{where}: reading {path} took over {seconds}s.", where=where,
               path=path, seconds=CALL_TIMEOUT))
    try:
        info = json.loads(out.stdout) if out.returncode == 0 else {}
        stream = info["streams"][0]
        num, _, den = stream.get("avg_frame_rate", "0/1").partition("/")
        rate = float(num) / float(den) if float(den or 0) else 0.0
        return {"width": int(stream["width"]), "height": int(stream["height"]),
                "rate": rate,
                "duration": float(info["format"].get("duration") or 0),
                "format": info["format"].get("format_name", "")}
    except (KeyError, IndexError, ValueError):
        lines = out.stderr.strip().splitlines()
        die(tr("{where}: {path} is not a video or picture ffmpeg can read.",
               where=where, path=path) + (f"\n  {lines[-1]}" if lines else ""))
    return None  # unreachable; die() exits


# A card's picture is held in memory to be shown again and again, so an
# animation is refused past this many bytes of decoded frames.
PICTURE_BYTES = 512 * 1024 * 1024


def picture_frames(scene, where):
    """How many frames a card's picture has: 1 for a still, more for an
    animated .gif or .png. Which it is comes from its content, not its name:
    an animated .png is format apng."""
    if scene.info["format"] not in ("apng", "gif"):
        return 1
    try:
        counted = subprocess.run(
            ["ffprobe", "-v", "error", "-count_frames", "-select_streams",
             "v:0", "-show_entries", "stream=nb_read_frames", "-of",
             "csv=p=0", str(scene.path)],
            capture_output=True, text=True, timeout=6 * CALL_TIMEOUT,
            check=False)
        frames = int(counted.stdout.strip().split(",")[0])
    except (subprocess.TimeoutExpired, ValueError):
        die(tr("{where}: could not count the frames of {path}.", where=where,
               path=scene.path))
    if frames * scene.info["width"] * scene.info["height"] * 4 > PICTURE_BYTES:
        die(trn("{where}: {path} is too big an animation to hold in memory "
                "and play again and again ({count} frame of {size}).\n  Turn it "
                "into a video and use it as a clip instead.",
                "{where}: {path} is too big an animation to hold in memory "
                "and play again and again ({count} frames of {size}).\n  Turn it "
                "into a video and use it as a clip instead.", frames, where=where,
                path=scene.path, size=f"{scene.info['width']}x{scene.info['height']}"))
    return max(1, frames)


def memory_cap():
    """Run in the ffmpeg that makes a film, before it starts: refuse it more
    than half this machine's memory, or 4 GB where that is more.

    A filter graph whose input never ends buffers frames without limit. One
    did, while this was being built: ffmpeg reached 14 GB in six minutes on a
    machine other sessions were using. Every stream in the graph is bounded
    now, and this is what stops the next such mistake from taking the machine
    down with it.
    """
    cap = max(os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") // 2,
              4 * 1024 ** 3)
    # Only ever lower it: a caller may already hold this process to less.
    _, hard = resource.getrlimit(resource.RLIMIT_AS)
    if hard != resource.RLIM_INFINITY:
        cap = min(cap, hard)
    resource.setrlimit(resource.RLIMIT_AS, (cap, hard))


def rate_text(rate):
    """A frame rate as ffmpeg takes it: whole where it is whole."""
    return str(round(rate)) if abs(rate - round(rate)) < 0.01 else f"{rate:.3f}"


class TextUnavailable(Exception):
    """This machine cannot draw text. `reason` says why, and `checked` whether
    `demoreel check` tests the cause on its own. A structure rather than a
    message to take apart: the message is translated (§ 4.5)."""

    def __init__(self, reason, checked):
        super().__init__(reason)
        self.reason, self.checked = reason, checked


def text_size(textfile, fontsize, font=None, border=0):
    """(width, height) in pixels of the text in `textfile` at `fontsize`, as
    ffmpeg will draw it in `font` with an outline `border` pixels thick; raises
    TextUnavailable if this machine cannot draw text at all.

    Measured by drawing it: white on a black strip, then ffmpeg's own bounding
    box of what is not black. Nothing else knows the font's metrics, and there
    is no Python library here to ask (standard library only).
    """
    try:
        drawn = subprocess.run(
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "info",
             "-f", "lavfi", "-i",
             f"color=black:s={fontsize * 80}x{fontsize * 3}:d=1",
             "-vf", f"drawtext=textfile='{textfile}':expansion=none:"
                    f"{font or text_font()}:fontsize={fontsize}:"
                    f"fontcolor=white:borderw={border}:bordercolor=white:"
                    f"x={border}:y={border},bbox",
             "-frames:v", "1", "-f", "null", "-"],
            capture_output=True, text=True, timeout=CALL_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        raise TextUnavailable(tr("drawing a line of text took over {seconds}s.",
                                 seconds=CALL_TIMEOUT), checked=False) from None
    if drawn.returncode != 0:
        lines = [ln for ln in drawn.stderr.splitlines() if ln.strip()]
        raise TextUnavailable(tr("this machine cannot draw text on a video: ffmpeg "
                                 "needs its drawtext filter and a font.")
                              + "\n  " + "\n  ".join(lines[-2:]), checked=True)
    boxes = re.findall(r" w:(\d+) h:(\d+) ", drawn.stderr)
    return (int(boxes[-1][0]), int(boxes[-1][1])) if boxes else (0, 0)


# A clip's speed: below SPEED_LOW a slowed sound needs more than two atempo
# stages, and above SPEED_HIGH most frames are dropped.
SPEED_LOW = 0.25
SPEED_HIGH = 4.0


def scene_time(scene, moment):
    """A moment in a clip's own file, as seconds from its scene's start. Times
    are written in the file's time whatever the clip's speed (DEMO-0152); a
    card's start is 0 and its speed 1."""
    return (moment - scene.start) / scene.speed


def tempo_filters(speed):
    """atempo stages that play a sound `speed` times as fast. One stage takes
    0.5 to 100, on ffmpeg 6.1.1 and 9.0.2 alike."""
    if speed == 1:
        return []
    if speed < 0.5:
        return ["atempo=0.5", f"atempo={speed / 0.5:.9g}"]
    return [f"atempo={speed:.9g}"]


def check_zoom(scene, length):
    """Check a clip's zoom line and turn its times into times from the
    scene's start. Left out, it zooms over the whole clip."""
    zoom, where = scene.zoom, scene.zoom["where"]
    for word in ("x", "y"):
        if not 0 <= zoom.get(word, 50) <= 100:
            # translators: {word} is x or y, an edit-script word that stays in English.
            die(tr("{where}: a zoom's {word} is a percentage of the picture, from "
                   "0 to 100, not {value}.", where=where, word=word,
                   value=f"{zoom[word]:g}"))
    played = length - scene.hold
    begin = scene_time(scene, zoom.get("start", scene.start))
    if -TIME_SLACK <= begin < 0:
        begin = 0.0
    finish = scene_time(scene, zoom["end"]) if "end" in zoom else played
    if begin < 0 or finish > played + TIME_SLACK or begin >= finish:
        die(tr("{where}: the zoom is asked to run from {start} to {end}, which "
               "is not inside its clip ({scene_start} to {scene_end}).",
               where=where, start=f"{zoom.get('start', scene.start):g}",
               end=f"{zoom.get('end', scene.start + played * scene.speed):g}",
               scene_start=f"{scene.start:g}",
               scene_end=f"{scene.start + played * scene.speed:.3f}"))
    zoom["begin"], zoom["finish"] = begin, min(finish, played)


def check_texts(scene, length, width, height, workdir):
    """Check a scene's texts and turn their times into times from its start.

    A text shows from its `from` up to its `to`, and not on the frame at `to`,
    so one may start where another ends.
    """
    default = CARD_TEXT_SIZE if scene.kind == "card" else CAPTION_TEXT_SIZE
    for text in scene.texts:
        where = text.get("where", scene.where)
        words = text["words"]
        if not words.strip():
            die(tr("{where}: a text is one line of words, and this one is empty.",
                   where=where))
        if "\n" in words:
            die(tr("{where}: a text is one line of words, and this one is more "
                   "than one line.", where=where))
        # A time printed just short of a frame's start means that frame, so a
        # text may start that much before its scene does (DEMO-0136).
        begin = scene_time(scene, text.get("start", scene.start))
        if -TIME_SLACK <= begin < 0:
            begin = 0.0
        finish = scene_time(scene, text["end"]) if "end" in text else length
        if begin < 0 or finish > length + TIME_SLACK or begin >= finish:
            die(tr("{where}: the text {words} is asked to show from "
                   "{start} to {end}, which is not inside its scene "
                   "({scene_start} to {scene_end}).", where=where, words=repr(words),
                   start=f"{text.get('start', scene.start):g}",
                   end=f"{text.get('end', scene.start + length * scene.speed):g}",
                   scene_start=f"{scene.start:g}",
                   scene_end=f"{scene.start + length * scene.speed:.3f}"))
        size = text.get("size", default)
        if not 0 < size <= 50:
            die(tr("{where}: a text's size is a percentage of the frame's "
                   "height, between 0 and 50, not {size}.", where=where,
                   size=f"{size:g}"))
        for what in ("colour", "outline", "shadow"):
            if what in text and not COLOUR_RE.fullmatch(text[what]):
                # translators: {word} is colour, outline or shadow: an edit-script word, which
                # stays in English.
                die(tr("{where}: a text's {word} is a colour written #RRGGBB, "
                       "like #FFD040, not {value}.", where=where, word=what,
                       value=repr(text[what])))
        band = text.get("band", "on" if scene.kind == "clip" else "off")
        if band not in ("on", "off"):
            die(tr("{where}: a text's band is on or off, not {value}.", where=where,
                   value=repr(band)))
        place = text.get("at", "bottom" if scene.kind == "clip"
                         else "top" if scene.path is not None else "middle")
        if place not in TEXT_PLACES:
            die(tr("{where}: a text sits at {places} or {last}, not at {value}.",
                   where=where, places=", ".join(TEXT_PLACES[:-1]),
                   last=TEXT_PLACES[-1], value=repr(place)))
        if text.get("slide_in") and text.get("fade_in"):
            # translators: slide-in and fade-in are edit-script words and stay in English.
            die(tr("{where}: the text {words} takes slide-in or fade-in, not both: "
                   "a sliding text fades in as it rises.", where=where,
                   words=repr(words)))
        fades = text.get("fade_in", 0) + text.get("slide_in", 0) + text.get("fade_out", 0)
        if fades > min(finish, length) - begin + 1e-6:
            die(tr("{where}: the text {words} fades for {fades} seconds, "
                   "and shows for only {seconds}.", where=where, words=repr(words),
                   fades=f"{fades:g}", seconds=f"{min(finish, length) - begin:g}"))
        if fades and band == "on" and not box_can_be_sized():
            die(tr("{where}: a band that fades with its text needs a newer "
                   "ffmpeg than this one: its text filter has no `boxw`.\n"
                   "  Give the text `band off`, or take its fade away.", where=where))
        fontsize = max(1, round(size / 100 * height))
        font = text_font(text.get("font"), where)
        border = max(1, round(fontsize * OUTLINE_SHARE)) \
            if "outline" in text else 0
        textfile = workdir / f"text-{len(list(workdir.iterdir()))}.txt"
        textfile.write_text(words, encoding="utf-8")
        try:
            wide, _ = text_size(textfile, fontsize, font, border)
        except TextUnavailable as exc:
            die(exc.reason + ("\n  " + tr("`demoreel check` tests this on its own.")
                              if exc.checked else ""))
        room = width - 2 * round(CARD_MARGIN * width)
        if wide > room:
            die(tr("{where}: the text {words} is {wide} pixels wide at size "
                   "{size}, and the frame has room for {room}.\n  Shorten it, "
                   "or give it a smaller size: about {fits} would fit.",
                   where=where, words=repr(words), wide=wide, size=f"{size:g}",
                   room=room, fits=f"{size * room / wide:.1f}"))
        text.update(begin=begin, finish=min(finish, length), fontsize=fontsize,
                    textfile=textfile, fontfile=font, border=border,
                    banded=band == "on", place=place)
    scene.stacks = [place_stack(scene, lines, width, height)
                    for lines in text_stacks(scene.texts)]


def text_stacks(texts):
    """The texts at each place that are on screen together, joined one to the
    next, each stack in the order the script writes its lines. Two texts
    meeting only at a moment, one's `to` the other's `from`, are not."""
    stacks = []
    for text in texts:
        meets = [stack for stack in stacks if stack[0]["place"] == text["place"]
                 and any(text["begin"] < other["finish"] - 1e-6
                         and other["begin"] < text["finish"] - 1e-6
                         for other in stack)]
        stacks = [stack for stack in stacks if all(stack is not m for m in meets)]
        stacks.append(sorted([text, *(t for m in meets for t in m)], key=texts.index))
    return stacks


def place_stack(scene, lines, width, height):
    """Give each line of a stack its `y`, fixed for the stack's whole life,
    and return the stack's place, band and height for `picture_room`. A
    stack sits where one text of its height sits, so one line is placed as
    a text on its own is."""
    banded = lines[0]["banded"]
    for line in lines:
        if line["banded"] != banded:
            # translators: band is an edit-script word and stays in English.
            die(tr("{where}: the text {words} is on screen with {first} at the "
                   "same place, and one has a band and the other not. Texts "
                   "stacked together all have a band or none do.",
                   where=line.get("where", scene.where), words=repr(line["words"]),
                   first=repr(lines[0]["words"])))
    margin = round(CARD_MARGIN * height)
    offsets, total = [], 0
    for number, line in enumerate(lines):
        if number and not banded:
            total += round(LINE_GAP * max(line["fontsize"], lines[number - 1]["fontsize"]))
        offsets.append(total)
        total += round(line["fontsize"] * CAPTION_BAND) if banded else line["fontsize"]
        if total > height - 2 * margin:
            die(tr("{where}: the text {words} does not fit: with the texts "
                   "stacked above it, on screen at the same time, it is taller "
                   "than the frame. Give them a smaller size, or show them at "
                   "different times.", where=line.get("where", scene.where),
                   words=repr(line["words"])))
    edge = margin if not banded else 0
    top = {"top": edge, "middle": (height - total) // 2,
           "bottom": height - edge - total}[lines[0]["place"]]
    for line, offset in zip(lines, offsets, strict=True):
        line["y"] = top + offset
    return {"place": lines[0]["place"], "banded": banded, "height": total,
            "last": lines[-1]["fontsize"]}


def check_scene(scene, width, height, rate, workdir):
    """Check one scene against the film's size and return its length.

    A clip's cut is snapped to its file's frames: the frame on screen at
    `from` is the first one kept and the frame on screen at `to` the last
    (README), so the numbers `motion` prints can be used as they are.
    """
    where = scene.where
    if scene.kind == "card":
        if scene.seconds <= 0:
            die(tr("{where}: a card needs a length above zero.", where=where))
        if scene.path is not None:
            scene.info = probe(scene.path, where)
            scene.frames = picture_frames(scene, where)
        elif scene.reveal:
            # translators: reveal is an edit-script word and stays in English.
            die(tr("{where}: reveal brings in a card's picture, and this card has "
                   "none.", where=where))
        length = scene.seconds
    else:
        info = scene.info = probe(scene.path, where)
        whole = info["duration"]
        step = 1 / (info["rate"] or rate)
        if whole <= 0:
            die(tr("{where}: {path} has no length ffmpeg can tell.", where=where,
                   path=scene.path))
        if scene.window is None and scene.background is not None:
            # translators: background and window are edit-script words and stay in
            # English.
            die(tr("{where}: background on a clip colours the room round its "
                   "window, and this clip has no window.", where=where))
        if scene.window is not None and not WINDOW_LOW <= scene.window <= 100:
            refuse_window(where, f"{scene.window:g}")
        if scene.window is not None:
            scene.background = scene.background or CARD_BACKGROUND
        for word, given in (("push", scene.push), ("zoom", scene.zoom)):
            if scene.window is None and given:
                # translators: {word} is push or zoom, and window an edit-script word;
                # both stay in English.
                die(tr("{where}: {word} acts on a clip's window, and this clip has "
                       "no window.", where=where, word=word))
        if not 0 <= scene.push <= PUSH_HIGH:
            # translators: push is an edit-script word and stays in English.
            die(tr("{where}: push is how much the window grows, in percent, from "
                   "0 to {high}, not {value}.", where=where, high=PUSH_HIGH,
                   value=f"{scene.push:g}"))
        if scene.push and scene.window * (1 + scene.push / 100) > 100 + 1e-9:
            # translators: window and push are edit-script words and stay in English.
            die(tr("{where}: window {window} grown by push {push} is larger than "
                   "the room it sits in. Make one of them smaller.", where=where,
                   window=f"{scene.window:g}", push=f"{scene.push:g}"))
        if scene.window is None and abs(info["width"] * height - info["height"] * width) \
                > 0.01 * info["height"] * width:
            die(tr("{where}: {path} is {size}, a different shape from the film's "
                   "{film}, and demoreel will not stretch it.", where=where,
                   path=scene.path, size=f"{info['width']}x{info['height']}",
                   film=f"{width}x{height}"))
        for what, value in (("from", scene.start), ("to", scene.end)):
            if value is not None and value > whole + TIME_SLACK:
                # translators: `{word} {value}` is what was written, such as `to 12`; {word} is
                # from or to and stays in English.
                die(tr("{where}: `{word} {value}` is past the end of "
                       "{path}, which is {seconds} seconds long.", where=where,
                       word=what, value=f"{value:g}", path=scene.path,
                       seconds=f"{whole:.3f}"))
        first = frame_at(scene.start, step)
        scene.start = first * step
        if scene.end is None or scene.end + TIME_SLACK >= whole - step:
            last = None
            length = whole - scene.start
        else:
            last = frame_at(scene.end, step)
            length = (last + 1) * step - scene.start
        if length <= 0:
            die(tr("{where}: `from` must come before `to`, and both inside "
                   "{path} ({seconds} seconds long).", where=where, path=scene.path,
                   seconds=f"{whole:.3f}"))
        # Seek half a frame early, and read half a frame past the last one
        # kept, so neither edge turns on how a float rounds.
        scene.seek = max(0.0, scene.start - step / 2)
        scene.read = None if last is None else (last + 0.5) * step - scene.seek
        # The sound is read to the last kept frame's end, or the film is
        # silent for the half frame before each cut (DEMO-0177 § 4.3); trim
        # still bounds the picture.
        scene.read_sound = None if last is None else (last + 1) * step - scene.seek
        if not SPEED_LOW <= scene.speed <= SPEED_HIGH:
            # translators: speed is an edit-script word and stays in English.
            die(tr("{where}: speed is between {low} and {high}, not {value}: 2 plays "
                   "the clip twice as fast, 0.5 at half speed.", where=where,
                   low=f"{SPEED_LOW:g}", high=f"{SPEED_HIGH:g}",
                   value=f"{scene.speed:g}"))
        length = length / scene.speed + scene.hold
        for moment in scene.fade_at:
            if not (scene.fade_length <= scene_time(scene, moment)
                    <= length - scene.fade_length):
                die(tr("{where}: `fade-at {moment}` needs "
                       "{seconds} seconds of the scene on each "
                       "side, and the scene runs from {start} to {end}.",
                       where=where, moment=f"{moment:g}",
                       seconds=f"{scene.fade_length:g}", start=f"{scene.start:.3f}",
                       end=f"{scene.start + length * scene.speed:.3f}"))
    if scene.background is not None and not (
            1 <= len(scene.background.split(",")) <= GRADIENT_MOST
            and all(COLOUR_RE.fullmatch(c) for c in scene.background.split(","))):
        die(tr("{where}: a background is a colour written #RRGGBB, like "
               "{example}, or two to {most} of them joined by commas for a "
               "moving gradient, not {value}.", where=where,
               example=CARD_BACKGROUND, most=GRADIENT_MOST,
               value=repr(scene.background)))
    if scene.fade_in + scene.fade_out > length + 1e-6:
        die(tr("{where}: its fades come to {fades} seconds, and the scene is only "
               "{seconds} long.", where=where,
               fades=f"{scene.fade_in + scene.fade_out:g}", seconds=f"{length:.3f}"))
    check_texts(scene, length, width, height, workdir)
    if scene.zoom is not None:
        check_zoom(scene, length)
    if scene.kind == "card" and scene.path is not None \
            and picture_room(scene, width, height)[2] < 2:
        die(tr("{where}: its texts leave no room for the picture between them. "
               "Give them a smaller size.", where=where))
    if scene.window is not None:
        scene.box = window_box(scene, width, height)
        if scene.box[3] < 2:
            die(tr("{where}: its texts leave no room for the picture between them. "
                   "Give them a smaller size.", where=where))
    return length


def film_shape(scenes, size, rate):
    """(width, height, rate) of the film: what was asked for, else the first
    clip's, else what `record` defaults to."""
    clips = [s for s in scenes if s.kind == "clip"]
    first = probe(clips[0].path, clips[0].where) if clips else None
    if size:
        match = SIZE_RE.match(size)
        if not match:
            die(tr("--size takes a width and a height in pixels, like 1600x1000, "
                   "not {size}.", size=repr(size)))
        width, height = int(match[1]), int(match[2])
    elif first:
        width, height = first["width"], first["height"]
    else:
        width, height = 1600, 1000
    if width % 2 or height % 2 or not width or not height:
        die(tr("a video's width and height must be even, since H.264 cannot "
               "encode an odd one, and this film would be {size}.\n"
               "  Set the size with -s {even}.", size=f"{width}x{height}",
               even=f"{width + width % 2}x{height + height % 2}"))
    if rate is None:
        rate = first["rate"] if first and first["rate"] else 30
    if rate <= 0:
        die(tr("--framerate takes a number above zero, not {rate}.", rate=f"{rate:g}"))
    return width, height, rate


def text_filters(scene, width, height):
    """The filters that draw a scene's texts, each in its own time."""
    if not scene.texts:
        return []
    dark = True
    # A gradient is darkened to GRADIENT_DARK, so it is always dark.
    if scene.background is not None and "," not in scene.background:
        red, green, blue = (int(scene.background[i:i + 2], 16) for i in (1, 3, 5))
        dark = 0.299 * red + 0.587 * green + 0.114 * blue < 140
    filters = []
    for text in scene.texts:
        begin, finish, size = text["begin"], text["finish"], text["fontsize"]
        colour = ("0x" + text["colour"][1:] if "colour" in text
                  else "white" if dark or text["banded"] else "0x101418")
        draw = [f"drawtext=textfile='{text['textfile']}'", "expansion=none",
                text["fontfile"], f"fontsize={size}", f"fontcolor={colour}"]
        if text["border"]:
            draw += [f"borderw={text['border']}",
                     f"bordercolor=0x{text['outline'][1:]}"]
        if "shadow" in text:
            off = max(1, round(size * SHADOW_SHARE))
            draw += [f"shadowx={off}", f"shadowy={off}",
                     f"shadowcolor=0x{text['shadow'][1:]}"]
        fade_in, fade_out = text.get("fade_in", 0), text.get("fade_out", 0)
        slide = text.get("slide_in", 0)
        when = f"enable='gte(t,{begin:.4f})*lt(t,{finish:.4f})'"
        top = text["y"]
        # A sliding text starts SLIDE_RISE of its size low and rises into
        # place, easing out (a cubic), as it fades in; its band comes with it.
        place = (f"'{top}+{round(SLIDE_RISE * size)}*"
                 f"pow(1-clip((t-{begin:.4f})/{slide:.4f},0,1),3)'" if slide
                 else f"{top}")
        if text["banded"]:
            band = round(size * CAPTION_BAND)
            if box_can_be_sized():
                # The text's own box, which fades with it. An ffmpeg that
                # cannot size that box gets drawbox, which cannot fade.
                draw += ["box=1", "boxcolor=black@0.75", f"boxw={width}",
                         f"boxh={band}", "text_align=C+M", "x=0", f"y={place}"]
            else:
                filters.append(f"drawbox=x=0:y={top}:w={width}:h={band}:"
                               f"color=black@0.75:t=fill:{when}")
                draw += ["x=(w-text_w)/2", f"y={top + (band - size) // 2}"]
        else:
            draw += ["x=(w-text_w)/2", f"y={place}"]
        if fade_in or slide or fade_out:
            arrive = fade_in or slide
            rise = f"(t-{begin:.4f})/{arrive:.4f}" if arrive else "1"
            fall = f"({finish:.4f}-t)/{fade_out:.4f}" if fade_out else "1"
            draw.append(f"alpha='min(1,min({rise},{fall}))'")
        filters.append(":".join([*draw, when]))
    return filters


def picture_room(scene, width, height):
    """(top, width, height) of the room a card leaves its picture: the frame
    inside its margins, less what a text at the top or the bottom takes. A
    text in the middle takes none and lies over the picture."""
    margin = round(CARD_MARGIN * height)
    edge = {"top": margin, "bottom": margin}
    for stack in scene.stacks:
        if stack["place"] != "middle":
            taken = stack["height"] if stack["banded"] \
                else margin + stack["height"] + round(stack["last"] * 0.3)
            edge[stack["place"]] = max(edge[stack["place"]], taken + margin // 2)
    return edge["top"], width - 2 * margin, height - edge["top"] - edge["bottom"]


def fade_filters(scene, length):
    """A scene's fades, to and from black. A fade-at is a fade out then a fade
    in, each switched on only for its own half: left on, the first would hold
    everything after it black and the second everything before it."""
    filters = []
    if scene.fade_in:
        filters.append(f"fade=t=in:st=0:d={scene.fade_in:.4f}")
    for moment in scene.fade_at:
        at, half = scene_time(scene, moment), scene.fade_length
        filters.append(f"fade=t=out:st={at - half:.4f}:d={half:.4f}:"
                       f"enable='between(t,{at - half:.4f},{at:.4f})'")
        filters.append(f"fade=t=in:st={at:.4f}:d={half:.4f}:"
                       f"enable='gt(t,{at:.4f})*lte(t,{at + half:.4f})'")
    if scene.fade_out:
        filters.append(f"fade=t=out:st={length - scene.fade_out:.4f}:"
                       f"d={scene.fade_out:.4f}")
    return filters


def sound_fades(scene, length):
    """fade_filters for the scene's sound: the same fades over the same
    seconds, a fade-at's two halves each switched on for its own half."""
    filters = []
    if scene.fade_in:
        filters.append(f"afade=t=in:st=0:d={scene.fade_in:.4f}")
    for moment in scene.fade_at:
        at, half = scene_time(scene, moment), scene.fade_length
        filters.append(f"afade=t=out:st={at - half:.4f}:d={half:.4f}:"
                       f"enable='between(t,{at - half:.4f},{at:.4f})'")
        filters.append(f"afade=t=in:st={at:.4f}:d={half:.4f}:"
                       f"enable='gt(t,{at:.4f})*lte(t,{at + half:.4f})'")
    if scene.fade_out:
        filters.append(f"afade=t=out:st={length - scene.fade_out:.4f}:"
                       f"d={scene.fade_out:.4f}")
    return filters


def keeps_sound(scene):
    """Whether the film takes this scene's own sound."""
    return scene.kind == "clip" and scene.sound == "on" and scene.has_sound


def scene_sound(scene, length, number, first_input):
    """The chain that turns one scene's sound into `[a<number>]`, exactly
    `length` seconds long: the clip's own sound, or silence."""
    if not keeps_sound(scene):
        return (f"anullsrc=r={SOUND_RATE}:cl=stereo:d={length:.6f},{SOUND_FORMAT},"
                f"atrim=duration={length:.6f}[a{number}]")
    # The input seeks half a frame early (check_scene), so the sound is
    # trimmed to begin at `from` itself. It is moved back by that much and
    # no more: a sound stream that starts after its picture keeps the gap,
    # which aresample fills with silence, where PTS-STARTPTS would pull it
    # early (measured 2026-10-11: 0.48 s). A recording's sound may end before
    # its picture (DEMO-0106), so it is padded to the picture's length.
    trim = scene.start - scene.seek
    chain = [f"atrim=start={trim:.6f}", f"asetpts=PTS-{trim:.6f}/TB",
             f"aresample={SOUND_RATE}:async=1:first_pts=0",
             SOUND_FORMAT, *tempo_filters(scene.speed),
             f"apad=whole_dur={length:.6f}",
             f"atrim=duration={length:.6f}"]
    if scene.volume is not None:
        chain.append(f"volume={scene.volume:.4f}dB")
    chain += sound_fades(scene, length)
    return f"[{first_input}:a:0]{','.join(chain)}[a{number}]"


def sound_info(path, where):
    """(whether a file has a sound stream, its length in seconds or 0). The
    length is the sound's own, not the file's, which a longer picture sets
    (DEMO-0191); the file's stands in where the stream gives none, as in a
    .mkv. Dies if ffprobe cannot read it, naming the line or option that
    asked."""
    if not Path(path).is_file():
        die(tr("{where}: there is no file {path}", where=where, path=path))
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", "a:0", "-show_entries",
             "stream=index,duration:format=duration", "-of", "json", str(path)],
            capture_output=True, text=True, timeout=CALL_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        die(tr("{where}: reading {path} took over {seconds}s.", where=where,
               path=path, seconds=CALL_TIMEOUT))
    try:
        info = json.loads(out.stdout) if out.returncode == 0 else None
        streams = info.get("streams") or []
        own = streams[0].get("duration") if streams else None
        return bool(streams), float(
            own or info.get("format", {}).get("duration") or 0)
    except (AttributeError, TypeError, ValueError):
        lines = out.stderr.strip().splitlines()
        die(tr("{where}: {path} is not a file ffmpeg can read.", where=where,
               path=path) + (f"\n  {lines[-1]}" if lines else ""))
    return None  # unreachable; die() exits


def music_loudness(music):
    """(mean, peak) of the music in dB, measured as the film will hear it:
    made stereo first, since a mono file reads 3 dB quieter once it is."""
    try:
        done = subprocess.run(
            ["ffmpeg", "-nostdin", "-hide_banner", "-i", str(music.path), "-map",
             "0:a:0", "-af", f"{SOUND_FORMAT},volumedetect", "-f", "null", "-"],
            capture_output=True, text=True, timeout=60 + music.length / 5,
            check=False)
    except subprocess.TimeoutExpired:
        die(tr("{where}: measuring the sound of {path} took too long, so it was "
               "stopped.", where=music.where, path=music.path))
    mean = re.search(r"mean_volume: (-?[\d.]+) dB", done.stderr)
    peak = re.search(r"max_volume: (-?[\d.]+) dB", done.stderr)
    if done.returncode or not mean or not peak:
        lines = [ln for ln in done.stderr.splitlines() if ln.strip()]
        die(tr("{where}: ffmpeg could not measure the sound of {path}.",
               where=music.where, path=music.path)
            + (f"\n  {lines[-1]}" if lines and done.returncode else ""))
    return float(mean[1]), float(peak[1])


def check_music(music, total):
    """Check the music against a film `total` seconds long, measure it, and
    set the gain each level needs. Dies naming the line or option."""
    found, music.length = sound_info(music.path, music.where)
    if not found:
        die(tr("{where}: {path} has no sound in it.", where=music.where,
               path=music.path))
    if music.length <= 0:
        die(tr("{where}: {path} has no length ffmpeg can tell.", where=music.where,
               path=music.path))
    normalised = music.normalise == "on"
    low, high = (-60, 0) if normalised else (-60, 20)
    if music.level is None:
        music.level = MUSIC_LEVEL if normalised else 0.0
    for level, where in [(music.level, music.where),
                         *((e["level"], e["where"]) for e in music.levels)]:
        if not low <= level <= high:
            # translators: {state} is on or off, and stays in English.
            die(tr("{where}: a level with normalise {state} is between {low} and "
                   "{high} dB, not {value}.", where=where,
                   state=music.normalise, low=low, high=high, value=f"{level:g}"))
    written = [f for f in (music.fade_in, music.fade_out) if f is not None]
    if sum(written) > total + 1e-6:
        die(tr("{where}: the music's fades come to {fades} seconds, and the film "
               "is only {seconds} long.", where=music.where,
               fades=f"{sum(written):g}", seconds=f"{total:.3f}"))
    # A written fade is kept; the defaults share what room is left, shrinking
    # in proportion where they do not fit.
    defaults = [MUSIC_FADE_IN if music.fade_in is None else 0.0,
                MUSIC_FADE_OUT if music.fade_out is None else 0.0]
    shrink = min(1.0, (total - sum(written)) / sum(defaults)) if sum(defaults) else 1.0
    music.fades = tuple(given if given is not None else default * shrink
                        for given, default in zip((music.fade_in, music.fade_out),
                                                  defaults, strict=True))
    spans = []
    for entry in music.levels:
        start, end = entry.get("start", 0.0), entry.get("end", total)
        entry.setdefault("ramp", LEVEL_RAMP)
        if not start < end or end > total + TIME_SLACK:
            die(tr("{where}: a level line's from must come before its to, and both "
                   "inside the film, which is {seconds} seconds long.",
                   where=entry["where"], seconds=f"{total:.3f}"))
        entry["start"], entry["end"] = start, min(end, total)
        spans.append((max(0.0, start - entry["ramp"]),
                      min(total, entry["end"] + entry["ramp"]), entry))
    spans.sort(key=lambda span: span[0])
    for (_, until, before), (since, _, after) in itertools.pairwise(spans):
        if since < until - 1e-6:
            die(tr("{where}: this level line and {other} overlap, counting their "
                   "ramps.", where=after["where"], other=before["where"]))
    mean, peak = music_loudness(music)
    if not (math.isfinite(mean) and math.isfinite(peak)):
        die(tr("{where}: {path} is silent all through.", where=music.where,
               path=music.path))
    music.mean = mean
    for target in (music, *music.levels):
        level = target.level if target is music else target["level"]
        gain = level - mean if normalised else level
        if gain > MUSIC_PEAK - peak:
            gain = MUSIC_PEAK - peak
            reached = gain + mean if normalised else gain
            note(tr("{where}: the music at level {level} would peak above {peak} "
                    "dB, so it plays at level {reached} instead.",
                    where=target.where if target is music else target["where"],
                    level=f"{level:g}", peak=f"{MUSIC_PEAK:g}",
                    reached=f"{reached:.1f}"))
        if target is music:
            music.gain = gain
        else:
            target["gain"] = gain


def music_graph(music, input_number, total):
    """The chain that makes `[m]`: the music, set to its level, repeated to
    fill the film, softer or louder for each level line, faded in and out."""
    chain = [SOUND_FORMAT, f"volume={music.gain:.4f}dB"]
    if music.length < total:
        # Repeated by the filter, never by the demuxer: an input with no end
        # is buffered without limit (memory_cap). size counts samples after
        # the resampling, and a size past the input's end loops what it held.
        chain.append(f"aloop=loop=-1:size={math.ceil(music.length * SOUND_RATE)}")
    chain += [f"atrim=duration={total:.6f}", "asetpts=N/SR/TB"]
    terms = []
    for entry in music.levels:
        change = entry["gain"] - music.gain
        start, end, ramp = entry["start"], entry["end"], entry["ramp"]
        if ramp:
            terms.append(f"{change:.4f}*max(0,min(1,min((t-{start - ramp:.4f})/"
                         f"{ramp:.4f},({end + ramp:.4f}-t)/{ramp:.4f})))")
        else:
            terms.append(f"{change:.4f}*between(t,{start:.4f},{end:.4f})")
    if terms:
        chain.append(f"volume=eval=frame:volume='pow(10,({'+'.join(terms)})/20)'")
    fade_in, fade_out = music.fades
    if fade_in:
        chain.append(f"afade=t=in:st=0:d={fade_in:.4f}")
    if fade_out:
        chain.append(f"afade=t=out:st={total - fade_out:.4f}:d={fade_out:.4f}")
    return f"[{input_number}:a:0]{','.join(chain)}[m]"


def plan_music(music):
    """The music's lines of the plan on stderr."""
    if music.normalise == "on":
        note(tr("music {name}: averages {level} dB; its own average is {mean} dB, "
                "so it is turned {change} dB", name=music.path.name,
                level=f"{music.gain + music.mean:.1f}", mean=f"{music.mean:.1f}",
                change=f"{music.gain:+.1f}"))
    else:
        note(tr("music {name}: its own level, turned {change} dB",
                name=music.path.name, change=f"{music.gain:+.1f}"))
    for entry in music.levels:
        note(tr("  level {level} dB from {start} to {end}",
                level=f"{entry['level']:g}", start=f"{entry['start']:.3f}",
                end=f"{entry['end']:.3f}"))


def scene_graph(scene, length, number, first_input, width, height, rate):
    """(ffmpeg inputs, filter chains) that turn one scene into `[v<number>]`,
    a stream of the film's size and rate starting at time zero."""
    fps = rate_text(rate)
    # trim bounds every scene to its own frames, whatever its input does: a
    # stream that never ends is buffered without limit by whatever waits for
    # it (see memory_cap).
    # A held clip is cut to its own frames before its last is cloned: a clip
    # keeping its sound reads one frame past `to`, which tpad would hold.
    hold = (f"trim=end_frame={max(1, round((length - scene.hold) * rate))},"
            f"tpad=stop_mode=clone:stop_duration={scene.hold:.6f},"
            if scene.hold else "")
    shape = (f"fps={fps},scale={width}:{height},setsar=1,format=yuv420p,{hold}"
             f"trim=end_frame={max(1, round(length * rate))}")
    tail = ",".join([*text_filters(scene, width, height),
                     *fade_filters(scene, length)])
    tail = f",{tail}" if tail else ""
    out = f"[v{number}]"
    if scene.kind == "clip":
        inputs = ["-ss", f"{scene.seek:.6f}"]
        read = scene.read_sound if keeps_sound(scene) else scene.read
        if read is not None:
            inputs += ["-t", f"{read:.6f}"]
        inputs += ["-i", str(scene.path)]
        pts = "PTS-STARTPTS" if scene.speed == 1 else f"(PTS-STARTPTS)/{scene.speed:.9g}"
        if scene.window is None:
            return inputs, [f"[{first_input}:v]setpts={pts},{shape}{tail}{out}"]
        inputs += ["-f", "lavfi", "-i",
                   background_source(scene, width, height, rate, length, number)]
        return inputs, window_graph(scene, length, number, first_input, pts,
                                    f"{shape}{tail}{out}", rate)
    inputs = ["-f", "lavfi", "-i",
              background_source(scene, width, height, rate, length, number)]
    if scene.path is None:
        return inputs, [f"[{first_input}:v]{shape}{tail}{out}"]
    # The picture is read once and shown again and again by the loop filter,
    # which hands on a frame only when one is wanted. Asking the demuxer to
    # loop instead (-ignore_loop 0, -loop 1) makes an input with no end: an
    # animated .png read that way, waiting behind another scene, is what
    # filled the memory.
    inputs += ["-i", str(scene.path)]
    top, room_w, room_h = picture_room(scene, width, height)
    return inputs, [
        # Fitted into the room left for it, keeping its shape, never enlarged.
        f"[{first_input + 1}:v]loop=loop=-1:size={scene.frames}:start=0,"
        f"scale=w='min({room_w},iw)':h='min({room_h},ih)':"
        f"force_original_aspect_ratio=decrease,format=rgba{reveal_filters(scene)}"
        f"[p{number}]",
        f"[{first_input}:v][p{number}]overlay=x='(W-w)/2':"
        f"y='{top}+({room_h}-h)/2':format=auto,{shape}{tail}{out}"]


# A moving background (DEMO-0178), after the Slipcase trailer: ffmpeg's
# gradients in the caller's colours (at most GRADIENT_MOST, ffmpeg's limit),
# turning GRADIENT_TURN radians a second (its 0.012 a frame at 30 a second),
# darkened to GRADIENT_DARK of their brightness, with a vignette.
GRADIENT_TURN = 0.36
GRADIENT_DARK = 0.38
GRADIENT_MOST = 8


def background_source(scene, width, height, rate, length, number):
    """The lavfi source behind a card or a clip's window: one colour, or a
    slowly moving gradient through several. The gradient's seed is the
    scene's number, so the same script makes the same film."""
    colours = scene.background.split(",")
    shape = f"s={width}x{height}:r={rate_text(rate)}:d={length:.6f}"
    if len(colours) == 1:
        return f"color=c=0x{colours[0][1:]}:{shape}"
    stops = ":".join(f"c{i}=0x{c[1:]}" for i, c in enumerate(colours))
    dark = GRADIENT_DARK
    return (f"gradients={shape}:n={len(colours)}:{stops}:"
            f"speed={GRADIENT_TURN / rate:.6g}:seed={number},"
            f"colorchannelmixer=rr={dark}:gg={dark}:bb={dark},vignette=PI/4")


# A clip's window (DEMO-0183): the smallest share of the room it may take,
# and its look as shares of the window's height, from the Slipcase builder's
# 18 px radius, 0x22 blur and 10 px drop on an 860 px window, at 75%.
WINDOW_LOW = 20
WINDOW_CORNER = 0.021
WINDOW_BLUR = 0.026
WINDOW_DROP = 0.012
WINDOW_SHADOW = 0.75


# How far a window may grow over its scene, in percent (DEMO-0184; the
# Slipcase trailer pushed in 3.5% on a clip and 6% on a picture), and how many
# times larger a zoom may make the picture.
PUSH_HIGH = 20
ZOOM_LOW = 1
ZOOM_HIGH = 4


def refuse_zoom(where, value):
    # translators: zoom is an edit-script word and stays in English.
    die(tr("{where}: zoom is how many times larger the picture grows, above "
           "{low} and at most {high}, not {value}.", where=where, low=ZOOM_LOW,
           high=ZOOM_HIGH, value=value))


def refuse_window(where, value):
    # translators: window is an edit-script word and stays in English.
    die(tr("{where}: window is a share of the room in percent, from {low} to "
           "{high}, not {value}.", where=where, low=WINDOW_LOW, high=100,
           value=value))


def window_box(scene, width, height):
    """(x, y, w, h) of a clip's window: fitted, its shape kept, into its share
    of the room a card leaves its picture, and centred there. Even sizes."""
    top, room_w, room_h = picture_room(scene, width, height)
    box_w, box_h = room_w * scene.window / 100, room_h * scene.window / 100
    clip_w, clip_h = scene.info["width"], scene.info["height"]
    if clip_w * box_h <= clip_h * box_w:
        w, h = clip_w * box_h / clip_h, box_h
    else:
        w, h = box_w, clip_h * box_w / clip_w
    w, h = (int(v + 1e-6) // 2 * 2 for v in (w, h))
    left = round(CARD_MARGIN * height)
    return left + (room_w - w) // 2, top + (room_h - h) // 2, w, h


def rounded(x0, y0, w, h, r):
    """A geq expression: 1 inside a w by h rectangle at (x0, y0) whose
    corners are rounded to radius r, else 0."""
    x, y = f"(X-{x0})", f"(Y-{y0})"
    dx = f"max(0,max({r}-{x},{x}-{w - 1 - r}))"
    dy = f"max(0,max({r}-{y},{y}-{h - 1 - r}))"
    return (f"lte({dx}*{dx}+{dy}*{dy},{r * r})"
            f"*between({x},0,{w - 1})*between({y},0,{h - 1})")


def window_graph(scene, length, number, first_input, pts, rest, rate):
    """Filter chains for a windowed clip, from the back: its background (the
    input after the clip), a blurred shadow dropped below the window, and the
    clip with its corners rounded. The mask and the shadow are one frame
    each, repeated by `loop`; every chain is trimmed to the scene's frames,
    since a loop never ends by itself (DEMO-0183 § 4.4)."""
    x, y, w, h = scene.box
    fps, frames = rate_text(rate), max(1, round(length * rate))
    clip_frames = max(1, round((length - scene.hold) * rate))
    one = f"r={fps}:d={1 / rate:.6f}"
    r = max(1, round(WINDOW_CORNER * h))
    sigma, drop = WINDOW_BLUR * h, round(WINDOW_DROP * h)
    pad = math.ceil(3 * sigma) + drop
    n = number
    # A push grows the window and its shadow together, about the window's
    # middle, from their size to push% more as the clip plays (DEMO-0184).
    grow = ""
    if scene.push:
        k = f"(1+{scene.push / 100:.6g}*min(n,{clip_frames})/{clip_frames})"
        grow = f",scale=w='trunc(iw*{k}/2)*2':h='trunc(ih*{k}/2)*2':eval=frame"
    cx, cy = x + w // 2, y + h // 2
    centre = f"x='{cx}-w/2':y='{cy}-h/2'"
    return [
        f"[{first_input}:v]setpts={pts},fps={fps},{zoom_filters(scene, w, h, rate)},"
        f"setsar=1,format=rgba,trim=end_frame={clip_frames}[c{n}]",
        f"color=c=white:s={w}x{h}:{one},format=gray,"
        f"geq=lum='255*{rounded(0, 0, w, h, r)}',"
        f"loop=loop=-1:size=1,trim=end_frame={frames}[m{n}]",
        f"[c{n}][m{n}]alphamerge{grow}[w{n}]",
        f"color=c=black:s={w + 2 * pad}x{h + 2 * pad}:{one},format=rgba,"
        f"geq=r=0:g=0:b=0:a='{round(255 * WINDOW_SHADOW)}*"
        f"{rounded(pad, pad + drop, w, h, r)}',gblur=sigma={sigma:.3f},"
        f"loop=loop=-1:size=1,trim=end_frame={frames}{grow}[s{n}]",
        f"[{first_input + 1}:v][s{n}]overlay={centre}[b{n}]",
        f"[b{n}][w{n}]overlay={centre}:format=auto,{rest}"]


def zoom_filters(scene, w, h, rate):
    """Scale a windowed clip to its window, zooming as its zoom line says:
    the view closes in on a point of the picture and drifts towards it,
    never past the picture's edge, eased in and out (smoothstep) between two
    times, and stays there. The
    clip is first made twice the window's size, so the view moves by half
    pixels and does not jitter (DEMO-0184, after the Slipcase trailer)."""
    zoom = scene.zoom
    if zoom is None:
        return f"scale={w}:{h}"
    begin, finish = zoom["begin"], zoom["finish"]
    p = f"clip((on/{rate:.9g}-{begin:.6f})/{finish - begin:.6f},0,1)"
    z = f"1+{zoom['factor'] - 1:.6g}*{p}*{p}*(3-2*{p})"
    px, py = 2 * w * zoom.get("x", 50) / 100, 2 * h * zoom.get("y", 50) / 100
    return (f"scale={2 * w}:{2 * h},zoompan=z='{z}':d=1:fps={rate_text(rate)}:"
            f"s={w}x{h}:x='max(0,min(iw-iw/zoom,{px:.3f}-iw/zoom/2))':"
            f"y='max(0,min(ih-ih/zoom,{py:.3f}-ih/zoom/2))'")


# A revealed picture starts at this share of its size (DEMO-0185, after the
# Slipcase trailer).
REVEAL_FROM = 0.82


def reveal_filters(scene):
    """A card picture's reveal: it fades in and grows to its full size over
    `reveal` seconds, slowing as it arrives (a cubic ease-out). Sizes stay
    even, and a reveal longer than its card is cut off with the card."""
    if not scene.reveal:
        return ""
    done = f"clip(t/{scene.reveal:.6f},0,1)"
    grow = f"({REVEAL_FROM}+{1 - REVEAL_FROM:.2f}*(1-pow(1-{done},3)))"
    return (f",scale=w='max(2,trunc(iw*{grow}/2)*2)':"
            f"h='max(2,trunc(ih*{grow}/2)*2)':eval=frame,"
            f"fade=t=in:st=0:d={scene.reveal:.6f}:alpha=1")


def finishing_output(raw, inputs, endings):
    """Where a finishing command writes: a path ending as README says, and
    never one of the files it reads."""
    output = own_path(raw, "output")
    if output.suffix.lower() not in endings and len(endings) == 1:
        die(tr("-o must end in {ending}, and {name} does not.", ending=endings[0],
               name=output.name))
    if output.suffix.lower() not in endings:
        die(tr("-o must end in {ending} or {other}, and {name} does not.",
               ending=endings[0], other=endings[1], name=output.name))
    for source in inputs:
        if Path(source).expanduser().resolve() == output:
            die(tr("-o is {output}, which is also a file this command reads. "
                   "demoreel never writes over its own input.", output=output))
    output.parent.mkdir(parents=True, exist_ok=True)
    return output


def finishing_tools():
    """What every finishing command needs installed."""
    missing = [t for t in ("ffmpeg", "ffprobe") if shutil.which(t) is None]
    if missing:
        die(tr("missing required program(s): {programs}", programs=", ".join(missing))
            + install_hint(missing))


def make_film(scenes, raw_output, size=None, rate=None, also_read=(), music=None):
    """Check every scene, then encode the film once and print its path.

    Everything is checked before ffmpeg is started, so a mistake in the last
    scene costs nothing. The film is written beside its output and moved into
    place only when it is whole, so a failure leaves nothing at -o.
    """
    finishing_tools()
    if not has_libx264():
        die(tr("this ffmpeg cannot encode H.264 with libx264, which every video "
               "uses.") + x264_advice(distro_family()))
    output = finishing_output(
        raw_output, [*(s.path for s in scenes if s.path), *also_read,
                     *([music.path] if music else [])],
        (".mp4",))
    workdir = Path(tempfile.mkdtemp(prefix="edit-", dir=state_dir()))
    part = partial_video(output)
    try:
        width, height, rate = film_shape(scenes, size, rate)
        inputs, chains, lengths = [], [], []
        for number, scene in enumerate(scenes):
            # A scene lasts its picture's whole frames, which trim keeps, so
            # its sound and the scenes after it land where its picture does.
            length = check_scene(scene, width, height, rate, workdir)
            lengths.append(max(1, round(length * rate)) / rate)
            if scene.kind == "clip":
                scene.has_sound = sound_info(scene.path, scene.where)[0]
                if scene.volume is not None and not scene.has_sound:
                    die(tr("{where}: volume changes a clip's own sound, and {path} "
                           "has none.", where=scene.where, path=scene.path))
                if scene.volume is not None and not -60 <= scene.volume <= 20:
                    die(tr("{where}: volume is between {low} and {high} dB, not "
                           "{value}.", where=scene.where, low=-60, high=20,
                           value=f"{scene.volume:g}"))
            if scene.crossfade:
                if number == 0:
                    die(tr("{where}: a crossfade fades from the scene "
                           "before, and this is the first scene.", where=scene.where))
                if scene.fade_in:
                    die(tr("{where}: a scene takes a crossfade or a "
                           "fade-in, not both.", where=scene.where))
                spent = scene.crossfade + scenes[number - 1].crossfade
                if scene.crossfade > lengths[-1] or spent > lengths[-2]:
                    die(tr("{where}: a crossfade of {seconds} "
                           "seconds does not fit: the two scenes overlap for "
                           "that long, and one of them is shorter.",
                           where=scene.where, seconds=f"{scene.crossfade:g}"))
        clip_sound = any(keeps_sound(scene) for scene in scenes)
        film, sound, total = "[v0]", "[a0]", 0.0
        for number, (scene, length) in enumerate(zip(scenes, lengths, strict=True)):
            first_input = inputs.count("-i")
            more, graph = scene_graph(scene, length, number, first_input,
                                      width, height, rate)
            inputs += more
            chains += graph
            if clip_sound:
                chains.append(scene_sound(scene, length, number, first_input))
            begins = total - scene.crossfade
            if scene.crossfade:
                chains.append(f"{film}[v{number}]xfade=transition={scene.transition}:"
                              f"duration={scene.crossfade:.4f}:"
                              f"offset={begins:.4f}[f{number}]")
                if clip_sound:
                    chains.append(f"{sound}[a{number}]acrossfade="
                                  f"d={scene.crossfade:.6f}[g{number}]")
            elif number:
                # concat hands on a microsecond timebase, and xfade refuses two
                # inputs whose timebases differ; fps puts the film's back.
                chains.append(f"{film}[v{number}]concat=n=2:v=1:a=0,"
                              f"fps={rate_text(rate)}[f{number}]")
                if clip_sound:
                    chains.append(f"{sound}[a{number}]concat=n=2:v=0:a=1[g{number}]")
            if number:
                film, sound = f"[f{number}]", f"[g{number}]"
            total = begins + length
            name = scene.path.name if scene.path else tr("text")
            # translators: {kind} is clip or card, in English; {name} is a file name, or the
            # translation of "text".
            note(tr("scene {number}: {kind} {name}, {start} to {end}",
                    number=number + 1, kind=scene.kind, name=name,
                    start=f"{begins:.3f}", end=f"{total:.3f}"))
        if music:
            check_music(music, total)
            chains.append(music_graph(music, inputs.count("-i"), total))
            inputs += ["-i", str(music.path)]
            plan_music(music)
        if clip_sound and music:
            # normalize=0: the default divides each input by the number of
            # inputs, so neither would sit at the level the caller set.
            chains.append(f"{sound}[m]amix=inputs=2:normalize=0:duration=first,"
                          f"atrim=duration={total:.6f}[s]")
        elif clip_sound:
            chains.append(f"{sound}atrim=duration={total:.6f}[s]")
        audio = (["-map", "[s]", *AUDIO_ENCODER] if clip_sound
                 else ["-map", "[m]", *AUDIO_ENCODER] if music else ["-an"])
        note(tr("making {output}, {seconds} seconds at {size}", output=output,
                seconds=f"{total:.3f}", size=f"{width}x{height}"))
        made = subprocess.run(  # noqa: PLW1510 - a failure is handled below
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
             *inputs, "-filter_complex", ";".join(chains), "-map", film,
             # The film ends at its planned length even if a stream does not.
             "-t", f"{total + 0.5 / rate:.4f}",
             *audio, *ENCODER, "-y", str(part)],
            capture_output=True, text=True, timeout=60 + 20 * total,
            preexec_fn=memory_cap)
        unreadable = None if made.returncode else video_error(part)
        if made.returncode or unreadable:
            lines = [ln for ln in made.stderr.splitlines() if ln.strip()]
            die(tr("ffmpeg could not make the film.") + "\n  "
                + ("\n  ".join(lines[-4:]) or unreadable))
        peak = loudest(part) if clip_sound or music else None
        if peak is not None and peak >= FULL_SCALE:
            note(tr("the film's sound reaches full scale, so it may be distorted. "
                    "Turn the music or a clip down to keep it clean."))
        os.replace(part, output)
    except subprocess.TimeoutExpired:
        die(tr("ffmpeg did not finish making the film in the time allowed for "
               "its length, so it was stopped."))
    finally:
        part.unlink(missing_ok=True)
        shutil.rmtree(workdir, ignore_errors=True)
    summarise(output)
    print(output)


def cmd_edit(a):
    """A film from a script (README, Finishing a recording)."""
    try:
        text = sys.stdin.read() if a.script == "-" else Path(
            a.script).expanduser().read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        die(tr("could not read the script {path}: {reason}.", path=a.script,
               reason=getattr(exc, "strerror", None) or exc))
    scenes, music = parse_script(text)
    make_film(scenes, a.output, a.size, a.framerate, music=music)


def shortcut_music(a):
    """The music a shortcut's --music options ask for, as the script's music
    line would say it, or None."""
    given = [(flag, value) for flag, value in (
        ("--music-level", a.music_level), ("--music-fade-in", a.music_fade_in),
        ("--music-fade-out", a.music_fade_out)) if value is not None]
    if a.music is None:
        if given:
            die(tr("{option} sets the music, and needs --music FILE as well.",
                   option=given[0][0]))
        return None
    for flag, value in given:
        if flag != "--music-level" and (value < 0 or not math.isfinite(value)):
            die(tr("{option} takes a number of seconds, not {value}.", option=flag,
                   value=f"{value:g}"))
    music = Music(Path(a.music).expanduser(), "--music")
    music.level, music.fade_in, music.fade_out = (
        a.music_level, a.music_fade_in, a.music_fade_out)
    return music


def without_sound(scenes, a):
    """--no-sound: `sound off` on every clip."""
    if a.no_sound:
        for scene in scenes:
            scene.sound = "off"
    return scenes


def one_clip(path, a):
    scene = Scene("clip", Path(path).name)
    scene.path = Path(path).expanduser()
    scene.fade_in, scene.fade_out = a.fade_in, a.fade_out
    return scene


def cmd_trim(a):
    """One clip, with its from and to."""
    if a.start is None and a.end is None and not (
            a.fade_in or a.fade_out or a.fade_at or a.music or a.no_sound):
        die(tr("trim needs something to do: --from, --to, a fade, --music or "
               "--no-sound."))
    scene = one_clip(a.input, a)
    scene.start, scene.end = a.start or 0.0, a.end
    scene.fade_at, scene.fade_length = a.fade_at, a.fade_length
    make_film(without_sound([scene], a), a.output, music=shortcut_music(a))


def cmd_caption(a):
    """One clip, whole, with its texts."""
    scene = one_clip(a.input, a)
    scene.texts = a.texts
    make_film(without_sound([scene], a), a.output, music=shortcut_music(a))


def cmd_join(a):
    """One clip scene for each video, in order."""
    if len(a.inputs) < 2:
        die(tr("join takes two or more videos; one on its own is already whole."))
    scenes = []
    for path in a.inputs:
        scene = Scene("clip", Path(path).name)
        scene.path = Path(path).expanduser()
        scene.crossfade = a.crossfade if scenes else 0.0
        scenes.append(scene)
    scenes[0].fade_in, scenes[-1].fade_out = a.fade_in, a.fade_out
    make_film(without_sound(scenes, a), a.output, music=shortcut_music(a))


def cmd_card(a):
    """One card. Its size and rate come from --like unless -s and -r say."""
    scene = Scene("card", tr("the card"))
    scene.seconds, scene.background = a.duration, a.background
    scene.path = Path(a.image).expanduser() if a.image else None
    scene.fade_in, scene.fade_out = a.fade_in, a.fade_out
    if a.text is not None:
        scene.texts = [{"words": a.text}
                       | ({"size": a.text_size} if a.text_size else {})]
    size, rate = a.size, a.framerate
    if a.like:
        finishing_tools()
        like = probe(a.like, "--like")
        size = size or f"{like['width']}x{like['height']}"
        rate = rate or like["rate"] or None
    make_film([scene], a.output, size, rate, [a.like] if a.like else [],
              music=shortcut_music(a))


def cmd_motion(a):
    """Report how often a video's picture changes, and where it stands still.

    Read-only, and its report is what goes to stdout. "New" is NEW_FRAME,
    the --gpu note's test as well, whose comment holds its measurements.
    A new frame is one that differs from the last new frame, not from the
    frame before it: a slow drift is noticed once it has added up.
    """
    finishing_tools()
    info = probe(a.input, Path(a.input).name)
    whole = info["duration"]
    start = a.start or 0.0
    end = whole if a.end is None else min(a.end, whole)
    if (a.end is not None and a.end > whole + TIME_SLACK) or start >= end:
        die(tr("--from and --to must be inside {path}, which is "
               "{seconds} seconds long, with --from before --to.", path=a.input,
               seconds=f"{whole:.3f}"))
    try:
        seen = subprocess.run(
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "info",
             "-ss", f"{start:.6f}", "-t", f"{end - start:.6f}",
             "-i", str(Path(a.input).expanduser()),
             "-vf", f"showinfo=checksum=0,{NEW_FRAME},"
                    "showinfo=checksum=0",
             "-an", "-f", "null", "-"],
            capture_output=True, text=True, timeout=60 + 10 * (end - start),
            check=False)
    except subprocess.TimeoutExpired:
        die(tr("reading {path} took too long for its length, so it was "
               "stopped.", path=a.input))
    # Two showinfo filters, one each side of the test: the first sees every
    # frame, the second only the new ones.
    every = re.findall(r"Parsed_showinfo_0 .* pts_time:([0-9.]+)", seen.stderr)
    new = [start + float(t) for t in
           re.findall(r"Parsed_showinfo_2 .* pts_time:([0-9.]+)", seen.stderr)]
    if seen.returncode != 0 or not every or not new:
        lines = [ln for ln in seen.stderr.splitlines() if ln.strip()]
        die(tr("could not read the frames of {path}.", path=a.input) + "\n  "
            + "\n  ".join(lines[-2:]))
    stills = [(before, after) for before, after in itertools.pairwise([*new, end])
              if after - before > a.still]
    report = {"duration": round(end - start, 3), "frames": len(every),
              "new_frames": len(new),
              "new_frames_per_second": round(len(new) / (end - start), 2),
              "last_change": round(new[-1], 3),
              "still": [{"from": round(b, 3), "to": round(e, 3),
                         "seconds": round(e - b, 3)} for b, e in stills]}
    if a.json:
        print(json.dumps(report))
        return
    print(f"duration: {report['duration']:.3f}")
    print(f"frames: {report['frames']}")
    print(f"new frames: {report['new_frames']}")
    print(f"new frames per second: {report['new_frames_per_second']:.2f}")
    print(f"last change: {report['last_change']:.3f}")
    for still in report["still"]:
        print(f"still: {still['from']:.3f} to {still['to']:.3f} "
              f"({still['seconds']:.3f})")


def cmd_poster(a):
    """The frame on screen at -t, as a picture."""
    finishing_tools()
    output = finishing_output(a.output, [a.input], (".png", ".jpg"))
    info = probe(a.input, Path(a.input).name)
    whole, step = info["duration"], 1 / (info["rate"] or 30)
    if a.time < 0 or a.time > whole + TIME_SLACK:
        die(tr("-t {time} is not inside {path}, which is {seconds} "
               "seconds long.", time=f"{a.time:g}", path=a.input,
               seconds=f"{whole:.3f}"))
    # The frame on screen at a time is the last one that started at or before
    # it; seeking lands on the first frame at or after the point given, so
    # aim half a frame before that frame's own start.
    frame = min(frame_at(a.time, step),
                max(0, math.ceil(whole / step - 1e-6) - 1))
    part = output.with_name(f".{output.stem}.demoreel-part{output.suffix}")
    try:
        grab = subprocess.run(  # noqa: PLW1510 - a failure is handled below
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
             "-ss", f"{max(0.0, (frame - 0.5) * step):.6f}",
             "-i", str(Path(a.input).expanduser()), "-frames:v", "1",
             *(["-q:v", "3"] if output.suffix.lower() == ".jpg" else []),
             "-y", str(part)],
            capture_output=True, text=True, timeout=6 * CALL_TIMEOUT)
        if grab.returncode != 0 or not part.exists() or not part.stat().st_size:
            lines = [ln for ln in grab.stderr.splitlines() if ln.strip()]
            die(tr("could not take the frame at {time} from {path}.",
                   time=f"{a.time:g}", path=a.input)
                + ("\n  " + "\n  ".join(lines[-2:]) if lines else ""))
        os.replace(part, output)
    except subprocess.TimeoutExpired:
        die(tr("taking the frame took over {seconds}s.", seconds=6 * CALL_TIMEOUT))
    finally:
        part.unlink(missing_ok=True)
    print(output)


def finishing_problems():
    """(why the finishing commands cannot run, why text cannot be drawn), each
    None when it can. `check` reports both; neither decides its exit status."""
    missing = [t for t in ("ffmpeg", "ffprobe") if shutil.which(t) is None]
    if missing:
        why = tr("missing {programs}", programs=", ".join(missing)) + install_hint(missing)
        return why, tr("needs ffmpeg first")
    videos = None if has_libx264() else (
        tr("this ffmpeg has no libx264, which every video uses.")
        + x264_advice(distro_family()))
    workdir = Path(tempfile.mkdtemp(prefix="check-", dir=state_dir()))
    try:
        (workdir / "text.txt").write_text("demoreel")
        wide, _ = text_size(workdir / "text.txt", 40)
        words = None if wide else tr(
            "ffmpeg drew nothing for a line of text: no font was found.")
    except TextUnavailable as exc:
        words = exc.reason
    finally:
        shutil.rmtree(workdir, ignore_errors=True)
    return videos, words


# The examples at the end of --help (DEMO-0050), as (comment, command) pairs:
