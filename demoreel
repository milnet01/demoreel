def tr_listed(msgid):
    """tr_help for a message held in a table the template extraction reads by
    name -- EXAMPLES, RECORD_EXAMPLES -- where no call can name it as a
    literal. Anything else goes through tr, trn or tr_help."""
    found = _lookup(msgid, None, None, argparse_formats=True)
    return _fill(found[0] if found else msgid, {}, bool(found and found[1]))


def examples_text(examples):
    """The examples section of a --help page, put together at run time, once
    the language is chosen."""
    return tr_help("examples:") + "".join(
        f"\n  # {tr_listed(comment)}\n  " + command.replace("\n", "\n  ") + "\n"
        for comment, command in examples).removesuffix("\n")


def build_parser():
    """The command line. Separate from main() so ci.sh can parse the --help
    examples with it without running anything."""
    parser = Parser(
        prog="demoreel",
        description=tr_help("Record a GUI app on a private virtual display, so nothing "
                            "of your real desktop\nis in frame."),
        epilog=examples_text(EXAMPLES) + "\n\n" + tr_help("more examples:")
        + " demoreel record --help",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version",
                        version=f"demoreel {__version__}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    rec = sub.add_parser("record", help=tr_help("record an app and write a video file"),
                         epilog=examples_text(RECORD_EXAMPLES),
                         formatter_class=argparse.RawDescriptionHelpFormatter)
    rec.add_argument("-o", "--output",
                     help=tr_help("video file to write (default: "
                                  "./<app>-<timestamp>.mp4)"))
    rec.add_argument("-d", "--duration", type=float, default=30,
                     help=tr_help("seconds to record; 0 means until `demoreel stop` "
                                  "(default: 30)"))
    rec.add_argument("-s", "--size", default="1600x1000",
                     help=tr_help("virtual display size, even numbers "
                                  "(default: 1600x1000)"))
    rec.add_argument("-r", "--framerate", type=int, default=30,
                     help=tr_help("frames per second (default: 30)"))
    rec.add_argument("-n", "--name", default="default",
                     help=tr_help("name for this run, so `demoreel stop` can find it "
                                  "(default: default)"))
    rec.add_argument("-a", "--action", action="append", default=[], metavar="ACTION",
                     help=tr_help("scripted step, repeatable and run in order: "
                                  "{steps}", steps="'wait 2', 'move X Y', 'click [X Y]', "
                                  "'type some text', 'key Return', 'hold w 3', "
                                  "'drag X1 Y1 X2 Y2'"))
    rec.add_argument("--steps", metavar="FILE",
                     help=tr_help("read the scripted steps from FILE, one per line, "
                                  "or from standard input for -; keeps typed text "
                                  "out of the process list. Not with -a"))
    rec.add_argument("--app-log", metavar="PATH",
                     help=tr_help("keep the app's own output in PATH; otherwise it goes "
                                  "to this terminal's stderr. Useful when the app prints "
                                  "whether it drew the real thing, which no recording "
                                  "check here can tell"))
    rec.add_argument("--settle", type=float, default=0, metavar="SECONDS",
                     help=tr_help("wait up to SECONDS for the app to draw its first "
                                  "frame before recording starts, instead of filming "
                                  "its startup black screen (default: 0, don't wait)"))
    rec.add_argument("--gpu", action="store_true",
                     help=tr_help("for an app that needs the graphics card (OpenGL, "
                                  "Vulkan): record it on a headless compositor instead "
                                  "of Xvfb, which has no GPU. Needs cage, Xwayland, "
                                  "wlr-randr and wf-recorder; not with --cursor"))
    rec.add_argument("--cursor", action="store_true",
                     help=tr_help("show the mouse pointer; off by default, since with "
                                  "no actions it just sits in the corner"))
    rec.add_argument("--audio", action="store_true",
                     help=tr_help("put the app's own sound in the video. Off by "
                                  "default; either way the app's sound never plays "
                                  "on your speakers. Needs pactl"))
    rec.add_argument("--startup-timeout", type=float, default=20, metavar="SECONDS",
                     help=tr_help("how long to wait for the app's window (default: 20)"))
    rec.add_argument("command", nargs=argparse.REMAINDER,
                     help=tr_help("-- followed by the command that starts the app"))
    rec.set_defaults(func=cmd_record)

    # The options `record` takes, less the ones about time and names: a shot
    # has no duration, no frame rate and nothing to stop (README, Taking a
    # picture). --settle defaults to 10 here, since a picture of a startup
    # screen is never what anyone wanted.
    shot = sub.add_parser("shot", help=tr_help("take one picture of an app and write "
                                               "a PNG"))
    shot.add_argument("-o", "--output",
                      help=tr_help("picture file to write (default: "
                                   "./<app>-<timestamp>.png)"))
    shot.add_argument("-s", "--size", default="1600x1000",
                      help=tr_help("virtual display size (default: 1600x1000)"))
    shot.add_argument("-a", "--action", action="append", default=[],
                      metavar="ACTION",
                      help=tr_help("scripted step run before the picture, repeatable: "
                                   "{steps}", steps="'wait 2', 'move X Y', 'click [X Y]', "
                                   "'type some text', 'key Return', 'hold w 3', "
                                   "'drag X1 Y1 X2 Y2'"))
    shot.add_argument("--steps", metavar="FILE",
                      help=tr_help("read the scripted steps from FILE, one per line, "
                                   "or from standard input for -. Not with -a"))
    shot.add_argument("--app-log", metavar="PATH",
                      help=tr_help("keep the app's own output in PATH; otherwise it "
                                   "goes to this terminal's stderr"))
    shot.add_argument("--settle", type=float, default=10, metavar="SECONDS",
                      help=tr_help("wait up to SECONDS for the app to draw before the "
                                   "steps and the picture (default: 10)"))
    shot.add_argument("--gpu", action="store_true",
                      help=tr_help("for an app that needs the graphics card: use a "
                                   "headless compositor instead of Xvfb. Needs "
                                   "cage, Xwayland and wlr-randr"))
    shot.add_argument("--cursor", action="store_true",
                      help=tr_help("show the mouse pointer in the picture"))
    shot.add_argument("--startup-timeout", type=float, default=20,
                      metavar="SECONDS",
                      help=tr_help("how long to wait for the app's window (default: 20)"))
    shot.add_argument("command", nargs=argparse.REMAINDER,
                      help=tr_help("-- followed by the command that starts the app"))
    shot.set_defaults(func=cmd_shot)

    check = sub.add_parser(
        "check", help=tr_help("test whether this machine can record, without recording"),
        description=tr_help("Report what each backend needs and whether it is "
                            "installed, start a private display to prove it works, "
                            "and name the install command for anything missing. "
                            "Exits non-zero if the default backend cannot record."))
    check.set_defaults(func=cmd_check)

    stop = sub.add_parser("stop", help=tr_help("end a running recording early"))
    stop.add_argument("name", nargs="?", help=tr_help("which run to stop (default: the "
                                                      "only one running)"))
    stop.set_defaults(func=cmd_stop)

    # The finishing commands (README, Finishing a recording). They read and
    # write files; none starts a display or takes a run name. The summary and
    # the description are two messages, so no full stop is joined on.
    def finishing(name, summary, description, output=True):
        p = sub.add_parser(name, help=summary, description=description)
        if output is True:
            output = tr_help("video file to write, ending in .mp4")
        if output:
            p.add_argument("-o", "--output", required=True, help=output)
        return p

    def fades(p):
        p.add_argument("--fade-in", type=float, default=0, metavar="SECONDS",
                       help=tr_help("start black; the picture arrives over SECONDS"))
        p.add_argument("--fade-out", type=float, default=0, metavar="SECONDS",
                       help=tr_help("go to black over the last SECONDS"))

    # The music line's words, and sound off on every clip (DEMO-0177 § 4.2).
    def sound(p, clips=True):
        p.add_argument("--music", metavar="FILE",
                       help=tr_help("lay this sound file under the film, repeated "
                                    "to fill it"))
        p.add_argument("--music-level", type=float, metavar="DB",
                       help=tr_help("the level the music averages, in dB "
                                    "(default: {level})", level=f"{MUSIC_LEVEL:g}"))
        p.add_argument("--music-fade-in", type=float, metavar="SECONDS",
                       help=tr_help("the music arrives over SECONDS (default: "
                                    "{seconds})", seconds=MUSIC_FADE_IN))
        p.add_argument("--music-fade-out", type=float, metavar="SECONDS",
                       help=tr_help("the music goes over the last SECONDS "
                                    "(default: {seconds})", seconds=f"{MUSIC_FADE_OUT:g}"))
        if clips:
            p.add_argument("--no-sound", action="store_true",
                           help=tr_help("leave out the videos' own sound"))

    edit = finishing("edit", tr_help("make a film from a script of scenes"),
                     tr_help("make a film from a script of scenes."))
    edit.add_argument("script", help=tr_help("the script file, or - for standard input"))
    edit.add_argument("-s", "--size", help=tr_help("the film's picture size, like "
                                                   "1280x800 (default: the first clip's)"))
    edit.add_argument("-r", "--framerate", type=int,
                      help=tr_help("the film's frames per second (default: the first "
                                   "clip's)"))
    edit.set_defaults(func=cmd_edit)

    trim = finishing("trim", tr_help("cut the start and the end off a video"),
                     tr_help("cut the start and the end off a video."))
    trim.add_argument("input", help=tr_help("the video to cut"))
    trim.add_argument("--from", dest="start", type=float, metavar="SECONDS",
                      help=tr_help("where the kept part starts (default: the start)"))
    trim.add_argument("--to", dest="end", type=float, metavar="SECONDS",
                      help=tr_help("the last moment kept (default: the end)"))
    fades(trim)
    sound(trim)
    trim.add_argument("--fade-at", type=float, action="append", default=[],
                      metavar="SECONDS",
                      help=tr_help("fade to black and back around this moment; "
                                   "repeatable"))
    trim.add_argument("--fade-length", type=float, default=FADE_LENGTH,
                      metavar="SECONDS",
                      help=tr_help("how long each half of a --fade-at takes "
                                   "(default: {seconds})", seconds=FADE_LENGTH))
    trim.set_defaults(func=cmd_trim)

    caption = finishing("caption", tr_help("put text over part of a video"),
                        tr_help("put text over part of a video."))
    caption.add_argument("input", help=tr_help("the video to put text on"))
    caption.add_argument("--text", action=_CaptionText, dest="texts",
                         default=[], required=True, metavar="WORDS",
                         help=tr_help("one line of text; repeatable"))
    for flag, key, about in (
            ("--from", "start", tr_help("for the --text before it: when it appears")),
            ("--to", "end", tr_help("for the --text before it: when it goes")),
            ("--text-size", "size", tr_help("for the --text before it: its height, as "
                                            "a percentage of the frame's"))):
        caption.add_argument(flag, action=_CaptionField, dest=key, type=float,
                             metavar="PERCENT" if key == "size" else "SECONDS",
                             help=about)
    fades(caption)
    sound(caption)
    caption.set_defaults(func=cmd_caption)

    join = finishing("join", tr_help("put videos end to end"),
                     tr_help("put videos end to end."))
    join.add_argument("inputs", nargs="+", metavar="input",
                      help=tr_help("two or more videos, in order"))
    join.add_argument("--crossfade", type=float, default=0, metavar="SECONDS",
                      help=tr_help("fade from each video into the next over SECONDS "
                                   "(default: a plain cut)"))
    fades(join)
    sound(join)
    join.set_defaults(func=cmd_join)

    card = finishing("card", tr_help("make a clip from a picture, or from text"),
                     tr_help("make a clip from a picture, or from text."))
    card.add_argument("image", nargs="?", help=tr_help("a picture to show; a .gif or "
                                                       "an animated .png plays"))
    card.add_argument("-d", "--duration", type=float, required=True,
                      help=tr_help("how many seconds the card lasts"))
    card.add_argument("--text", metavar="WORDS", help=tr_help("one line of text"))
    card.add_argument("--text-size", type=float, metavar="PERCENT",
                      help=tr_help("the text's height, as a percentage of the "
                                   "frame's (default: {size})", size=CARD_TEXT_SIZE))
    card.add_argument("--background", default=CARD_BACKGROUND,
                      metavar="#RRGGBB",
                      help=tr_help("the background colour (default: {colour})",
                                   colour=CARD_BACKGROUND))
    card.add_argument("--like", metavar="VIDEO",
                      help=tr_help("take the size and frame rate from this video"))
    card.add_argument("-s", "--size", help=tr_help("the picture size, like 1280x800 "
                                                   "(default: 1600x1000)"))
    card.add_argument("-r", "--framerate", type=int,
                      help=tr_help("frames per second (default: 30)"))
    fades(card)
    sound(card, clips=False)
    card.set_defaults(func=cmd_card)

    motion = finishing("motion", tr_help("report how smooth a video is and where it "
                                         "stands still"),
                       tr_help("report how smooth a video is and where it stands "
                               "still."), output=None)
    motion.add_argument("input", help=tr_help("the video to look at"))
    motion.add_argument("--from", dest="start", type=float, metavar="SECONDS",
                        help=tr_help("look from here (default: the start)"))
    motion.add_argument("--to", dest="end", type=float, metavar="SECONDS",
                        help=tr_help("look up to here (default: the end)"))
    motion.add_argument("--still", type=float, default=1.0, metavar="SECONDS",
                        help=tr_help("report a stretch with no change longer than "
                                     "this (default: 1)"))
    motion.add_argument("--json", action="store_true",
                        help=tr_help("print the report as one JSON object"))
    motion.set_defaults(func=cmd_motion)

    poster = finishing("poster", tr_help("save one frame of a video as a picture"),
                       tr_help("save one frame of a video as a picture."),
                       output=tr_help("picture file to write, ending in .png or .jpg"))
    poster.add_argument("input", help=tr_help("the video to take the frame from"))
    poster.add_argument("-t", "--time", type=float, required=True,
                        metavar="SECONDS", help=tr_help("which moment to save"))
    poster.set_defaults(func=cmd_poster)
    return parser


def main():
    # The language is chosen before the parser exists: argparse translates its
    # group titles as the parser is built (§ 4.6).
    use_languages(chosen_languages(os.environ))
    if _catalogs:
        argparse._ = _argparse_gettext
        argparse.ngettext = _argparse_ngettext
    args = build_parser().parse_args()
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _exit_on_signal)
    args.func(args)


if __name__ == "__main__":
    main()
