SIZE_RE = re.compile(r"^(\d+)x(\d+)$")
DISPLAY_READY_TIMEOUT = 15.0

# The one definition of "nothing is on this display". Measured: an empty Xvfb
# is 0.99994, and a window as small as 200x100 on a 1280x800 display already
# drops to 0.98, so there is room on both sides. ci.sh imports this rather than
# restating it -- a threshold with two homes is one a person has to remember to
# move, and this project has already answered that question the same way twice
# (`ci.sh --ruff-version`, `ci.sh --docs-glob`).
BLANK_THRESHOLD = 0.999
# How long one xdotool call or one frame grab may take before the display is
# taken to have stopped answering (DEMO-0079). Each normally returns in a few
# milliseconds -- a grab costs about 112ms of CPU on a 1600x1000 display -- so
# this is a hang detector, not a performance budget. Typing is paced by xdotool
# at 12ms a key, so a `type` step gets TYPE_SECONDS_PER_CHAR more per character.
CALL_TIMEOUT = 10
TYPE_SECONDS_PER_CHAR = 0.05

# Both backends need this. Unset, wl_display_connect() falls back to the
# hardcoded $XDG_RUNTIME_DIR/wayland-0, which exists on a Wayland session — so
# the app connects to the user's REAL compositor, renders there, and the
# private display records black while every signal says success. A name that
# cannot resolve fails the connection instead, and the toolkit falls back to
# X11. It is the non-Flatpak twin of --nosocket=wayland, and unlike
# QT_QPA_PLATFORM=xcb it does not need to know the app's toolkit.
NO_WAYLAND = "demoreel-no-wayland"

# An Event, not a flag, so a wait on it ends the moment a stop arrives. A
# plain sleep resumes after the handler runs (PEP 475), and a stop landed up
# to one sleep late: a median 107 ms, measured, all of it in the video
# (DEMO-0075).
_stop = threading.Event()

# Set once a call to the display has timed out (DEMO-0079): the run has failed
# and hands back no video. The recorder and the display are then ended at
# once, since each waits on the frozen display and a graceful stop only runs
# out its timeouts, 25 seconds of them (DEMO-0078).
_display_gone = threading.Event()


def _request_stop(signum, frame):
    """SIGUSR1 (from `demoreel stop`), SIGINT or SIGTERM: finish the video now."""
    _stop.set()


def _exit_on_signal(signum, frame):
    """SIGTERM or SIGHUP anywhere but a recording: exit through die(), so the
    finally blocks that end the display and the app still run. Left at their
    default, either signal ended Python on the spot and leaked Xvfb, which
    holds its display number for good (DEMO-0115)."""
    die(tr("ended by {signal} before it finished, so there is nothing to hand back.",
           signal=signal.Signals(signum).name))


_progress_line = ""


def progress(text):
    """Show `text` as one line updated in place on a terminal; None clears it.

    Only on a terminal: a script, a log or a Claude session reading stderr
    gets exactly what it got before this existed (DEMO-0053). One short line
    and no colour, because the screen it is read on may be magnified.
    """
    global _progress_line  # noqa: PLW0603 - one line on one terminal
    text = text or ""
    if not sys.stderr.isatty() or text == _progress_line:
        return
    try:
        # \r goes back to the start of the line; \033[K clears the rest.
        sys.stderr.write("\r\033[K" + (f"demoreel: {text}" if text else ""))
        sys.stderr.flush()
    except OSError:
        # A closed terminal, as in note(): nobody is reading, and a line
        # about the recording must not end it (DEMO-0115).
        sys.stderr = open(os.devnull, "w")  # noqa: SIM115 - lives to exit
    _progress_line = text


def die(msg):
    sys.exit(f"demoreel: {msg}")


def note(msg):
    """Tell the caller something on stderr. A note is advice: if the terminal
    has gone (a hung-up run finishing its video), losing it must not fail
    the recording it was about (DEMO-0115)."""
    try:
        progress(None)
        print(f"demoreel: {msg}", file=sys.stderr)
    except OSError:
        # What failed to write is still buffered, and flushing it at exit
        # fails again and turns the exit status to 120. Nobody is reading.
        sys.stderr = open(os.devnull, "w")  # noqa: SIM115 - lives to exit


# Translation: docs/specs/DEMO-0060-translation-catalogs.md is the contract.
# Every message is English in this file and looked up in po/<code>.po, which
# demoreel reads itself. Nothing is looked up until main() chooses a language,
# so a module-level tr() would always be English -- and is refused by the gate.

PLACEHOLDER_RE = re.compile(r"\{([a-z_][a-z0-9_]*)\}")
# A backticked span, a long flag with any =value, or a short flag on its own.
# Only ASCII joins onto a flag: Chinese and Japanese write a flag straight
# against their own letters and punctuation, and it is still its own word.
CODE_TOKEN_RE = re.compile(
    r"`[^`\n]*`|(?<![A-Za-z0-9_-])"
    r"(?:--[a-z][a-z0-9-]*(?:=[^\s`,;)\x80-\U0010ffff]*)?|-[A-Za-z](?![A-Za-z0-9_-]))")
PERCENT_RE = re.compile(r"%%|%\([a-z_]+\)[a-z]|%[a-z]")
RTL_LANGUAGES = ("ar", "fa", "he", "ps", "ur", "yi")
FIRST_STRONG_ISOLATE, POP_DIRECTIONAL_ISOLATE = "\u2068", "\u2069"
# What a catalog's file name may be: ll, ll_CC, either with an @modifier. A
# LANGUAGE entry is not trusted to name a file, or `../x` would reach outside
# po/ (INV-9).
CODE_RE = re.compile(r"[A-Za-z0-9]+(?:_[A-Za-z0-9]+)?(?:@[A-Za-z0-9]+)?")
CATALOG_LIMIT = 1024 * 1024
# C0 controls but newline and tab, DEL, C1 controls, and the bidi embeddings,
# overrides and isolates. A terminal obeys the first three; the last are
# demoreel's own to insert (§ 4.3).
REFUSED_CHARACTERS = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]")
# argparse's own strings that a demoreel user meets, identical in every Python
# the gate runs (3.12 and 3.13). One a new Python rewords is removed, not
# reworded, so the older Python keeps it (§ 6).
ARGPARSE_MESSAGES = (
    "usage: ",
    "options",
    "positional arguments",
    "show this help message and exit",
    "show program's version number and exit",
    "the following arguments are required: %s",
    "unrecognized arguments: %s",
    "invalid choice: %(value)r (choose from %(choices)s)",
    "%(prog)s: error: %(message)s\n",
)

# The chosen catalogs, best first: (code, translations, messages, draft).
_catalogs = []
# The codes of the draft catalogs that have supplied a message in this run.
_drafts_used = set()


class CatalogError(Exception):
    """A catalog outside § 4.3's subset, refused whole."""

    def __init__(self, reason, line=None):
        super().__init__(f"line {line}: {reason}" if line else reason)


def po_string(text, line):
    """One quoted .po string, with § 4.3's four escapes and no other."""
    text = text.strip()
    if len(text) < 2 or text[0] != '"' or text[-1] != '"':
        raise CatalogError("a string is not in double quotes", line)
    out, chars = [], iter(text[1:-1])
    for char in chars:
        if char == '"':
            raise CatalogError("a double quote inside a string is not escaped", line)
        if char == "\\":
            escape = {"n": "\n", "t": "\t", '"': '"', "\\": "\\"}.get(next(chars, ""))
            if escape is None:
                raise CatalogError("unknown escape sequence", line)
            out.append(escape)
        else:
            out.append(char)
    return "".join(out)


def read_po(text):
    """The entries of a .po file: [{msgid, plural, forms, fuzzy, line}].

    The grammar is § 4.3's subset; anything outside it refuses the whole file,
    since a feature demoreel does not implement must not be half-read. The
    header is the entry whose msgid is empty. Nothing here judges content.
    """
    entries, entry, field, flags = [], None, None, set()

    def close():
        if entry is None:
            return
        if not entry["forms"]:
            raise CatalogError("a msgid has no msgstr", entry["line"])
        entries.append(entry)

    for number, raw in enumerate(text.split("\n"), 1):
        line = raw.strip()
        if not line or line.startswith("#~"):
            continue
        if line.startswith("#,"):
            flags |= {flag.strip() for flag in line[2:].split(",")}
            continue
        if line.startswith("#"):
            continue
        if line.startswith('"'):
            if field is None:
                raise CatalogError("a string belongs to no keyword", number)
            field[-1] += po_string(line, number)
            continue
        keyword, _, rest = line.partition(" ")
        if keyword == "msgctxt":
            raise CatalogError("msgctxt is not supported", number)
        if keyword == "msgid":
            close()
            entry = {"msgid": [po_string(rest, number)], "plural": None, "forms": [],
                     "fuzzy": "fuzzy" in flags, "line": number}
            field, flags = entry["msgid"], set()
        elif entry is None or (entry["forms"] and keyword == "msgid_plural"):
            raise CatalogError(f"{keyword} comes before its msgid", number)
        elif keyword == "msgid_plural" and entry["plural"] is None:
            entry["plural"] = field = [po_string(rest, number)]
        elif (keyword == "msgstr" and entry["plural"] is None and not entry["forms"]) or (
                keyword == f"msgstr[{len(entry['forms'])}]" and entry["plural"] is not None):
            entry["forms"].append(po_string(rest, number))
            field = entry["forms"]
        else:
            raise CatalogError(f"unexpected {keyword!r}", number)
    close()
    seen = set()
    for entry in entries:
        entry["msgid"] = entry["msgid"][0]
        entry["plural"] = entry["plural"][0] if entry["plural"] else None
        key = (entry["msgid"], entry["plural"])
        if key in seen:
            raise CatalogError("a message is in the file twice", entry["line"])
        seen.add(key)
    return entries


def mo_image(entries):
    """The .mo file GNUTranslations reads, built in memory from (key, value)
    pairs of bytes: a plural's key is msgid NUL msgid_plural, its value the
    forms joined by NUL."""
    import struct

    entries = sorted(entries)
    count = len(entries)
    ids, strs = 28, 28 + 8 * count
    data = bytearray()
    offset = 28 + 16 * count
    id_table, str_table = [], []
    for table, column in ((id_table, 0), (str_table, 1)):
        for entry in entries:
            table += [len(entry[column]), offset + len(data)]
            data += entry[column] + b"\0"
    return (struct.pack("<7I", 0x950412DE, 0, count, ids, strs, 0, 0)
            + struct.pack(f"<{4 * count}I", *id_table, *str_table) + bytes(data))


def load_catalog(path, code):
    """(code, translations, messages, draft) for one catalog, or CatalogError.

    `messages` holds only what may be used: no header, nothing fuzzy, and no
    entry with an empty form, so a lookup there falls through to the next
    catalog. An OSError is the caller's: a catalog that cannot be read is one
    that is not there (§ 6).
    """
    import gettext
    import io

    data = path.read_bytes()
    if len(data) > CATALOG_LIMIT:
        raise CatalogError("larger than 1 MiB")
    if data.startswith(b"\xef\xbb\xbf"):
        raise CatalogError("a byte-order mark", 1)
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise CatalogError("not UTF-8", data[:exc.start].count(b"\n") + 1) from None
    entries = read_po(text)
    header = next((e for e in entries if e["msgid"] == "" and e["plural"] is None), None)
    if header is None:
        raise CatalogError("no header")
    for entry in entries:
        if any(REFUSED_CHARACTERS.search(form) for form in entry["forms"]):
            raise CatalogError("a control or text-direction character", entry["line"])
    fields = {}
    for line in header["forms"][0].splitlines():
        name, colon, value = line.partition(":")
        if colon:
            fields[name.strip().lower()] = value.strip()
    charset = re.search(r"charset=([^\s;]+)", fields.get("content-type", ""))
    if not charset or charset[1].lower() not in ("utf-8", "utf8"):
        raise CatalogError("its charset is not UTF-8", header["line"])
    if fields.get("language") != code:
        raise CatalogError(f"its Language is not {code}", header["line"])
    plural = re.fullmatch(r"nplurals\s*=\s*([0-9]+)\s*;\s*plural\s*=\s*([^;]+);?",
                          fields.get("plural-forms", ""))
    if not plural:
        raise CatalogError("it has no Plural-Forms", header["line"])
    pairs = [(e["msgid"].encode() + (b"\0" + e["plural"].encode() if e["plural"] else b""),
              b"\0".join(form.encode() for form in e["forms"]))
             for e in entries if e is header or (not e["fuzzy"] and all(e["forms"]))]
    try:
        book = gettext.GNUTranslations(io.BytesIO(mo_image(pairs)))
        if not all(0 <= book.plural(n) < int(plural[1]) for n in range(1001)):
            raise CatalogError("its plural expression gives a form it does not have",
                               header["line"])
    except (ArithmeticError, LookupError, RecursionError, SyntaxError, TypeError,
            ValueError):
        raise CatalogError("its plural expression cannot be used", header["line"]) from None
    messages = {(e["msgid"], e["plural"]): e["forms"] for e in entries
                if e is not header and not e["fuzzy"] and all(e["forms"])}
    review = fields.get("x-demoreel-review", "")
    return code, book, messages, not re.fullmatch(r"confirmed [0-9a-f]{16}", review)


def chosen_languages(env):
    """The catalog codes to try, best first; [] means English (§ 4.4).

    The C rule comes first, as in GNU gettext: under LC_ALL=C nothing is
    translated whatever LANGUAGE says. Python's gettext.find reads LANGUAGE
    first, which is why it is not used.
    """
    chosen = next((env[k] for k in ("LC_ALL", "LC_MESSAGES", "LANG") if env.get(k)), "")
    if re.split(r"[.@]", chosen)[0] in ("", "C", "POSIX"):
        return []
    wanted = [w for w in env.get("LANGUAGE", "").split(":") if w] or [chosen]
    codes = []
    for name in wanted:
        if re.split(r"[_.@]", name)[0] == "en":
            break  # English asked for: stop here
        base, _, modifier = name.partition("@")
        language, _, country = base.partition(".")[0].partition("_")
        modifier = f"@{modifier}" if modifier else ""
        codes += ([f"{language}_{country}{modifier}", f"{language}{modifier}",
                   f"{language}_{country}", language] if country
                  else [f"{language}{modifier}", language])
    return list(dict.fromkeys(codes))


def _is_utf8(stream):
    try:
        return codecs.lookup(stream.encoding).name == "utf-8"
    except (AttributeError, LookupError, TypeError):
        return False


def use_languages(codes):
    """Load the catalogs for `codes`, best first, in place of any loaded before.

    Nothing under po/ is opened for an empty list, or when stdout or stderr
    cannot carry UTF-8 (§ 4.4). A catalog is looked for in one place only, the
    po/ beside this script once its symlink is followed (§ 4.2). A refused one
    costs its language and one English note, never the run.
    """
    _catalogs.clear()
    _drafts_used.clear()
    here = globals().get("__file__")
    if not codes or not here or not (_is_utf8(sys.stdout) and _is_utf8(sys.stderr)):
        return
    folder = Path(here).resolve().parent / "po"
    for code in codes:
        if not CODE_RE.fullmatch(code):
            continue
        try:
            _catalogs.append(load_catalog(folder / f"{code}.po", code))
        except OSError:
            continue
        except CatalogError as exc:
            note(f"po/{code}.po could not be read ({exc}), so messages are in English.")


def _usable(text, english, plural_form, argparse_formats):
    """Whether a translation may stand in for `english` (§ 4.5, § 4.6)."""
    names, wanted = set(PLACEHOLDER_RE.findall(text)), set(PLACEHOLDER_RE.findall(english))
    if not names <= wanted or not wanted - ({"count"} if plural_form else set()) <= names:
        return False
    if "{" in PLACEHOLDER_RE.sub("", text) or "}" in PLACEHOLDER_RE.sub("", text):
        return False
    if argparse_formats:
        tokens = set(PERCENT_RE.findall(text)) - {"%%"}
        if "%" in PERCENT_RE.sub("", text) or not tokens <= set(PERCENT_RE.findall(english)):
            return False
    return True


def _lookup(singular, plural, count, argparse_formats):
    """(text, right-to-left) from the first catalog holding the message, or
    None for English."""
    for code, book, messages, draft in _catalogs:
        forms = messages.get((singular, plural))
        if not forms:
            continue
        try:
            text = (book.gettext(singular) if plural is None
                    else book.ngettext(singular, plural, count))
        except (ArithmeticError, LookupError, RecursionError, TypeError, ValueError):
            return None
        # A form the catalog lacks comes back as the English: use English.
        english = singular if plural is None else singular + plural
        if text not in forms or not _usable(text, english, plural is not None,
                                            argparse_formats):
            return None
        if draft:
            _drafts_used.add(code)
        return text, re.split(r"[_@]", code)[0] in RTL_LANGUAGES
    return None


def _fill(text, values, marks):
    """Plain named substitution: nothing in a template can reach an attribute
    or an index. With `marks`, each value and each code token is isolated, the
    marks outside a token and never inside it (§ 4.5)."""
    def plain(match):
        return str(values[match[1]])

    def isolated(match):
        return f"{FIRST_STRONG_ISOLATE}{values[match[1]]}{POP_DIRECTIONAL_ISOLATE}"

    if not marks:
        return PLACEHOLDER_RE.sub(plain, text)
    out, at = [], 0
    for token in CODE_TOKEN_RE.finditer(text):
        out += [PLACEHOLDER_RE.sub(isolated, text[at:token.start()]), FIRST_STRONG_ISOLATE,
                PLACEHOLDER_RE.sub(plain, token[0]), POP_DIRECTIONAL_ISOLATE]
        at = token.end()
    out.append(PLACEHOLDER_RE.sub(isolated, text[at:]))
    return "".join(out)


def tr(msgid, **values):
    """The message in the chosen language, its {name}s filled from `values`."""
    found = _lookup(msgid, None, None, argparse_formats=False)
    return _fill(found[0] if found else msgid, values, bool(found and found[1]))


def trn(singular, plural, count, **values):
    """tr for a message whose wording depends on a number, also given as {count}."""
    found = _lookup(singular, plural, count, argparse_formats=False)
    text = found[0] if found else singular if count == 1 else plural
    return _fill(text, {"count": count, **values}, bool(found and found[1]))


def tr_help(msgid, **values):
    """tr for text handed to argparse, which formats it again with `%`: its
    translation may hold `%` only as English does (§ 4.6)."""
    found = _lookup(msgid, None, None, argparse_formats=True)
    return _fill(found[0] if found else msgid, values, bool(found and found[1]))


def _argparse_gettext(message):
    """argparse's `_`: a string in ARGPARSE_MESSAGES translated, any other as
    it is. argparse fills its own values, so they get no isolation marks."""
    found = message in ARGPARSE_MESSAGES and _lookup(message, None, None, True)
    return found[0] if found else message


def _argparse_ngettext(singular, plural, count):
    found = singular in ARGPARSE_MESSAGES and _lookup(singular, plural, count, True)
    return found[0] if found else singular if count == 1 else plural


class Parser(argparse.ArgumentParser):
    """argparse's parser, with the draft line at the end of --help (§ 4.9)."""

    def format_help(self):
        text = super().format_help()
        if _drafts_used:
            text += "\n" + tr_help("This translation is a draft and has not yet been "
                                   "checked by a native speaker.") + "\n"
        return text


def poll(check, timeout, interval=0.05, grow=1.0, ceiling=None):
    """Call check() until it returns something true, and return that.

    None once `timeout` seconds pass without it, or never with timeout=None.
    Every wait for a condition goes through here, so none can sleep past its
    own deadline and tuning an interval is one argument (DEMO-0080). The pipe
    reads wait in select instead, and the recording loop is its own. check() runs
    at least once, and once more at the deadline, however short the timeout.
    `grow` widens the interval after each miss, up to `ceiling`.
    """
    deadline = None if timeout is None else time.monotonic() + timeout
    while True:
        result = check()
        if result:
            return result
        if deadline is None:
            time.sleep(interval)
        else:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None
            time.sleep(min(interval, remaining))
        interval = interval * grow if ceiling is None else min(interval * grow, ceiling)


def state_dir():
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
    d = base / f"demoreel-{os.getuid()}"
    try:
        d.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        die(tr("could not use {path}: {reason}.\n"
               "  demoreel keeps its run files there. Point XDG_RUNTIME_DIR at a "
               "directory you can write to.", path=d, reason=exc.strerror))
    # A desktop session sets XDG_RUNTIME_DIR, so the /tmp fallback is the
    # unusual path — which is also why it would go unnoticed. The name there is
    # predictable, so another user can create it first and exist_ok would adopt
    # it. lstat, not stat: a symlink planted at that name is followed by both
    # stat and chmod, so checking through it proves nothing.
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        die(tr("{path} is not a directory you own, so demoreel will not use it.\n"
               "  On a shared machine another user can create that name first.\n"
               "  Remove it, or point XDG_RUNTIME_DIR at a directory you own.", path=d))
    d.chmod(0o700)
    return d


def alive(pid):
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def proc_stat(pid, field):
    """One field of /proc/<pid>/stat, numbered as proc(5) numbers them.

    Field 2 is the command name in parentheses and may itself contain spaces
    and parentheses, so the fields are split after the LAST ')' rather than on
    the whole line. Only fields from 3 on can be asked for.
    """
    try:
        line = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    try:
        return line[line.rindex(")") + 1:].split()[field - 3]
    except (ValueError, IndexError):
        return None


def proc_starttime(pid):
    """The process's start time, field 22 of /proc/<pid>/stat.

    Unique per pid incarnation, which is what tells a recycled pid apart from
    the process we started.
    """
    return proc_stat(pid, 22)


def is_our_run(entry):
    """True when the process a state file names is still the run that wrote it.

    alive() alone asks only whether SOME process holds that pid. Every run's
    state file outlives it, left for `stop` to read the verdict from -- and
    Linux recycles pids.
    Acting on alive() alone sends SIGUSR1 to whatever inherited the number, and
    the default action for SIGUSR1 is to terminate.

    Comparing the start time recorded when the file was written closes that.
    A race remains in principle -- the process could exit between this check
    and the signal -- but that window is microseconds, against however long a
    stale file has been lying around.
    """
    pid = entry.get("pid")
    if not isinstance(pid, int) or not alive(pid):
        return False
    # A file written without a start time cannot be checked, and an entry that
    # cannot be checked is the one this exists to refuse.
    recorded = entry.get("starttime")
    return recorded is not None and proc_starttime(pid) == recorded


def write_state(statefile, entry):
    """Replace the state file in one step, so `stop` never reads half of it.

    It is written twice per run -- once at start, again when recording begins
    -- and a reader landing mid-write would see invalid JSON and skip the run.
    """
    tmp = statefile.with_suffix(".tmp")
    tmp.write_text(json.dumps(entry))
    os.replace(tmp, statefile)


def claim_name(name):
    """Hold the name for this run's whole life, or die if a live run holds it.

    The lock is what makes the duplicate check atomic (DEMO-0011). Checking the
    state file and writing it later left a gap that two runs started together
    both passed, and the later one's state file hid the earlier from `stop`.
    flock has no such gap, and the kernel drops it when the process dies, even
    to SIGKILL -- so a crashed run cannot hold its name hostage.

    The lock file is never removed. Unlinking it would let a later run lock a
    fresh inode while an earlier one still holds the old, which is two owners.
    Returns the open descriptor, which must stay open until the run ends.
    Children do not inherit it: Popen closes descriptors by default, and an
    app left running must not keep the name.
    """
    fd = os.open(state_dir() / f"{name}.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        try:
            pid = json.loads((state_dir() / f"{name}.json").read_text())["pid"]
        except (OSError, ValueError, KeyError, TypeError):
            die(tr("a recording named {name} is already running.\n"
                   "  Use --name to tell this run apart from it.", name=repr(name)))
        die(tr("a recording named {name} is already running (pid {pid}).\n"
               "  Use --name to tell this run apart from it.", name=repr(name), pid=pid))
    return fd


def start_xvfb(width, height, base, logfile):
    """Start Xvfb on a display number it picks itself, behind an auth cookie.

    -displayfd is why two sessions can record at once: the server finds a free
    number and reports it back, so there is no window between "looks free" and
    "is ours" for a second run to lose.

    The cookie is why another local process cannot watch the recording. Measured
    on this machine: without one, a client with no credential at all reads the
    geometry and grabs a frame of whatever is on the display. Socket permissions
    are no answer — Xvfb also listens on an abstract socket, which has none.

    The number has to come first and the cookie is keyed to it, so the order is:
    start with an empty auth file, learn the number, write the cookie for it,
    and SIGHUP the server to re-read. Measured: Xvfb loads the file at its
    first connection, and none is made before the cookie is written, so the
    lock is on from the first. The SIGHUP covers a server that loaded the file
    earlier, and wait_until_locked proves the lock rather than trusting either.

    The server's stderr goes to a file, never to a pipe. It writes there for
    the whole run — every keymap an app loads adds xkbcomp's warnings — and a
    pipe nobody drains fills, then blocks the server mid-write. The display
    freezes, and so does every X call waiting on it: GIMP did this in the gate.
    """
    auth = Path(f"{base}.Xvfb.Xauthority")
    auth.unlink(missing_ok=True)
    auth.touch(mode=0o600)

    read_fd, write_fd = os.pipe()
    os.set_inheritable(write_fd, True)
    with open(logfile, "wb") as log:
        proc = subprocess.Popen(
            ["Xvfb", "-displayfd", str(write_fd), "-screen", "0",
             f"{width}x{height}x24", "-nolisten", "tcp", "-auth", str(auth),
             # Without it the server resets whenever its last client leaves,
             # which puts the pointer back at the centre the moment the
             # xdotool that parked it exits (DEMO-0103). SIGHUP still resets
             # it, which is how the cookie gets read.
             "-noreset"],
            pass_fds=(write_fd,),
            stdout=subprocess.DEVNULL,
            stderr=log,
            # Its own session, so Ctrl+C at a terminal does not reach it. It
            # did: Xvfb went down with the run's own SIGINT, the app with it,
            # and the end-of-run blank check was skipped as if the app had
            # closed itself (DEMO-0054).
            start_new_session=True,
        )
    os.close(write_fd)

    buf = b""
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while b"\n" not in buf:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        if not select.select([read_fd], [], [], remaining)[0]:
            continue
        chunk = os.read(read_fd, 64)
        if not chunk:
            break
        buf += chunk
    os.close(read_fd)

    number = buf.decode(errors="replace").strip()
    if not number.isdigit():
        proc.kill()
        auth.unlink(missing_ok=True)
        proc.wait()
        stderr = Path(logfile).read_text(errors="replace").strip()
        die(tr("Xvfb did not start, so there is no private display to record.")
            + ("\n  " + tr("It said: {text}", text=stderr) if stderr else "")
            + "\n  " + tr("`demoreel check` tests this start on its own."))

    display = f":{number}"
    cookie = secrets.token_hex(16)
    added = subprocess.run(["xauth", "-f", str(auth), "add",
                            display, "MIT-MAGIC-COOKIE-1", cookie],
                           capture_output=True, text=True, check=False)
    if added.returncode != 0:
        proc.kill()
        auth.unlink(missing_ok=True)
        die(tr("could not write the display's auth cookie, so the display "
               "cannot be made private.")
            + ("\n  " + tr("xauth said: {text}", text=added.stderr.strip())
               if added.stderr.strip() else "")
            + "\n  " + tr("`demoreel check` tests this on its own."))
    proc.send_signal(signal.SIGHUP)  # the server re-reads its auth file on reset

    # Do not report success until the cookie is actually in force. A client
    # holding the cookie connects before the lock as well as after it
    # (measured), so it alone proves nothing (DEMO-0113).
    if wait_until_locked(display, auth):
        return proc, display, auth
    proc.kill()
    auth.unlink(missing_ok=True)
    die(tr("the display did not lock: a client without its auth cookie "
           "could still connect, or none could."))
    return None  # unreachable; die() exits


def wait_until_locked(display, auth):
    """True once a client without the cookie is refused and one with it gets in.

    Both halves are needed. Before the cookie is in force both clients get in,
    so the holder connecting proves nothing; a dead display refuses both, so
    the stranger's refusal alone proves nothing either.
    """
    locked = dict(os.environ, DISPLAY=display, XAUTHORITY=str(auth))
    stranger = dict(os.environ, DISPLAY=display, XAUTHORITY=os.devnull)
    return bool(poll(
        lambda: (xdotool(stranger, "getdisplaygeometry").returncode != 0
                 and xdotool(locked, "getdisplaygeometry").returncode == 0),
        DISPLAY_READY_TIMEOUT, interval=0.1))


def start_gpu_display(width, height, base, logfile):
    """Start a GPU-capable private display: (cage, display, auth, wayland).

    Xvfb is a software X server with no DRI, so an OpenGL or Vulkan app cannot
    render on it at all — it is not slow there, it is absent. A rootful
    Xwayland on a headless `cage` compositor reaches the GPU. Same privacy
    property: cage shows one client and nothing else, and it is a separate
    compositor from the user's session.

    The order is fixed. cage's headless output starts at 1280x720, and an
    Xwayland already running keeps its first size however the output is
    resized later, so cage's one child resizes the output and only then
    becomes Xwayland (DEMO-0111). `xwfb-run` starts the two as one step, with
    no place for the resize, which is why it is not used.

    Nothing is guessed: cage picks its socket name and Xwayland its display
    number, and both come back on one pipe, in that order. -noreset keeps the
    pointer where park_pointer puts it, as on Xvfb (DEMO-0103).

    The cookie goes in after -displayfd reports the number, as on Xvfb, and
    Xwayland re-reads the changed file without being signalled. So the lock is
    proven by a client without the cookie being refused while one holding it
    connects: before the cookie both get in, and a dead display refuses both.
    """
    auth = Path(f"{base}.Xauthority")
    auth.unlink(missing_ok=True)
    auth.touch(mode=0o600)

    read_fd, write_fd = os.pipe()
    os.set_inheritable(write_fd, True)
    inner = (f'printf "%s\\n" "$WAYLAND_DISPLAY" >&{write_fd} && '
             f"wlr-randr --output HEADLESS-1 --custom-mode {width}x{height} && "
             f"exec Xwayland -displayfd {write_fd} -auth {shlex.quote(str(auth))} "
             f"-geometry {width}x{height} -fullscreen -noreset -nolisten tcp")
    with open(logfile, "wb") as log:
        # Its own session, so ending it takes Xwayland with it. The log is a
        # file for the reason start_xvfb gives: a pipe nobody drains blocks.
        proc = subprocess.Popen(
            ["cage", "--", "sh", "-c", inner],
            env=dict(os.environ, WLR_BACKENDS="headless"),
            pass_fds=(write_fd,), stdout=subprocess.DEVNULL, stderr=log,
            start_new_session=True)
    os.close(write_fd)

    buf = b""
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while buf.count(b"\n") < 2:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        if not select.select([read_fd], [], [], remaining)[0]:
            continue
        chunk = os.read(read_fd, 64)
        if not chunk:
            break
        buf += chunk
    os.close(read_fd)

    lines = buf.decode(errors="replace").split("\n")
    wayland = lines[0].strip()
    number = lines[1].strip() if len(lines) > 1 else ""
    if not wayland or not number.isdigit():
        end_process(proc, group=True)
        auth.unlink(missing_ok=True)
        tail = "\n  ".join(Path(logfile).read_text(errors="replace")
                           .strip().splitlines()[-3:])
        die(tr("the GPU display did not start, so there is nothing to record on.")
            + ("\n  " + tr("The end of its log:") + f"\n  {tail}" if tail else "")
            + "\n  " + tr("`demoreel check` says whether --gpu has what it needs."))

    display = f":{number}"
    added = subprocess.run(["xauth", "-f", str(auth), "add", display,
                            "MIT-MAGIC-COOKIE-1", secrets.token_hex(16)],
                           capture_output=True, text=True, check=False)
    if added.returncode != 0:
        end_process(proc, group=True)
        auth.unlink(missing_ok=True)
        die(tr("could not write the display's auth cookie, so the display "
               "cannot be made private.")
            + ("\n  " + tr("xauth said: {text}", text=added.stderr.strip())
               if added.stderr.strip() else "")
            + "\n  " + tr("`demoreel check` tests this on its own."))

    if wait_until_locked(display, auth):
        return proc, display, auth, wayland
    end_process(proc, group=True)
    auth.unlink(missing_ok=True)
    die(tr("the GPU display did not lock: a client without its auth cookie "
           "could still connect, or none could."))
    return None  # unreachable; die() exits


def xdotool(env, *args, check=False, stdin_text=None):
    """stdin_text feeds `type --file -`, which is how text stays out of the
    process list; every other call leaves stdin alone.

    Every call is bounded (DEMO-0079). A display that stops answering used to
    hang the run for good, because the startup deadline is checked between
    calls and nothing bounded one call.
    """
    timeout = CALL_TIMEOUT + TYPE_SECONDS_PER_CHAR * len(stdin_text or "")
    try:
        return subprocess.run(["xdotool", *[str(a) for a in args]], env=env,
                              input=stdin_text, capture_output=True, text=True,
                              check=check, timeout=timeout)
    except subprocess.TimeoutExpired:
        _display_gone.set()
        die(tr("the private display {display} stopped answering: "
               "`xdotool {command}` did not return within {seconds}s.",
               display=env.get("DISPLAY"), command=args[0], seconds=f"{timeout:g}"))


def window_geometry(env, wid):
    """(x, y, width, height), or None if the window vanished before the query."""
    out = xdotool(env, "getwindowgeometry", "--shell", wid).stdout
    dims = dict(line.split("=", 1) for line in out.split() if "=" in line)
    try:
        return tuple(int(dims[k]) for k in ("X", "Y", "WIDTH", "HEIGHT"))
    except (KeyError, ValueError):
        return None


def window_area(env, wid):
    geometry = window_geometry(env, wid)
    return geometry[2] * geometry[3] if geometry else 0


def window_off_frame(env, window, width, height):
    """Say how the window no longer fills the frame, or return None if it does.

    demoreel sizes the window once, before recording. An app that then sets
    its own size records cropped or off to one side, and the picture is not
    flat, so the blank check passes it (DEMO-0099). This is checked beside
    each blank sample, and it warns rather than fails: a window that moved is
    still a video of the app.
    """
    geometry = window_geometry(env, window)
    if geometry is None or geometry == (0, 0, width, height):
        return None
    x, y, w, h = geometry
    return tr("the app resized its window to {size} at {place}, so it no longer "
              "fills the {frame} frame and part of the video is cropped "
              "or empty.\n  Record at the app's own size with -s {size}.",
              size=f"{w}x{h}", place=f"{x},{y}", frame=f"{width}x{height}")


# A --gpu video whose frames changed less often than this is noted. Measured
# with changed_share on real --gpu recordings on 2026-10-02 (DEMO-0134):
# vkcube 100%; an xterm printing about 11.5 lines a second, which is about
# 39% new frames, 39%.
CHANGED_NOTE_BELOW = 0.7
CHANGED_WINDOW = 10
# "The picture changed", for `motion` and for the note above. The filter
# compares each frame with the last NEW one, not the one before, and counts it
# new when any 8x8 block moved by more than 640.
#
# Below 640, x264's own sharpening of a picture, over the frames after it
# changes, counts as new frames. Measured 2026-09-30 on patterns with a known
# number of new frames, encoded as the recorder encodes: 9 in 90 scored 44 at
# 256 and 9 at 640; 36 in 360 scored 167 and 36; 12 in 120 at 1280x800 scored
# 31 and 12. On the real recordings above, 256 scored that xterm 73%, so the
# note stayed silent on a video that stutters. That is the dangerous way to be
# wrong here. What 640 costs is faint, slow movement: a gradient drifting a
# little each frame scored 360 of 360 at 256 and 145 at 640, noticed only as
# it adds up, so such a video can be noted when it is smooth. The note never
# fails a run, which is why that is the side to err on. Movement with edges in
# it is unaffected: a moving pattern scored 60 of 60 at both, and a real
# recording 282 and 244 of 646.
NEW_FRAME = "mpdecimate=hi=640:lo=640:frac=0"


def changed_share(output, framerate):
    """The share of frames that differ from the one before, over a window from
    the middle of the video; None if it could not be measured.

    On --gpu a moving app that draws few frames records as runs of repeated
    ones, and nothing else notices. It was written when the X side's stale
    picture caused exactly that (DEMO-0109); record --gpu now captures the
    compositor's, so what is left is the app's own rate. A still app repeats
    frames too, which is why this only ever produces a note. One window, not the
    whole video: decoding a long recording to count would add most of its
    length.
    """
    try:
        probe = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(output)],
            capture_output=True, text=True, timeout=CALL_TIMEOUT, check=True)
        duration = float(probe.stdout.strip())
        window = min(CHANGED_WINDOW, duration)
        count = subprocess.run(
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
             "-ss", f"{(duration - window) / 2:.3f}", "-t", f"{window:.3f}",
             "-i", str(output), "-vf", NEW_FRAME,
             "-f", "null", "-",
             "-progress", "pipe:1", "-nostats"],
            capture_output=True, text=True, timeout=6 * CALL_TIMEOUT, check=True)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    kept = [ln for ln in count.stdout.splitlines() if ln.startswith("frame=")]
    frames = window * framerate
    if not kept or frames < framerate:
        return None
    return min(1.0, int(kept[-1].split("=", 1)[1]) / frames)


def named_windows(env):
    """The visible windows that carry a title, under either title property.

    `search --name .` reads only the old WM_NAME, and some apps set nothing but
    _NET_WM_NAME -- vkcube among them, so its window was never found and every
    run waited out the whole startup timeout (DEMO-0043). getwindowname reads
    both. The unfiltered list is no substitute: it also holds a nameless
    window the size of the display, which is not the app and would win on
    size. Two xdotool spawns per window, at about 2ms each, measured.
    """
    ids = xdotool(env, "search", "--onlyvisible", "").stdout.split()
    return [wid for wid in ids if xdotool(env, "getwindowname", wid).stdout.strip()]


def wait_for_window(env, app, timeout):
    """Return the id of the app's main window, or None if it never showed one.

    Biggest window wins. An app that opens a modal dialog at startup has two,
    and picking by search order gets the dialog about as often as not — which
    then gets stretched to fill the frame while the real window is left alone
    behind it. Size is the one signal that separates them without knowing
    anything about the app.
    """
    def biggest():
        ids = named_windows(env)
        if ids:
            return max(ids, key=lambda wid: window_area(env, wid))
        if app.poll() is not None:
            if app.returncode == 0:
                # The first line is what happened; the rest is a guess, and is
                # written as one. The hand-over is the common case here, but a
                # command that legitimately does its work and exits looks
                # identical from the outside, and so does one that failed for
                # its own reasons and still returned 0.
                die(tr("the app exited immediately (status 0) without opening a window.\n"
                       "  The likely cause is a single-instance app: it finds a copy already\n"
                       "  running on your real desktop, hands the request over to it and "
                       "exits\n"
                       "  successfully. If a copy is running, close it and try again.\n"
                       "  If not, the command may simply have finished without needing a\n"
                       "  window — in which case there is nothing to record."))
            die(tr("the app exited with status {status} before opening a "
                   "window.\n  Its own output, above or in --app-log, says why. To "
                   "see it on its own, run: {command}",
                   status=app.returncode, command=shlex.join(app.args)))
        return None
    # About 2ms of CPU per xdotool spawn, measured, so a tight poll costs
    # nothing and a loose one costs up to its whole interval in wall time.
    return poll(biggest, timeout, interval=0.05)


def wait_for_size(env, window, area, timeout=2.0):
    """Wait until a resize has landed, rather than sleeping a guessed interval.

    No window manager runs here, so the request is applied directly and this
    normally returns on the first check. The timeout is only for an app that
    refuses the size; recording goes ahead either way, as it always has.
    """
    poll(lambda: window_area(env, window) == area, timeout, interval=0.05)


# Every action verb, with the example a malformed step is told to follow.
ACTION_EXAMPLES = {"wait": "wait 2", "move": "move 400 300",
                   "click": "click 400 300", "type": "type some text",
                   "key": "key Return", "hold": "hold w 3",
                   "drag": "drag 200 300 600 300"}
# How long a drag takes when its step does not say, and how many times a
# second it moves the pointer on the way: often enough to look smooth.
DRAG_SECONDS = 0.5
DRAG_STEPS_PER_SECOND = 60


def parse_step(spec):
    """Read one -a step into (verb, values), or die saying how to write it.

    Every step is read before the display starts (prepare), so a typo in the
    last step fails the run at once rather than after most of a recording.
    None for an empty step, which does nothing.
    """
    # `type` takes the rest of the step exactly, after the verb and one space:
    # it is text to type, not arguments. Splitting it like a shell command
    # dropped its quotes, collapsed its spaces and died on an apostrophe
    # (DEMO-0101). The other verbs take short arguments, and keep the split.
    head, text = re.match(r"(\S*)\s?(.*)\Z", spec.lstrip(), re.DOTALL).groups()
    if head == "type":
        return "type", {"text": text}
    try:
        parts = shlex.split(spec)
    except ValueError as e:
        die(tr("cannot read the step {step}: {reason}.", step=repr(spec), reason=e))
    if not parts:
        return None
    verb, args = parts[0], parts[1:]
    if verb not in ACTION_EXAMPLES:
        die(tr("unknown action {action}. The steps are: {steps}.", action=repr(verb),
               steps=", ".join(repr(e) for e in ACTION_EXAMPLES.values())))
    # A malformed step used to reach float() or args[1] unchecked and end
    # the run with a Python traceback.
    try:
        if verb == "wait":
            return verb, {"seconds": float(args[0])}
        if verb == "hold":
            return verb, {"key": args[0], "seconds": float(args[1])}
        if verb == "drag":
            if len(args) not in (4, 5):
                raise IndexError
            seconds = float(args[4]) if len(args) == 5 else DRAG_SECONDS
            if not 0 <= seconds < math.inf:
                raise ValueError
            return verb, {"from": (int(args[0]), int(args[1])),
                          "to": (int(args[2]), int(args[3])), "seconds": seconds}
        if verb == "move" or (verb == "click" and args):
            return verb, {"at": (str(int(args[0])), str(int(args[1])))}
        if verb == "key" and not args:
            raise IndexError
    except (IndexError, ValueError):
        die(tr("cannot read the step {step}: write it like {example}.",
               step=repr(spec), example=repr(ACTION_EXAMPLES[verb])))
    return verb, {"keys": args, "at": None}


def read_steps(path):
    """The steps in a --steps file, or on stdin for `-`: one per line, as -a
    takes them. A step read this way is never in demoreel's own command line,
    which any local user can read for the whole run (DEMO-0025). A blank line
    and a line starting with `#` are skipped, as in an `edit` script."""
    try:
        text = sys.stdin.read() if path == "-" else Path(
            path).expanduser().read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        die(tr("could not read the steps file {path}: {reason}.",
               path=path, reason=getattr(exc, "strerror", None) or exc))
    return [line for line in text.splitlines()
            if line.strip() and not line.lstrip().startswith("#")]


def run_action(spec, env):
    """One scripted step: wait / move / click / type / key / hold / drag."""
    step = parse_step(spec)
    if step is None:
        return
    verb, v = step
    if verb == "wait":
        _stop.wait(v["seconds"])  # a stop ends the wait, as it ends the run
    elif verb == "move":
        xdotool(env, "mousemove", "--sync", *v["at"])
    elif verb == "click":
        if v["at"]:
            xdotool(env, "mousemove", "--sync", *v["at"])
        xdotool(env, "click", "1")
    elif verb == "type":
        # --file - takes the text on stdin. As an argument it sits in the
        # process list, readable by any other local user, for as long as the
        # typing lasts — and at 60ms a keystroke that is seconds. A demo that
        # types into a login form is the obvious thing to script.
        xdotool(env, "type", "--delay", "60", "--file", "-",
                stdin_text=v["text"])
    elif verb == "key":
        xdotool(env, "key", *v["keys"])
    elif verb == "hold":
        # The keyup runs however the hold ends -- time up, a stop, an error --
        # or the key stays down on the display for the rest of the run.
        xdotool(env, "keydown", v["key"])
        try:
            _stop.wait(v["seconds"])
        finally:
            xdotool(env, "keyup", v["key"])
    elif verb == "drag":
        (x1, y1), (x2, y2) = v["from"], v["to"]
        xdotool(env, "mousemove", "--sync", str(x1), str(y1))
        steps = max(1, round(v["seconds"] * DRAG_STEPS_PER_SECOND))
        started = time.monotonic()
        # The button comes up however the drag ends, as a held key does.
        xdotool(env, "mousedown", "1")
        try:
            for i in range(1, steps + 1):
                # Each move is timed from the start, so a slow xdotool shortens
                # the waits rather than stretching the drag.
                if _stop.wait(max(0, started + v["seconds"] * i / steps
                                  - time.monotonic())):
                    break
                # No --sync: it waits for the pointer to move, and a short
                # drag lands on the same pixel twice.
                xdotool(env, "mousemove", str(round(x1 + (x2 - x1) * i / steps)),
                        str(round(y1 + (y2 - y1) * i / steps)))
        finally:
            xdotool(env, "mouseup", "1")


# How ffmpeg encodes every video demoreel writes with it: the recording on
# Xvfb and every finishing command, so one command's file is the same kind as
# another's. record --gpu's recorder is told the same in its own options.
ENCODER = [
    "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
    # x264's default is a multiple of the cores, and its buffers set most
    # of a recording's memory: about 530 MB peak on twelve cores, about
    # 270 MB at four. Four threads pinned to four cores still encoded a
    # full-frame glxgears at 1600x1000 with no dropped or duplicated
    # frame (DEMO-0073).
    "-threads", "4",
    "-pix_fmt", "yuv420p", "-movflags", "+faststart",
]
# And the sound, for record --audio.
AUDIO_ENCODER = ["-c:a", "aac", "-b:a", "192k", "-ar", "48000", "-ac", "2"]


def start_ffmpeg(env, display, width, height, framerate, output, logfile, cursor,
                 monitor=None):
    """Record the display. env matters: the GPU backend's Xwayland wants an
    auth cookie, and ffmpeg is as much a client of that display as xdotool.

    With `monitor`, a sink's monitor, the sound is recorded too, into the part
    file, and finish_audio_video puts it in step with the picture.

    Returns the process, its log, and how many seconds before this returns
    the video's first frame was grabbed."""
    # level+info marks each log line with its level: the info lines carry the
    # first frame's time, and the failure message below leaves them out.
    # -nostats, or the status line fills the log twenty times a second.
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "level+info", "-nostats",
        "-progress", "pipe:1", "-stats_period", "0.05",
        # A deep queue on each input, so neither drops packets while ffmpeg
        # reads the other.
        *(["-thread_queue_size", "1024"] if monitor else []),
        "-f", "x11grab", "-framerate", str(framerate),
        "-draw_mouse", "1" if cursor else "0",
        "-video_size", f"{width}x{height}", "-i", f"{display}.0",
        *(["-thread_queue_size", "1024", "-f", "pulse", "-i", monitor]
          if monitor else []),
        *ENCODER, *(AUDIO_ENCODER if monitor else []),
        "-y", str(partial_video(output) if monitor else output),
    ]
    # Deliberate: the handle is owned by the ffmpeg process and closed in
    # record()'s finally block, so it must outlive this statement.
    log = open(logfile, "wb")  # noqa: SIM115
    spawned = time.time()
    # Its own session, so a terminal's Ctrl+C or hang-up cannot end it before
    # stop_recorder does: a SIGHUP killed it with no index written, and the
    # run printed the path of a file nothing could play (DEMO-0115).
    proc = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=log,
                            start_new_session=True)
    # Return when ffmpeg is actually capturing, not after a guessed interval.
    # The first progress report is that signal: it arrives once the input is
    # open and frames are flowing. A blind sleep in its place was recorded
    # into every video (DEMO-0012). The frame count in those reports is no
    # use as the signal -- it counts ENCODED frames and sits at 0 for most of
    # a second while x264 fills its look-ahead.
    ready = select.select([proc.stdout], [], [], DISPLAY_READY_TIMEOUT)[0]
    if not ready or not proc.stdout.readline():
        proc.kill()
        proc.wait()
        log.close()
        partial_video(output).unlink(missing_ok=True)
        tail = "\n".join(
            line for line in Path(logfile).read_text(errors="replace").splitlines()
            if not line.startswith("[info]")).strip()
        die(tr("ffmpeg could not start recording.")
            + ("\n  " + tr("It said: {text}", text=tail) if tail else "")
            + "\n  " + tr("`demoreel check` tests the programs and the encoder it needs."))
    # The video runs from the first frame grabbed, and the report comes later:
    # 0.15s on an idle machine, 0.4s with two cores loaded, every bit of it
    # added to the video when the countdown started here (DEMO-0169). x11grab
    # stamps frames with the wall clock, and ffmpeg names the first one's time
    # as "start:" when it opens the display, before any report. A time
    # outside this call cannot be that frame, so it is not trusted.
    now = time.time()
    found = re.search(rb"start: (\d+\.\d+)", Path(logfile).read_bytes())
    lag = now - float(found[1]) if found and spawned <= float(found[1]) <= now else 0.0
    # Keep draining the reports, or ffmpeg blocks once the pipe fills.
    threading.Thread(target=proc.stdout.read, daemon=True).start()
    return proc, log, lag


def partial_video(output):
    """Where a recording is written before it is finished -- record --gpu's,
    and an --audio one's: beside the output, on its disk, and not in the
    state directory, which is RAM."""
    return output.with_name(f".{output.stem}.demoreel-part.mp4")


def start_wf_recorder(env, wayland, framerate, output, logfile, monitor=None):
    """Record cage's own output, for record --gpu (DEMO-0111).

    Under a busy 3D app the X side's copy of the picture goes stale, so x11grab
    records a slideshow: 156 new frames of 588 where this got 643 of 643, over
    the same run (DEMO-0109). -D asks for every frame rather than only changed
    ones, without which SIGINT is also ignored while the screen is still, and
    -y stops it prompting before an overwrite. The encoder settings match
    start_ffmpeg's, so the two backends hand back the same kind of file. With
    `monitor` it records the sound as well; whether that track is in step is
    not measured, as wf-recorder would not start here (DEMO-0106 § 13).

    It prints no progress reports, so the start signal is the line announcing
    its output, printed once the encoder has its first frame. The countdown is
    counted from there (DEMO-0012). Unlike ffmpeg it names no time for that
    frame, so start_ffmpeg's correction for a late signal (DEMO-0169) has no
    counterpart here.
    """
    part = partial_video(output)
    cmd = ["wf-recorder", "-D", "-y", "-r", str(framerate),
           "-c", "libx264", "-p", "preset=veryfast", "-p", "crf=23",
           "-x", "yuv420p", "-f", str(part)]
    if monitor:
        # One argument: the device is optional (-a, --audio [=DEVICE]), so a
        # separate one would be read as the next option.
        cmd += [f"--audio={monitor}", "-C", "aac"]
    # Deliberate: closed in record()'s finally block, as start_ffmpeg's is.
    log = open(logfile, "wb")  # noqa: SIM115
    # Unbuffered, or a readline that pulls in several lines leaves the rest in
    # Python's buffer, where select cannot see them: the start line sat there
    # unread until the deadline and the run failed, one run in three.
    proc = subprocess.Popen(cmd, env=dict(env, WAYLAND_DISPLAY=wayland),
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, bufsize=0,
                            start_new_session=True)  # as ffmpeg's, DEMO-0115
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while True:
        remaining = deadline - time.monotonic()
        line = (proc.stdout.readline()
                if remaining > 0 and select.select([proc.stdout], [], [], remaining)[0]
                else b"")
        log.write(line)
        if line.startswith(b"Output #0"):
            break
        if not line:
            proc.kill()
            proc.wait()
            log.close()
            part.unlink(missing_ok=True)
            tail = Path(logfile).read_text(errors="replace").strip()
            die(tr("wf-recorder could not start recording.")
                + ("\n  " + tr("It said: {text}", text=tail) if tail else "")
                + "\n  " + tr("`demoreel check` says whether --gpu has what it needs."))
    # Keep copying its output to the log, or it blocks once the pipe fills.
    threading.Thread(target=lambda: log.write(proc.stdout.read()),
                     daemon=True).start()
    return proc, log


def finish_gpu_video(output, logfile):
    """Give record --gpu's file the +faststart the Xvfb path's has.

    wf-recorder has no option for muxer flags, so a stream copy moves the index
    to the front. Nothing is re-encoded. The partial file is kept if the copy
    fails, and the message names it.
    """
    finish_part(output, logfile, ["-i", str(partial_video(output)), "-c", "copy"])


def input_starts(logfile):
    """Each input's wallclock start in ffmpeg's log, by kind: x11grab, pulse."""
    starts, kind = {}, None
    for line in Path(logfile).read_text(errors="replace").splitlines():
        opened = re.search(r"Input #\d+, (\w+), from", line)
        if opened:
            kind = opened[1]
            continue
        found = re.search(r"\bstart: (-?\d+\.\d+)", line)
        if kind and found:
            starts.setdefault(kind, float(found[1]))
    return starts


def finish_audio_video(output, logfile):
    """Put an --audio recording's sound in step with its picture (DEMO-0106).

    ffmpeg starts each stream at zero, but the pulse input opens later than
    x11grab, so the sound came out early (measured: a beep 0.53 s before the
    flash played with it). Each input's wallclock start is in the log, and
    shifting the sound by the gap brought the two to 14 ms apart.

    The sound is then fitted to the picture rather than the picture to the
    sound. The pulse input stops with a third of a second or so still
    buffered, so its track ends early, and -shortest cut that much off the
    picture: a -d 6 run came out 5.67 s long. So the sound is padded with
    silence to the picture's end and trimmed there, and only the sound is
    encoded again. The picture is copied as it was recorded.
    """
    part = partial_video(output)
    if not part.exists():
        return
    starts = input_starts(logfile)
    length = stream_length(part, "v:0")
    if "x11grab" not in starts or "pulse" not in starts or length is None:
        die(tr("could not put the sound in step with the picture: the recorder's "
               "log does not say when each started.\n  What was recorded is kept "
               "in {part}, and the log is {log}.", part=part, log=logfile))
    shift = starts["pulse"] - starts["x11grab"]
    fit = f"{max(0.0, length - shift):.6f}"
    finish_part(output, logfile, [
        "-i", str(part), "-itsoffset", f"{shift:.6f}", "-i", str(part),
        "-map", "0:v", "-map", "1:a", "-c:v", "copy",
        "-af", f"apad=whole_dur={fit},atrim=duration={fit}", *AUDIO_ENCODER])


def stream_length(path, stream):
    """How long `stream` of the file at `path` runs, in seconds; None if
    ffprobe cannot say."""
    try:
        return float(subprocess.run(
            ["ffprobe", "-v", "error", "-select_streams", stream,
             "-show_entries", "stream=duration", "-of", "csv=p=0", str(path)],
            capture_output=True, text=True, timeout=CALL_TIMEOUT, check=True).stdout)
    except (subprocess.SubprocessError, ValueError):
        return None


def finish_part(output, logfile, inputs):
    """Write the part file to the output with `inputs`, then remove it."""
    part = partial_video(output)
    if not part.exists():
        return
    copy = subprocess.run(  # noqa: PLW1510 - a failed copy is handled below
        ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
         *inputs, "-movflags", "+faststart", "-y", str(output)],
        capture_output=True, timeout=6 * CALL_TIMEOUT)
    if copy.returncode != 0:
        with open(logfile, "ab") as log:
            log.write(copy.stderr)
        die(tr("could not finish the video: turning the recording into {name}"
               " failed.\n  What was recorded is kept in {part}, and {log}"
               " says why.", name=output.name, part=part, log=logfile))
    part.unlink()


class SampleError(Exception):
    """The display could not be sampled, so whether it is blank is unknown."""


def display_is_blank(env, display, width, height):
    """True if the display is one flat colour, i.e. nothing is drawn on it.

    Silently recording nothing is the worst failure this tool has: valid file,
    exit 0, black picture, every signal saying success. So grab one frame and
    measure how much of it is a single grey level. Measured here: an empty Xvfb
    is 0.99994, and a window as small as 200x100 on a 1280x800 display already
    drops it to 0.98 — so the threshold has room on both sides.

    Raises SampleError when no frame comes back. That is the third answer,
    "could not tell", and it must not collapse into either of the other two:
    reading it as "not blank" is how this guard used to pass everything the
    moment its own measurement broke (DEMO-0033). A grab that does not return
    in time is that answer too (DEMO-0079): the display stopped answering.
    """
    try:
        grab = subprocess.run(  # noqa: PLW1510 - a failed grab is handled below
            ["ffmpeg", "-hide_banner", "-loglevel", "error",
             "-f", "x11grab", "-video_size", f"{width}x{height}",
             "-i", f"{display}.0", "-frames:v", "1",
             "-pix_fmt", "gray", "-f", "rawvideo", "-"],
            env=env, capture_output=True, timeout=CALL_TIMEOUT)
    except subprocess.TimeoutExpired:
        _display_gone.set()
        raise SampleError(tr("the display did not give up a frame within "
                             "{seconds}s; it has stopped answering",
                             seconds=CALL_TIMEOUT)) from None
    if grab.returncode != 0 or len(grab.stdout) != width * height:
        lines = [ln for ln in grab.stderr.decode(errors="replace").splitlines()
                 if ln.strip()]
        raise SampleError("\n  ".join(lines[-3:])
                          or tr("ffmpeg exited {status} with no frame",
                                status=grab.returncode))
    return frame_is_flat(grab.stdout)


def video_is_blank(output, at, width, height):
    """True if the finished video is one flat colour at `at` seconds in, or in
    its last half second when `at` is None.

    display_is_blank reads the X side, and on record --gpu the video comes from
    the compositor instead, so a recorder writing black under a drawn display
    would pass it. This asks the file the same question, at the moments the
    display was asked, with the same test. Raises SampleError, as that does.
    """
    seek = ["-sseof", "-0.5"] if at is None else ["-ss", f"{at:.3f}"]
    try:
        grab = subprocess.run(  # noqa: PLW1510 - a failed read is handled below
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
             *seek, "-i", str(output), "-frames:v", "1",
             "-pix_fmt", "gray", "-f", "rawvideo", "-"],
            capture_output=True, timeout=CALL_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise SampleError(tr("reading a frame of {path} took over {seconds}s",
                             path=output, seconds=CALL_TIMEOUT)) from None
    if grab.returncode != 0 or len(grab.stdout) != width * height:
        lines = [ln for ln in grab.stderr.decode(errors="replace").splitlines()
                 if ln.strip()]
        raise SampleError("\n  ".join(lines[-3:])
                          or tr("no frame of {path} could be read", path=output))
    return frame_is_flat(grab.stdout)


def dominant_fraction(frame):
    """The share of a raw grey frame taken by its commonest byte value.

    One pass per distinct byte value, which looks worse than Counter's single
    pass and is not. Measured on a 1600x1000 frame: on a blank display, one
    distinct value, this form is about five times faster; on a busy screen with
    every value present it is about twice as slow. The case it wins is what
    wait_until_drawn polls against, and the case it loses is sampled once at the
    end of a run. Do not tidy it into Counter.most_common.
    """
    return max(frame.count(v) for v in set(frame)) / len(frame)


def frame_is_flat(frame):
    """True if the frame is one flat colour by BLANK_THRESHOLD's measure.

    The threshold AND its comparator live here together, because splitting them
    is what let a copy drift: a frame measuring exactly the threshold would pass
    one side and fail the other.

    The question is yes or no, so it seldom needs every value counted
    (DEMO-0076). Count one likely candidate, the commonest value in a thin
    sample. Over the threshold: flat. At least the rest (1 - threshold): not
    flat, since no other value can then reach the threshold. Only a sample
    that picked a rare value falls back to dominant_fraction. The answer is
    the same either way; on a busy 1600x1000 frame it takes a fraction of the
    time, which the end-of-run check waits on.
    """
    sample = frame[::997]
    if sample:
        candidate = max(set(sample), key=sample.count)
        share = frame.count(candidate) / len(frame)
        if share > BLANK_THRESHOLD:
            return True
        if share >= 1 - BLANK_THRESHOLD:
            return False
    return dominant_fraction(frame) > BLANK_THRESHOLD


def wait_until_drawn(env, display, width, height, timeout):
    """Hold the recorder until the app has actually drawn something.

    A GPU app can spend seconds on a black screen while it builds acceleration
    structures, and recording that means the caller trims the head off
    afterwards, which costs a second encode. Same uniform-frame test as the
    end-of-run check, used here as a gate rather than as an assertion.
    """
    # Back the poll off as the wait lengthens. Each sample spawns an ffmpeg and
    # moves a whole frame across a process boundary -- about 112ms of CPU on a
    # 1600x1000 display -- so a fixed quarter-second poll burns most of a core.
    # --settle exists for apps that spend seconds building GPU acceleration
    # structures, which means the sampler was competing for the machine with
    # the very work it was waiting for.
    #
    # Starting tighter than the old fixed interval and widening to a ceiling
    # answers a fast-drawing app sooner and a slow one far more cheaply. The
    # ceiling is what it costs: up to that long between the app drawing and the
    # recorder noticing. That is the right trade here, because the alternative
    # is taking CPU from the app to find out a second earlier.
    #
    # A smaller frame is NOT the lever, and was measured: decimating to a
    # hundredth of the data gives an all but identical answer and saves about
    # 10%, because the cost is the process spawn and the capture, not the data.
    return bool(poll(lambda: not display_is_blank(env, display, width, height),
                     timeout, interval=0.1, grow=1.5, ceiling=1.0))


def stop_recorder(proc):
    """Ask the recorder to finish so the file gets its index written; a killed
    recorder leaves an mp4 that most players refuse to open. ffmpeg takes `q`
    on its stdin, wf-recorder takes SIGINT."""
    if proc.poll() is not None:
        return
    if _display_gone.is_set():  # no video to save, and it cannot finish
        proc.kill()
        proc.wait()
        return
    try:
        if proc.args[0] == "wf-recorder":
            proc.send_signal(signal.SIGINT)
        else:
            proc.stdin.write(b"q")
            proc.stdin.flush()
            proc.stdin.close()
    except OSError:
        proc.terminate()
    try:
        proc.wait(timeout=15)
    except subprocess.TimeoutExpired:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()


def end_process(proc, group=False):
    if proc is None or proc.poll() is not None:
        return
    try:
        if group:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        else:
            proc.terminate()
        proc.wait(timeout=5)
    except (subprocess.TimeoutExpired, ProcessLookupError, PermissionError):
        try:
            if group:
                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            else:
                proc.kill()
        except (ProcessLookupError, PermissionError):
            pass


# Every record and shot gives its app a sound output of its own, a null sink
# that nothing plays, so the app's sound never reaches the speakers; --audio
# records that sink's monitor (DEMO-0105, DEMO-0106). The name carries the
# run's pid, which is how a sink left by a killed run is told from a live one's.
SINK_PREFIX = f"demoreel-{os.getuid()}-"
# volumedetect's loudest moment at or below this is a silent track. A null
# sink with nothing playing records digital silence, far below it.
SILENT_DB = -60.0


class SoundUnavailable(Exception):
    """No private sound output could be made; the message says why."""


def pactl(*args):
    """Run pactl and return what it printed; SoundUnavailable if it failed.
    It talks to PulseAudio and to PipeWire's PulseAudio server alike."""
    if shutil.which("pactl") is None:
        raise SoundUnavailable(tr("pactl is not installed."))
    try:
        done = subprocess.run(["pactl", *map(str, args)], capture_output=True,
                              text=True, timeout=CALL_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        raise SoundUnavailable(tr("pactl did not answer within {seconds}s.",
                                  seconds=CALL_TIMEOUT)) from None
    except OSError as exc:
        raise SoundUnavailable(exc.strerror) from None
    if done.returncode != 0:
        said = (done.stderr or done.stdout).strip() or f"exit {done.returncode}"
        raise SoundUnavailable(tr("pactl failed: {text}", text=said))
    return done.stdout


class Sound:
    """A run's private sink: the name the app is sent to, and the module index
    that unloads it. Only the run that loaded it unloads it, in its finally;
    `stop` never does, and a sink left behind is found by name alone."""

    def __init__(self, sink, index):
        self.sink = sink
        self.index = index

    def env(self):
        # Both. With PULSE_SINK alone, aplay's tone went through PipeWire's
        # ALSA plugin to the speakers; PIPEWIRE_NODE catches it and pw-play
        # (measured 2026-10-10). A Flatpak passes both into its sandbox.
        return {"PULSE_SINK": self.sink, "PIPEWIRE_NODE": self.sink}

    def unload(self):
        """Unload the sink; a second call does nothing."""
        if self.index is not None:
            with contextlib.suppress(SoundUnavailable):
                pactl("unload-module", self.index)
            self.index = None


def sweep_sinks():
    """Unload every sink a dead run of this user left behind.

    A run killed with SIGKILL runs no finally, and its sink stays loaded
    (measured). Only names starting with this user's prefix are touched, and
    only those whose pid is gone. A pid reused by another process keeps its
    sink until that process ends: a sink nothing plays to costs nothing, and
    unloading a live run's would cut its sound off.
    """
    for line in pactl("list", "short", "modules").splitlines():
        fields = line.split("\t")
        if len(fields) < 3 or fields[1] != "module-null-sink":
            continue
        found = re.search(rf"(?:^|\s)sink_name={re.escape(SINK_PREFIX)}(\d+)-",
                          fields[2])
        if found and not alive(int(found[1])):
            with contextlib.suppress(SoundUnavailable):
                pactl("unload-module", fields[0])


def load_sink(name):
    """Load this run's private sink and prove it is the only one of its name.

    The server does not make sink names unique: two loads of one name both
    succeeded (measured). So the name is not trusted to be free beforehand;
    it is checked after loading, as claim_name checks a run name.
    """
    sweep_sinks()
    sink = f"{SINK_PREFIX}{os.getpid()}-{secrets.token_hex(8)}"
    label = re.sub(r"[^A-Za-z0-9._-]", "_", name)
    sound = Sound(sink, pactl(
        "load-module", "module-null-sink", f"sink_name={sink}",
        f"sink_properties=device.description=demoreel-{label}").strip())
    try:
        names = [line.split("\t")[1]
                 for line in pactl("list", "short", "sinks").splitlines()
                 if "\t" in line]
    except SoundUnavailable:
        sound.unload()
        raise
    if names.count(sink) != 1:
        sound.unload()
        raise SoundUnavailable(tr("the sound server does not list exactly one "
                                  "output named {sink}.", sink=sink))
    return sound


def private_sound(audio, name):
    """The run's private sink, or None where none can be made.

    Without --audio that is a note, and the app's sound may be heard. With it
    the run ends here, before the app starts.
    """
    try:
        return load_sink(name)
    except SoundUnavailable as exc:
        if audio:
            die(tr("--audio needs a private sound output, and none could be "
                   "made.\n  {reason}", reason=exc))
        note(tr("no private sound output could be made, so the app's sound may "
                "play on your speakers.\n  {reason}", reason=exc))
        return None


def has_pulse_input():
    """Whether this ffmpeg can read from a sound server; True if it cannot
    tell, as has_libx264 does."""
    try:
        devices = subprocess.run(["ffmpeg", "-hide_banner", "-devices"],
                                 capture_output=True, text=True,
                                 timeout=CALL_TIMEOUT, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return True
    return re.search(r"^ D\S* +pulse\b", devices, re.MULTILINE) is not None


def loudest(output):
    """The loudest moment of the video's sound in dB; None if it cannot tell."""
    try:
        done = subprocess.run(
            ["ffmpeg", "-nostdin", "-hide_banner", "-i", str(output), "-map", "0:a",
             "-af", "volumedetect", "-f", "null", "-"],
            capture_output=True, text=True, timeout=6 * CALL_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = re.search(r"max_volume: (-?[\d.]+|-inf) dB", done.stderr)
    return float(found[1]) if found else None


FLATPAK_FLAGS = ("--socket=x11", "--nosocket=wayland", "--filesystem=/tmp/.X11-unix")


def warn_if_flatpak_underflagged(command):
    """Say up front when a Flatpak target is missing the flags it needs.

    Without them the app renders on the user's real compositor, the virtual
    display stays empty, and the run fails the blank check with a message
    listing two possible causes. We can tell which one it is before spending
    the recording on it.

    A warning, not an error: a manifest with no wayland socket does not need
    --nosocket=wayland, and refusing would break an invocation that works. This
    reads the caller's own command line and knows nothing about any
    application, which is what keeps it out of per-app profile territory.
    """
    if Path(command[0]).name != "flatpak" or "run" not in command:
        return
    missing = [f for f in FLATPAK_FLAGS
               if not any(arg.startswith(f) for arg in command)]
    if missing:
        note(tr("this is a Flatpak target and the command is missing: {flags}",
                flags=", ".join(missing)))
        # One sentence over two lines, each a note of its own. Splitting it is
        # layout: nothing reads a meaning out of the parts.
        for line in tr("A missing one can send it to your real compositor instead, "
                       "leaving this\nrecording empty. README.md says what each "
                       "flag is for.").split("\n"):
            note(f"  {line}")


# Which package gives each program, per package manager, looked up in each
# distro's own package index on 2026-09-27 (DEMO-0051): openSUSE from rpm on
# this machine, the rest with apt-file, dnf repoquery and pacman -F in their
# own containers. pactl's, for --audio, the same way on 2026-10-10
# (DEMO-0106). Knowledge about distros, not about apps.
PACKAGES = {
    "zypper": ("sudo zypper install", {
        "ffmpeg": "ffmpeg", "ffprobe": "ffmpeg", "xdotool": "xdotool",
        "xauth": "xauth", "Xvfb": "xorg-x11-server-Xvfb", "cage": "cage",
        "Xwayland": "xwayland", "wlr-randr": "wlr-randr",
        "wf-recorder": "wf-recorder", "pactl": "pulseaudio-utils"}),
    "apt": ("sudo apt install", {
        "ffmpeg": "ffmpeg", "ffprobe": "ffmpeg", "xdotool": "xdotool",
        "xauth": "xauth", "Xvfb": "xvfb", "cage": "cage",
        "Xwayland": "xwayland", "wlr-randr": "wlr-randr",
        "wf-recorder": "wf-recorder", "pactl": "pulseaudio-utils"}),
    "dnf": ("sudo dnf install", {
        "ffmpeg": "ffmpeg", "ffprobe": "ffmpeg", "xdotool": "xdotool",
        "xauth": "xorg-x11-xauth", "Xvfb": "xorg-x11-server-Xvfb",
        "cage": "cage", "Xwayland": "xorg-x11-server-Xwayland",
        "wlr-randr": "wlr-randr", "wf-recorder": "wf-recorder", "pactl": "pulseaudio-utils"}),
    "pacman": ("sudo pacman -S", {
        "ffmpeg": "ffmpeg", "ffprobe": "ffmpeg", "xdotool": "xdotool",
        "xauth": "xorg-xauth", "Xvfb": "xorg-server-xvfb", "cage": "cage",
        "Xwayland": "xorg-xwayland", "wlr-randr": "wlr-randr",
        "wf-recorder": "wf-recorder", "pactl": "libpulse"}),
}
# /etc/os-release ID or ID_LIKE -> package manager.
DISTRO_FAMILIES = {"opensuse": "zypper", "suse": "zypper", "debian": "apt",
                   "ubuntu": "apt", "fedora": "dnf", "arch": "pacman"}
# Measured in containers the same day: the distros' own ffmpeg on openSUSE
# (ffmpeg-8) and Fedora (ffmpeg-free) has no libx264 encoder; Packman's and
# RPM Fusion's do (DEMO-0117). x264_advice says what to do about it.
X264_FAMILIES = ("zypper", "dnf")


def x264_advice(family):
    """How to get an ffmpeg with libx264 on this distro, as lines to append."""
    if family == "zypper":
        return "\n  " + tr("openSUSE's own ffmpeg leaves it out. Install ffmpeg from the "
                           "Packman repository,\n  which has it.")
    if family == "dnf":
        return ("\n  " + tr("Fedora's ffmpeg-free leaves it out. Enable RPM Fusion, then:")
                + "\n    sudo dnf swap ffmpeg-free ffmpeg --allowerasing")
    return "\n  " + tr("Install a build of ffmpeg that includes libx264.")


def distro_family():
    """The package manager this distro uses, from /etc/os-release; None if
    it is not one the table knows."""
    try:
        lines = Path("/etc/os-release").read_text().splitlines()
    except OSError:
        return None
    fields = dict(line.split("=", 1) for line in lines if "=" in line)
    ids = [fields.get("ID", ""), *fields.get("ID_LIKE", "").split()]
    for name in (i.strip('"') for i in ids):
        family = DISTRO_FAMILIES.get(name)
        if family:
            return family
    return None


def install_hint(programs):
    """The command that installs `programs` here, or "" on an unknown distro."""
    family = distro_family()
    if family is None:
        return ""
    command, names = PACKAGES[family]
    packages = list(dict.fromkeys(names[p] for p in programs if p in names))
    hint = "\n  " + tr("Install with: {command}",
                       command=f"{command} {' '.join(packages)}")
    if "ffmpeg" in packages and family in X264_FAMILIES:
        hint += x264_advice(family)
    return hint


def has_libx264():
    try:
        encoders = subprocess.run(["ffmpeg", "-hide_banner", "-encoders"],
                                  capture_output=True, text=True,
                                  timeout=CALL_TIMEOUT, check=False).stdout
    except subprocess.TimeoutExpired:
        return True  # cannot tell; let the recording itself say what is wrong
    return " libx264 " in encoders


def linked_library(program, stem):
    """The file `program` loads for the library named `stem` (such as
    "libavcodec.so"), from ldd; None if it cannot tell."""
    path = shutil.which(program)
    if path is None:
        return None
    try:
        listing = subprocess.run(["ldd", path], capture_output=True, text=True,
                                 timeout=CALL_TIMEOUT, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    found = re.search(rf"^\s*{re.escape(stem)}\S* => (/\S+)", listing, re.MULTILINE)
    return found[1] if found else None


def start_failure(program):
    """What `program --version` printed if it failed, such as a library it
    cannot load, or its exit status if it printed nothing; None if it ran or
    if it cannot tell (DEMO-0176)."""
    try:
        done = subprocess.run([program, "--version"], capture_output=True, text=True,
                              timeout=CALL_TIMEOUT, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if done.returncode == 0:
        return None
    return (done.stderr or done.stdout).strip() or f"exit {done.returncode}"


def has_encoder(library, encoder):
    """Whether the libavcodec at `library` has `encoder`. wf-recorder loads
    libavcodec itself rather than running ffmpeg, so the ffmpeg program having
    libx264 says nothing about it (DEMO-0171). True if it cannot tell, as
    has_libx264 does."""
    try:
        find = ctypes.CDLL(library).avcodec_find_encoder_by_name
    except (OSError, AttributeError):
        return True
    find.restype = ctypes.c_void_p
    find.argtypes = [ctypes.c_char_p]
    return find(encoder.encode()) is not None


def required_programs(gpu, recording):
    """What a run needs installed, for its backend and for record or shot."""
    required = ["ffmpeg", "xdotool", "xauth"] + (["ffprobe"] if recording else [])
    if gpu:
        return required + ["cage", "Xwayland", "wlr-randr"] + (
            ["wf-recorder"] if recording else [])
    return [*required, "Xvfb"]


def prepare(a, suffix):
    """What `record` and `shot` both check before starting anything: the tools,
    the app command, the size, and where the output and the app log go."""
    recording = suffix == ".mp4"
    missing = [t for t in required_programs(a.gpu, recording)
               if shutil.which(t) is None]
    if missing:
        die(tr("missing required program(s): {programs}", programs=", ".join(missing))
            + install_hint(missing))
    if recording and not has_libx264():
        die(tr("this ffmpeg cannot encode H.264 with libx264, which every "
               "recording uses.") + x264_advice(distro_family()))
    if getattr(a, "audio", False):
        if shutil.which("pactl") is None:
            die(tr("missing required program(s): {programs}", programs="pactl")
                + install_hint(["pactl"]))
        if not has_pulse_input():
            die(tr("--audio needs an ffmpeg that can read from a sound server, "
                   "and this one has no pulse input."))
    if recording and a.gpu and a.cursor:
        die(tr("--cursor is not available with record --gpu: that backend records "
               "the compositor's picture, which never has the pointer in it."))

    if a.steps is not None:
        if a.action:
            die(tr("give the steps with -a or with --steps, not both."))
        a.action = read_steps(a.steps)
    for spec in a.action:
        parse_step(spec)  # every step is readable before anything starts

    command = list(a.command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        die(tr("give the app to run after `--`, e.g. {example}",
               example=f"demoreel {a.cmd} -- xclock"))
    warn_if_flatpak_underflagged(command)

    match = SIZE_RE.match(a.size)
    if not match:
        die(tr("--size takes a width and a height in pixels, like 1600x1000, "
               "not {size}.", size=repr(a.size)))
    width, height = int(match[1]), int(match[2])
    if suffix == ".mp4" and (width % 2 or height % 2):
        die(tr("--size needs even numbers for a video, since H.264 cannot encode "
               "an odd width or height.\n  Try {size}.",
               size=f"{width + width % 2}x{height + height % 2}"))

    if a.output:
        output = own_path(a.output, "output")
    else:
        stem = re.sub(r"[^A-Za-z0-9._-]", "_", Path(command[0]).name) or "demo"
        output = Path.cwd() / f"{stem}-{time.strftime('%Y%m%d-%H%M%S')}{suffix}"
    output.parent.mkdir(parents=True, exist_ok=True)

    applog = own_path(a.app_log, "app log") if a.app_log else None
    if applog:
        applog.parent.mkdir(parents=True, exist_ok=True)
    return command, width, height, output, applog


def own_path(raw, what):
    """Resolve a path demoreel will write, refusing a symlink someone else made.

    resolve() follows the link here, in demoreel, so the writer is handed its
    target and the kernel's fs.protected_symlinks never gets to refuse it.
    Measured: a link at the -o path had its target overwritten, exit 0. So
    another local user could plant /tmp/demo.mp4 pointing at one of your files
    and have your run overwrite it (DEMO-0082). A link you made yourself is
    yours to follow. A link planted after this check is opened by the writer,
    and there the kernel's protection applies. `what` is "output" or "app log".
    """
    path = Path(os.path.abspath(Path(raw).expanduser()))
    if path.is_symlink() and path.lstat().st_uid != os.getuid():
        if what == "app log":
            die(tr("the app log {path} is a symbolic link another user made, so "
                   "demoreel\n  will not write through it: it could point at a file "
                   "of yours.\n  Choose another path, or remove the link if it is "
                   "not meant to be there.", path=path))
        die(tr("the output {path} is a symbolic link another user made, so demoreel\n"
               "  will not write through it: it could point at a file of yours.\n"
               "  Choose another path, or remove the link if it is not meant to be "
               "there.", path=path))
    return path.resolve()


def park_pointer(env, width, height):
    """Put the pointer in the bottom-right corner. A fresh display starts it
    at the centre, where it lights up whatever the app draws under it before
    any step runs, drawn pointer or not (DEMO-0103)."""
    xdotool(env, "mousemove", width - 1, height - 1)


def launch(a, command, width, height, base, displaylog, appout, sound):
    """Start the private display and the app on it, sent to `sound`'s sink.

    Returns (server, app, display, auth, env, wayland). server is Xvfb, or on
    --gpu the cage that holds Xwayland, and ends with end_server. wayland is
    cage's socket name on --gpu, which only the recorder uses, and None on
    Xvfb. Both backends start the app afterwards, so the pointer is parked
    before the app first sees it. Nothing is left running if the app cannot
    be started, the sink included.
    """
    if a.gpu:
        server, display, auth, wayland = start_gpu_display(width, height, base,
                                                           displaylog)
    else:
        server, display, auth = start_xvfb(width, height, base, displaylog)
        wayland = None
    env = dict(os.environ, DISPLAY=display, WAYLAND_DISPLAY=NO_WAYLAND,
               XAUTHORITY=str(auth), **(sound.env() if sound else {}))
    park_pointer(env, width, height)
    try:
        app = subprocess.Popen(command, env=env, start_new_session=True,
                               stdout=appout, stderr=subprocess.STDOUT)
    except (FileNotFoundError, PermissionError) as exc:
        if sound:
            sound.unload()
        end_server(server)
        auth.unlink(missing_ok=True)
        die(tr("could not run {command}: {reason}.\n"
               "  Check that the command after `--` is installed and spelled as you "
               "would type it.", command=repr(command[0]), reason=exc.strerror))
    return server, app, display, auth, env, wayland


def end_server(server):
    """End the display. Both servers run in a session of their own, and the
    group goes, so on --gpu Xwayland goes with cage."""
    if server is None or server.poll() is not None:
        return
    if _display_gone.is_set():  # a hung server may not act on SIGTERM
        with contextlib.suppress(ProcessLookupError, PermissionError):
            os.killpg(os.getpgid(server.pid), signal.SIGKILL)
        server.wait()
        return
    end_process(server, group=True)


def place_window(env, app, a, width, height, picture):
    """Find the app's window and make it fill the frame; None if none appeared.
    `picture` is True for a shot, False for a recording."""
    window = wait_for_window(env, app, a.startup_timeout)
    if window is None and picture:
        note(tr("no window appeared within {seconds}s; taking the picture anyway.\n"
                "  If the app is slow to start, give it longer with --startup-timeout.",
                seconds=a.startup_timeout))
    elif window is None:
        note(tr("no window appeared within {seconds}s; recording anyway.\n"
                "  If the app is slow to start, give it longer with --startup-timeout.",
                seconds=a.startup_timeout))
    else:
        fill_frame(env, window, width, height)
    return window


def fill_frame(env, window, width, height):
    """Move the window to the corner and size it to the frame."""
    # No window manager runs here, so no windowactivate: the only
    # window already has focus.
    xdotool(env, "windowmove", window, 0, 0)
    xdotool(env, "windowsize", window, width, height)
    wait_for_size(env, window, width * height)


def blank_causes(gpu):
    """What usually made the display blank, for the backend that ran. On
    --gpu the first Xvfb cause cannot apply, and telling that run to use
    --gpu was advice to do what it had just done (DEMO-0110)."""
    first = (tr("It had not drawn yet. A GPU app can spend seconds on a black\n"
                "    screen while it starts: --settle waits for the first picture.")
             if gpu else
             tr("It needs the GPU, and Xvfb has none. An OpenGL or Vulkan app\n"
                "    cannot render on it at all: record it with --gpu instead."))
    return ("  " + tr("The app ran but drew nothing here. Two causes account for most "
                      "of it:")
            + "\n  - " + first
            + "\n  - " + tr("It rendered somewhere else. A Flatpak needs "
                            "--nosocket=wayland on\n    its command line; see README.md."))


class Checks:
    """What the display samples found during a run, read after teardown.

    blank: when the display was found blank, "halfway" or "at the end".
    unsampled: why a sample could not be taken, which fails the run too.
    sampled: when each display sample was taken, as (when, seconds into the
    video). record --gpu asks the finished file the same question at the same
    moments, so the skips that decided whether a sample was taken carry over.
    None means the end of the video.
    moved: how the window stopped filling the frame, said once.
    put_back: whether the window was sized to the frame again mid-run.
    """

    def __init__(self):
        self.blank = None
        self.unsampled = None
        self.sampled = []
        self.moved = None
        self.put_back = False

    def failed(self):
        return self.blank is not None or self.unsampled is not None

    def sample(self, when, at, env, display, width, height):
        """Sample the display now, and record what was found."""
        self.sampled.append((when, at))
        try:
            if display_is_blank(env, display, width, height):
                self.blank = when
        except SampleError as exc:
            self.unsampled = str(exc)

    def look_at_window(self, env, window, width, height, at=None):
        """Warn once if the window no longer fills the frame. `at` is how far
        into the video this is, or None once recording has ended. While it is
        recording the size is put back, once (DEMO-0121): an app that takes
        its own size again is warned about, so a resize fight cannot loop."""
        if self.moved is not None or window is None:
            return
        moved = window_off_frame(env, window, width, height)
        if moved and at is not None and not self.put_back:
            self.put_back = True
            fill_frame(env, window, width, height)
            moved = window_off_frame(env, window, width, height)
            if moved is None:
                note(tr("the app resized its window {seconds}s into the video, "
                        "and demoreel put it back to fill the {frame} frame.\n"
                        "  The video before then may be cropped or have an "
                        "empty band.", seconds=f"{at:.1f}",
                        frame=f"{width}x{height}"))
                return
        self.moved = moved
        if moved:
            note(moved)


def settle(a, env, display, width, height):
    """--settle: wait for the app's first picture before recording."""
    try:
        drawn = not a.settle or wait_until_drawn(env, display, width,
                                                 height, a.settle)
    except SampleError as exc:
        die(tr("--settle could not sample the display, so it cannot tell "
               "when the app has drawn.") + f"\n  {exc}")
    if not drawn:
        note(tr("nothing was drawn within {seconds}s; recording anyway.\n"
                "  If the app takes longer to show its first picture, raise --settle.",
                seconds=a.settle))


def start_recorder(a, env, display, wayland, width, height, output, logpath,
                   sound):
    """The recorder, its log, and how long ago its first frame was taken."""
    monitor = f"{sound.sink}.monitor" if a.audio else None
    if a.gpu:
        return (*start_wf_recorder(env, wayland, a.framerate, output, logpath,
                                   monitor), 0.0)
    return start_ffmpeg(env, display, width, height, a.framerate, output,
                        logpath, a.cursor, monitor)


def run_countdown(a, env, app, window, display, recorder, width, height,
                  logpath, started, checks):
    """Play the scripted actions, then record until the run should end.

    It ends at the -d deadline, on a stop request, when the recorder or the
    app goes away, or when the halfway sample finds the display blank.
    """
    for action in a.action:
        if _stop.is_set():
            break
        run_action(action, env)

    # Counted from when the steps finish, or with no steps from the first
    # frame, which `started` is (DEMO-0169).
    begin = time.monotonic() if a.action else started
    deadline = begin + a.duration if a.duration else None
    # A second look, halfway through the countdown (DEMO-0008). The end
    # sample alone passes an app that draws only in the final moments,
    # which is a video mostly empty. Blank at halfway means at least half
    # of the countdown is empty, and the run fails there rather than
    # recording the rest. A -d 0 run has no halfway point.
    halfway = deadline - a.duration / 2 if deadline else None
    try:
        while not _stop.is_set():
            now = time.monotonic()
            if deadline and now >= deadline:
                break
            if halfway and now >= halfway:
                halfway = None
                if app.poll() is None:
                    checks.look_at_window(env, window, width, height,
                                          now - started)
                    checks.sample("halfway", now - started, env, display,
                                  width, height)
                    if checks.failed():
                        break
            if recorder.poll() is not None:
                note(tr("the recorder stopped early; see {log}", log=logpath))
                break
            if deadline:
                progress(tr("recording, {seconds}s left",
                            seconds=math.ceil(deadline - now)))
            else:
                seconds = int(now - started)
                # translators: {time} is the time recorded so far, minutes:seconds, such as 1:05.
                progress(tr("recording for {time} (Ctrl+C to finish)",
                            time=f"{seconds // 60}:{seconds % 60:02d}"))
            if app.poll() is not None:
                note(tr("the app closed; ending the recording."))
                break
            # Never wait past the deadline: a fixed interval here added up to
            # its own length to every video. A stop ends the wait at once.
            _stop.wait(0.2 if deadline is None
                       else max(0.0, min(0.2, deadline - time.monotonic())))
    finally:
        progress(None)  # the line goes before anything else is said


def check_at_end(env, app, window, display, width, height, checks):
    """The end-of-run look, taken after the recorder stops.

    Stop recording before sampling. The display does not change when the
    recorder stops, and sampling first put a third of a second of overshoot
    into every video (DEMO-0012). Only meaningful while the app is still up:
    one that closed itself mid-run leaves an empty display behind, and that
    video is fine.
    """
    if app.poll() is not None:
        return
    checks.look_at_window(env, window, width, height)
    if not checks.failed():
        checks.sample("at the end", None, env, display, width, height)


def vouch_for(a, output, logpath, width, height, checks):
    """Fail the run unless the finished video is one it can stand behind."""
    if not output.exists() or output.stat().st_size == 0:
        die(tr("no video was written to {output}: the recorder produced nothing."
               "\n  Its log, {log}, says why.", output=output, log=logpath))
    unreadable = video_error(output)
    if unreadable:
        die(tr("the video cannot be played: {output}", output=output)
            + f"\n  {unreadable}\n  "
            + tr("The recorder most likely stopped before it finished the file. "
                 "See {log}", log=logpath))
    if checks.blank == "halfway":
        die(tr("the virtual display was blank halfway, so at least half of it is a "
               "flat colour: {output}", output=output) + "\n" + blank_causes(a.gpu))
    if checks.blank:
        die(tr("the virtual display was blank at the end, so it ends on a flat "
               "colour: {output}", output=output) + "\n" + blank_causes(a.gpu))
    if checks.unsampled is not None:
        die(tr("could not sample the virtual display to check {output} is not blank,\n"
               "  so this run cannot vouch for it.", output=output)
            + f"\n  {checks.unsampled}")
    if a.gpu:
        for when, at in checks.sampled:
            try:
                flat = video_is_blank(output, at, width, height)
            except SampleError as exc:
                die(tr("could not read {output} back to check it is not blank,\n"
                       "  so this run cannot vouch for it.", output=output)
                    + f"\n  {exc}")
            if flat and when == "halfway":
                die(tr("the video is a flat colour halfway, though the private "
                       "screen was not: {output}\n  The recorder captured "
                       "something other than the screen. See {log}",
                       output=output, log=logpath))
            if flat:
                die(tr("the video is a flat colour at the end, though the private "
                       "screen was not: {output}\n  The recorder captured "
                       "something other than the screen. See {log}",
                       output=output, log=logpath))
        share = changed_share(output, a.framerate)
        if share is not None and share < CHANGED_NOTE_BELOW:
            # translators: {share} is a percentage, such as 48%; {output} is the video's path.
            note(tr("only {share} of the frames in the middle of {output} "
                    "changed from the one before.\n  If the app was moving the "
                    "whole time, it drew that few new frames itself: the video "
                    "has every frame it drew.", share=f"{share:.0%}", output=output))


def video_error(output):
    """Why the finished video cannot be read back, or None if it can.

    A file that is there and not empty is not yet a video: a recorder killed
    mid-run leaves an mp4 with no index, and the run printed its path and
    exited 0 (DEMO-0116).
    """
    try:
        probe = subprocess.run(["ffprobe", "-v", "error", str(output)],
                               capture_output=True, text=True,
                               timeout=CALL_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        return tr("reading it back took over {seconds}s.", seconds=CALL_TIMEOUT)
    if probe.returncode == 0:
        return None
    lines = probe.stderr.strip().splitlines()
    return lines[-1] if lines else tr("ffprobe could not read it.")


def summarise(output):
    """On a terminal, the video's length and size once it is done."""
    if not sys.stderr.isatty():
        return
    try:
        seconds = float(subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(output)], capture_output=True, text=True,
            timeout=CALL_TIMEOUT, check=True).stdout)
    except (subprocess.SubprocessError, ValueError):
        return  # the video was already vouched for; this is only a courtesy
    size = output.stat().st_size
    note(tr("{seconds}s of video, {size}", seconds=f"{seconds:.1f}",
            size=f"{size / 1e6:.1f} MB" if size >= 1e6 else f"{size / 1e3:.0f} kB"))


def cmd_record(a):
    command, width, height, output, applog = prepare(a, ".mp4")

    # SIGHUP is a closed terminal: finish the video as for Ctrl+C, rather
    # than dying where we stand and leaking the display (DEMO-0115).
    for sig in (signal.SIGUSR1, signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _request_stop)

    # The run is addressable from here, before anything slow happens, so a
    # `stop` issued straight after launching it finds it (DEMO-0034). Holding
    # the name makes any state file already there a dead run's, so it is
    # simply replaced. "recording" flips to true once ffmpeg has its first
    # frame; `stop` waits for that rather than ending a run with no video.
    # "result" is written as "ok" just before the path is printed, and the
    # file is left in place so `stop` can read it after this process has gone
    # (DEMO-0047). A run that fails never writes it.
    claim_name(a.name)
    statefile = state_dir() / f"{a.name}.json"
    state = {"name": a.name, "pid": os.getpid(),
             "starttime": proc_starttime(os.getpid()),
             "output": str(output), "recording": False}

    logpath = state_dir() / f"{a.name}.ffmpeg.log"
    displaylog = state_dir() / f"{a.name}.display.log"
    # The app's own output goes to our stderr, or to --app-log, but never to
    # our stdout: this command prints the finished path and nothing else, and a
    # caller writing `out=$(demoreel record ...)` must not collect the app's
    # chatter along with it. Worth keeping somewhere when the app says whether
    # what it drew was the real thing — a wrong-but-not-blank recording passes
    # every check this tool can make.
    # Deliberate: as above - closed in the finally block, not here.
    appout = open(applog, "wb") if applog else sys.stderr  # noqa: SIM115
    server = app = recorder = log = auth = sound = None
    checks = Checks()
    try:
        write_state(statefile, state)
        sound = private_sound(a.audio, a.name)
        server, app, display, auth, env, wayland = launch(
            a, command, width, height, state_dir() / a.name, displaylog, appout,
            sound)
        window = place_window(env, app, a, width, height, picture=False)
        settle(a, env, display, width, height)

        recorder, log, lag = start_recorder(a, env, display, wayland, width,
                                            height, output, logpath, sound)
        started = time.monotonic() - lag
        write_state(statefile, dict(state, display=display, recording=True))
        note(tr("recording {display} to {output} (until stopped)",
                display=display, output=output) if a.duration == 0 else
             tr("recording {display} to {output} ({seconds}s)",
                display=display, output=output, seconds=a.duration))

        run_countdown(a, env, app, window, display, recorder, width, height,
                      logpath, started, checks)
        stop_recorder(recorder)
        check_at_end(env, app, window, display, width, height, checks)
    finally:
        # Order matters: finish the video before the app and display go away,
        # or the last frames catch a half-dead app.
        if recorder is not None:
            stop_recorder(recorder)
        if log is not None:
            log.close()
        if appout is not sys.stderr:
            appout.close()
        end_process(app, group=True)
        if sound is not None:
            sound.unload()
        end_server(server)
        if auth is not None:
            auth.unlink(missing_ok=True)
        if a.gpu:
            finish_gpu_video(output, logpath)
        elif a.audio:
            finish_audio_video(output, logpath)

    vouch_for(a, output, logpath, width, height, checks)
    if a.audio:
        level = loudest(output)
        if level is not None and level <= SILENT_DB:
            note(tr("the sound track is silent: the app made no sound that reached "
                    "demoreel."))
    summarise(output)
    for stale in (logpath, displaylog):
        stale.unlink(missing_ok=True)  # only worth keeping when something failed
    write_state(statefile, dict(state, result="ok"))
    print(output)


def take_picture(env, display, width, height, cursor, output, gpu):
    """Save one PNG of the display and check it; the reason it failed, or None.

    The check reads the saved file back rather than grabbing a second frame, so
    the picture judged is the picture handed over. The test is frame_is_flat,
    the same one that judges a recording.
    """
    grab = subprocess.run(  # noqa: PLW1510 - a failed grab is handled below
        ["ffmpeg", "-hide_banner", "-loglevel", "error",
         "-f", "x11grab", "-draw_mouse", "1" if cursor else "0",
         "-video_size", f"{width}x{height}", "-i", f"{display}.0",
         "-frames:v", "1", "-y", str(output)],
        env=env, capture_output=True, timeout=CALL_TIMEOUT)
    if grab.returncode != 0 or not output.exists():
        tail = grab.stderr.decode(errors="replace").strip().splitlines()[-3:]
        return tr("could not take the picture.") + "\n  " + "\n  ".join(tail)
    gray = subprocess.run(  # noqa: PLW1510 - a failed read is handled below
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", str(output),
         "-pix_fmt", "gray", "-f", "rawvideo", "-"],
        capture_output=True, timeout=CALL_TIMEOUT)
    if gray.returncode != 0 or len(gray.stdout) != width * height:
        return tr("could not read back {output} to check it is not blank.", output=output)
    if frame_is_flat(gray.stdout):
        return (tr("the picture is one flat colour: {output}", output=output) + "\n"
                + blank_causes(gpu))
    return None


def cmd_shot(a):
    """One picture of the app, on the same private display `record` uses.

    No name and no state file: there is nothing to stop, so a shot keeps its
    files in a folder of its own and `stop` never sees it. The folder goes when
    the shot succeeds and is kept, and named, when it fails.
    """
    command, width, height, output, applog = prepare(a, ".png")
    rundir = Path(tempfile.mkdtemp(prefix="shot-", dir=state_dir()))
    displaylog = rundir / "display.log"
    # Deliberate: closed in the finally block, as in cmd_record.
    appout = open(applog, "wb") if applog else sys.stderr  # noqa: SIM115
    server = app = auth = sound = None
    try:
        sound = private_sound(False, "shot")
        server, app, display, auth, env, _ = launch(a, command, width, height,
                                                    rundir / "shot", displaylog,
                                                    appout, sound)
        window = place_window(env, app, a, width, height, picture=True)
        try:
            drawn = wait_until_drawn(env, display, width, height, a.settle)
        except SampleError as exc:
            die(tr("--settle could not sample the display, so it cannot tell "
                   "when the app has drawn.") + f"\n  {exc}")
        if not drawn:
            note(tr("nothing was drawn within {seconds}s; taking the picture "
                    "anyway.\n  If the app takes longer to show its first picture, "
                    "raise --settle.", seconds=a.settle))
        for action in a.action:
            run_action(action, env)
        if window is not None:
            moved = window_off_frame(env, window, width, height)
            if moved:
                note(moved)
        failed = take_picture(env, display, width, height, a.cursor, output,
                              a.gpu)
    except subprocess.TimeoutExpired:
        failed = tr("could not take the picture: the display did not answer "
                    "within {seconds}s.", seconds=CALL_TIMEOUT)
    except SystemExit as exc:
        # Every die() above lands here, so every failure names the folder it
        # keeps -- which is in RAM, under /run/user (DEMO-0107).
        raise SystemExit(f"{exc.code}\n  "
                         + tr("Its display log is kept in {folder}", folder=rundir)) from None
    finally:
        if appout is not sys.stderr:
            appout.close()
        end_process(app, group=True)
        if sound is not None:
            sound.unload()
        end_server(server)
        if auth is not None:
            auth.unlink(missing_ok=True)
    if failed:
        die(f"{failed}\n  " + tr("Its display log is kept in {folder}", folder=rundir))
    shutil.rmtree(rundir, ignore_errors=True)
    print(output)


def cmd_check(a):
    """Say whether this machine can record, on each backend (DEMO-0052).

    Everything goes to stderr, like every other message: stdout carries a
    finished path and nothing else, and a check has no path to print.
    """
    ready = True
    for gpu in (False, True):
        name = "--gpu" if gpu else tr("record and shot")
        missing = [t for t in dict.fromkeys(required_programs(gpu, True))
                   if shutil.which(t) is None]
        problems = [tr("missing {programs}", programs=", ".join(missing))
                    + install_hint(missing)] if missing else []
        if "ffmpeg" not in missing and not has_libx264():
            problems.append(tr("this ffmpeg has no libx264, which every recording "
                               "uses.") + x264_advice(distro_family()))
        failure = (start_failure("wf-recorder")
                   if gpu and "wf-recorder" not in missing else None)
        if failure:
            problems.append(tr("wf-recorder could not start recording.") + "\n  "
                            + tr("It said: {text}", text=failure))
        library = (linked_library("wf-recorder", "libavcodec.so")
                   if gpu and "wf-recorder" not in missing else None)
        if library and not has_encoder(library, "libx264"):
            problems.append(tr("wf-recorder loads {library}, which has no libx264, so "
                               "it cannot write the video.", library=library))
        if gpu and not list(Path("/dev/dri").glob("renderD*")):
            problems.append(tr("no graphics render node in /dev/dri, so there is "
                               "no GPU for it to use."))
        if not gpu and not missing:
            problems += display_problem()
        if problems:
            note(tr("{name}: NOT READY", name=name) + "\n  - " + "\n  - ".join(
                problem.replace("\n", "\n    ") for problem in problems))
            if not gpu:  # only the default backend decides the exit status
                ready = False
        else:
            note(tr("{name}: ready", name=name))
    # Like --gpu's, this line never changes the exit status (DEMO-0106 INV-8).
    problems = audio_problems()
    note(tr("{name}: NOT READY", name="--audio") + "\n  - " + "\n  - ".join(
        problem.replace("\n", "\n    ") for problem in problems) if problems
         else tr("{name}: ready", name="--audio"))
    # The finishing commands need no display, and nothing here changes the
    # exit status: that still says only whether the default backend records.
    videos, words = finishing_problems()
    for name, problem in ((tr("edit, trim, caption, join, card, motion and "
                              "poster"), videos),
                          (tr("text on a card or a caption"), words)):
        note(tr("{name}: NOT READY", name=name) + "\n  - "
             + problem.replace("\n", "\n    ") if problem
             else tr("{name}: ready", name=name))
    if not ready:
        sys.exit(1)


def audio_problems():
    """Why record --audio cannot run here; [] if it can. Sweeps leftover
    sinks on the way, as every run does."""
    if shutil.which("pactl") is None:
        return [tr("missing {programs}", programs="pactl") + install_hint(["pactl"])]
    problems = []
    if not has_pulse_input():
        problems.append(tr("--audio needs an ffmpeg that can read from a sound server, "
                           "and this one has no pulse input."))
    try:
        sweep_sinks()
    except SoundUnavailable as exc:
        problems.append(str(exc))
    return problems


def display_problem():
    """Start and end a private display, the way a run does; [] if that works."""
    base = Path(tempfile.mkdtemp(prefix="check-", dir=state_dir()))
    server = auth = None
    try:
        server, _, auth = start_xvfb(320, 240, base / "check", base / "display.log")
    except SystemExit as exc:
        reason = str(exc.code).removeprefix("demoreel: ")
        return [tr("a private display did not start: {reason}", reason=reason)]
    finally:
        end_server(server)
        if auth is not None:
            auth.unlink(missing_ok=True)
        shutil.rmtree(base, ignore_errors=True)
    return []


# How long `stop` looks for a run before saying there is none. A run registers
# itself before anything slow, but not before Python has started, so a stop
# launched on the very next line of a script can still arrive first -- measured
# on the second of ten back-to-back tries. A second is far more than that
# startup, and it is only ever spent when the answer is going to be "none".
STOP_GRACE = 1.0


def live_runs():
    """Every run whose state file names a process that is still that run.

    A dead run's file is left where it is. The next run of that name replaces
    it under the name lock, and removing it here could race that run and
    delete the file it has just written.
    """
    live = []
    for f in sorted(state_dir().glob("*.json")):
        try:
            entry = json.loads(f.read_text())
        except (OSError, ValueError):
            continue  # gone since the glob, or not ours to read
        if isinstance(entry, dict) and is_our_run(entry):
            live.append(entry)
    return live


def cmd_stop(a):
    def matching():
        return [e for e in live_runs() if not a.name or e.get("name") == a.name]
    live = poll(matching, STOP_GRACE, interval=0.05) or []

    if a.name:
        if not live:
            others = sorted(e["name"] for e in live_runs())
            die(tr("no recording named {name} is running.", name=repr(a.name))
                + ("\n  " + tr("Running now: {names}.", names=", ".join(others))
                   if others else ""))
    elif not live:
        die(tr("no recording is running, so there is nothing to stop."))
    elif len(live) > 1:
        die(trn("{count} recording is running: {names}.\n"
                "  Name the one to stop, e.g. {example}",
                "{count} recordings are running: {names}.\n"
                "  Name the one to stop, e.g. {example}", len(live),
                names=", ".join(sorted(e["name"] for e in live)),
                example=f"demoreel stop {min(e['name'] for e in live)}"))

    for found in live:
        entry = wait_until_recording(found)
        os.kill(entry["pid"], signal.SIGUSR1)
        if not run_succeeded(entry):
            die(tr("the recording failed after it was stopped, so there is no "
                   "video to hand back.\n  Its own error message says why."))
        print(entry["output"])


def run_succeeded(entry):
    """Wait for a stopped run to exit, then say whether it succeeded.

    A stopped run still has work to do: finish the video, then check the
    display was not blank. Printing its path before that handed the caller a
    half-written file, or a path for a run that went on to fail (DEMO-0047).
    The run writes "result": "ok" to its state file just before it prints its
    own path. Anything else -- a failure, a kill, the file already replaced by
    a later run of the same name -- is not a success.
    """
    pid = entry["pid"]
    # A zombie keeps its pid and start time until whatever started it reaps
    # it, which may be the same script that is waiting on this stop.
    poll(lambda: not is_our_run(entry) or proc_stat(pid, 3) == "Z", None)
    try:
        final = json.loads((state_dir() / f"{entry['name']}.json").read_text())
    except (OSError, ValueError):
        return False
    return (isinstance(final, dict) and final.get("pid") == pid
            and final.get("starttime") == entry.get("starttime")
            and final.get("result") == "ok")


def wait_until_recording(entry):
    """Hold a stop aimed at a run that is still starting, until it records.

    A run is addressable from its first moment, but stopping it before ffmpeg
    has a frame would leave no video at all -- and stop's one line of stdout
    is a video path. So wait, and stop it the moment it is recording. That
    gives a very short video rather than none (DEMO-0034).

    No timeout of its own: the run has its own startup timeouts, and it
    either starts recording or exits. A run that exits first is reported as
    such, since there is no path to print.
    """
    statefile = state_dir() / f"{entry['name']}.json"
    pid = entry["pid"]
    # A file written by 0.1.x has no "recording" key, and existed only once
    # that run was already recording.
    if entry.get("recording", True):
        return entry

    def recording():
        try:
            current = json.loads(statefile.read_text())
        except (OSError, ValueError):
            current = {}
        # Same pid, or a new run that took the name after this one died would
        # be stopped in its place.
        if (not isinstance(current, dict) or current.get("pid") != pid
                or not is_our_run(current)):
            die(tr("the recording ended before it started recording, so there "
                   "is no video to stop."))
        return current if current.get("recording", True) else None
    return poll(recording, None)


# Defaults of the finishing commands (README, Finishing a recording).
