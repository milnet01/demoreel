#!/usr/bin/env python3
"""demoreel — record a GUI app on a private virtual X display.

Only the app is in frame. The display it runs on has no desktop, no
notifications and no magnifier, so nothing of the user's real session can
end up in the video. README.md explains why that is the whole point.
"""

import argparse
import fcntl
import json
import os
import re
import secrets
import select
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

__version__ = "0.2.2"

SIZE_RE = re.compile(r"^(\d+)x(\d+)$")
DISPLAY_READY_TIMEOUT = 15.0

# The one definition of "nothing is on this display". Measured: an empty Xvfb
# is 0.99994, and a window as small as 200x100 on a 1280x800 display already
# drops to 0.98, so there is room on both sides. ci.sh imports this rather than
# restating it -- a threshold with two homes is one a person has to remember to
# move, and this project has already answered that question the same way twice
# (`ci.sh --ruff-version`, `ci.sh --docs-glob`).
BLANK_THRESHOLD = 0.999
# How long one xdotool call or one frame grab may take before the display is
# taken to have stopped answering (DEMO-0079). Each normally returns in a few
# milliseconds -- a grab costs about 112ms of CPU on a 1600x1000 display -- so
# this is a hang detector, not a performance budget. Typing is paced by xdotool
# at 12ms a key, so a `type` step gets TYPE_SECONDS_PER_CHAR more per character.
CALL_TIMEOUT = 10
TYPE_SECONDS_PER_CHAR = 0.05

# Both backends need this. Unset, wl_display_connect() falls back to the
# hardcoded $XDG_RUNTIME_DIR/wayland-0, which exists on a Wayland session — so
# the app connects to the user's REAL compositor, renders there, and the
# private display records black while every signal says success. A name that
# cannot resolve fails the connection instead, and the toolkit falls back to
# X11. It is the non-Flatpak twin of --nosocket=wayland, and unlike
# QT_QPA_PLATFORM=xcb it does not need to know the app's toolkit.
NO_WAYLAND = "demoreel-no-wayland"

_stop = False


def _request_stop(signum, frame):
    """SIGUSR1 (from `demoreel stop`), SIGINT or SIGTERM: finish the video now."""
    global _stop  # noqa: PLW0603 - a signal handler sets a flag; that is the idiom
    _stop = True


def die(msg):
    sys.exit(f"demoreel: {msg}")


def note(msg):
    print(f"demoreel: {msg}", file=sys.stderr)


def state_dir():
    base = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
    d = base / f"demoreel-{os.getuid()}"
    try:
        d.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        die(f"could not use {d}: {exc.strerror}.")
    # A desktop session sets XDG_RUNTIME_DIR, so the /tmp fallback is the
    # unusual path — which is also why it would go unnoticed. The name there is
    # predictable, so another user can create it first and exist_ok would adopt
    # it. lstat, not stat: a symlink planted at that name is followed by both
    # stat and chmod, so checking through it proves nothing.
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        die(f"{d} is not a directory you own, so demoreel will not use it.\n"
            "  On a shared machine another user can create that name first.\n"
            "  Remove it, or point XDG_RUNTIME_DIR at a directory you own.")
    d.chmod(0o700)
    return d


def alive(pid):
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError):
        return False
    return True


def proc_stat(pid, field):
    """One field of /proc/<pid>/stat, numbered as proc(5) numbers them.

    Field 2 is the command name in parentheses and may itself contain spaces
    and parentheses, so the fields are split after the LAST ')' rather than on
    the whole line. Only fields from 3 on can be asked for.
    """
    try:
        line = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    try:
        return line[line.rindex(")") + 1:].split()[field - 3]
    except (ValueError, IndexError):
        return None


def proc_starttime(pid):
    """The process's start time, field 22 of /proc/<pid>/stat.

    Unique per pid incarnation, which is what tells a recycled pid apart from
    the process we started.
    """
    return proc_stat(pid, 22)


def is_our_run(entry):
    """True when the process a state file names is still the run that wrote it.

    alive() alone asks only whether SOME process holds that pid. Every run's
    state file outlives it, left for `stop` to read the verdict from -- and
    Linux recycles pids.
    Acting on alive() alone sends SIGUSR1 to whatever inherited the number, and
    the default action for SIGUSR1 is to terminate.

    Comparing the start time recorded when the file was written closes that.
    A race remains in principle -- the process could exit between this check
    and the signal -- but that window is microseconds, against however long a
    stale file has been lying around.
    """
    pid = entry.get("pid")
    if not isinstance(pid, int) or not alive(pid):
        return False
    # A file written without a start time cannot be checked, and an entry that
    # cannot be checked is the one this exists to refuse.
    recorded = entry.get("starttime")
    return recorded is not None and proc_starttime(pid) == recorded


def write_state(statefile, entry):
    """Replace the state file in one step, so `stop` never reads half of it.

    It is written twice per run -- once at start, again when recording begins
    -- and a reader landing mid-write would see invalid JSON and skip the run.
    """
    tmp = statefile.with_suffix(".tmp")
    tmp.write_text(json.dumps(entry))
    os.replace(tmp, statefile)


def claim_name(name):
    """Hold the name for this run's whole life, or die if a live run holds it.

    The lock is what makes the duplicate check atomic (DEMO-0011). Checking the
    state file and writing it later left a gap that two runs started together
    both passed, and the later one's state file hid the earlier from `stop`.
    flock has no such gap, and the kernel drops it when the process dies, even
    to SIGKILL -- so a crashed run cannot hold its name hostage.

    The lock file is never removed. Unlinking it would let a later run lock a
    fresh inode while an earlier one still holds the old, which is two owners.
    Returns the open descriptor, which must stay open until the run ends.
    Children do not inherit it: Popen closes descriptors by default, and an
    app left running must not keep the name.
    """
    fd = os.open(state_dir() / f"{name}.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        try:
            pid = f" (pid {json.loads((state_dir() / f'{name}.json').read_text())['pid']})"
        except (OSError, ValueError, KeyError, TypeError):
            pid = ""
        die(f"a recording named {name!r} is already running{pid}.\n"
            f"  Use --name to tell this run apart from it.")
    return fd


def start_xvfb(width, height, base, logfile):
    """Start Xvfb on a display number it picks itself, behind an auth cookie.

    -displayfd is why two sessions can record at once: the server finds a free
    number and reports it back, so there is no window between "looks free" and
    "is ours" for a second run to lose.

    The cookie is why another local process cannot watch the recording. Measured
    on this machine: without one, a client with no credential at all reads the
    geometry and grabs a frame of whatever is on the display. Socket permissions
    are no answer — Xvfb also listens on an abstract socket, which has none.

    The number has to come first and the cookie is keyed to it, so the order is:
    start with an empty auth file, learn the number, write the cookie for it,
    and SIGHUP the server to re-read. Until that reset the display is open, and
    nothing has been drawn on it yet — the app is launched afterwards.

    The server's stderr goes to a file, never to a pipe. It writes there for
    the whole run — every keymap an app loads adds xkbcomp's warnings — and a
    pipe nobody drains fills, then blocks the server mid-write. The display
    freezes, and so does every X call waiting on it: GIMP did this in the gate.
    """
    auth = Path(f"{base}.Xvfb.Xauthority")
    auth.unlink(missing_ok=True)
    auth.touch(mode=0o600)

    read_fd, write_fd = os.pipe()
    os.set_inheritable(write_fd, True)
    with open(logfile, "wb") as log:
        proc = subprocess.Popen(
            ["Xvfb", "-displayfd", str(write_fd), "-screen", "0",
             f"{width}x{height}x24", "-nolisten", "tcp", "-auth", str(auth),
             # Without it the server resets whenever its last client leaves,
             # which puts the pointer back at the centre the moment the
             # xdotool that parked it exits (DEMO-0103). SIGHUP still resets
             # it, which is how the cookie gets read.
             "-noreset"],
            pass_fds=(write_fd,),
            stdout=subprocess.DEVNULL,
            stderr=log,
        )
    os.close(write_fd)

    buf = b""
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while b"\n" not in buf:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        if not select.select([read_fd], [], [], remaining)[0]:
            continue
        chunk = os.read(read_fd, 64)
        if not chunk:
            break
        buf += chunk
    os.close(read_fd)

    number = buf.decode(errors="replace").strip()
    if not number.isdigit():
        proc.kill()
        auth.unlink(missing_ok=True)
        proc.wait()
        stderr = Path(logfile).read_text(errors="replace").strip()
        die("Xvfb did not start." + (f"\n  {stderr}" if stderr else ""))

    display = f":{number}"
    cookie = secrets.token_hex(16)
    added = subprocess.run(["xauth", "-f", str(auth), "add",
                            display, "MIT-MAGIC-COOKIE-1", cookie],
                           capture_output=True, text=True, check=False)
    if added.returncode != 0:
        proc.kill()
        auth.unlink(missing_ok=True)
        die("could not write the display's auth cookie."
            + (f"\n  {added.stderr.strip()}" if added.stderr.strip() else ""))
    proc.send_signal(signal.SIGHUP)  # the server re-reads its auth file on reset

    # Do not report success until the cookie is actually in force: a client
    # connecting before the reset lands would work by having no protection.
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    env = dict(os.environ, DISPLAY=display, XAUTHORITY=str(auth))
    while time.monotonic() < deadline:
        if xdotool(env, "getdisplaygeometry").returncode == 0:
            return proc, display, auth
        time.sleep(0.1)
    proc.kill()
    auth.unlink(missing_ok=True)
    die("the display did not come back after its auth cookie was installed.")
    return None  # unreachable; die() exits


def start_gpu_display(width, height, base, logfile):
    """Start a GPU-capable private display: (cage, display, auth, wayland).

    Xvfb is a software X server with no DRI, so an OpenGL or Vulkan app cannot
    render on it at all — it is not slow there, it is absent. A rootful
    Xwayland on a headless `cage` compositor reaches the GPU. Same privacy
    property: cage shows one client and nothing else, and it is a separate
    compositor from the user's session.

    The order is fixed. cage's headless output starts at 1280x720, and an
    Xwayland already running keeps its first size however the output is
    resized later, so cage's one child resizes the output and only then
    becomes Xwayland (DEMO-0111). `xwfb-run` starts the two as one step, with
    no place for the resize, which is why it is not used.

    Nothing is guessed: cage picks its socket name and Xwayland its display
    number, and both come back on one pipe, in that order. -noreset keeps the
    pointer where park_pointer puts it, as on Xvfb (DEMO-0103).

    The cookie goes in after -displayfd reports the number, as on Xvfb, and
    Xwayland re-reads the changed file without being signalled. So the lock is
    proven by a client without the cookie being refused while one holding it
    connects: before the cookie both get in, and a dead display refuses both.
    """
    auth = Path(f"{base}.Xauthority")
    auth.unlink(missing_ok=True)
    auth.touch(mode=0o600)

    read_fd, write_fd = os.pipe()
    os.set_inheritable(write_fd, True)
    inner = (f'printf "%s\\n" "$WAYLAND_DISPLAY" >&{write_fd} && '
             f"wlr-randr --output HEADLESS-1 --custom-mode {width}x{height} && "
             f"exec Xwayland -displayfd {write_fd} -auth {shlex.quote(str(auth))} "
             f"-geometry {width}x{height} -fullscreen -noreset -nolisten tcp")
    with open(logfile, "wb") as log:
        # Its own session, so ending it takes Xwayland with it. The log is a
        # file for the reason start_xvfb gives: a pipe nobody drains blocks.
        proc = subprocess.Popen(
            ["cage", "--", "sh", "-c", inner],
            env=dict(os.environ, WLR_BACKENDS="headless"),
            pass_fds=(write_fd,), stdout=subprocess.DEVNULL, stderr=log,
            start_new_session=True)
    os.close(write_fd)

    buf = b""
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while buf.count(b"\n") < 2:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        if not select.select([read_fd], [], [], remaining)[0]:
            continue
        chunk = os.read(read_fd, 64)
        if not chunk:
            break
        buf += chunk
    os.close(read_fd)

    lines = buf.decode(errors="replace").split("\n")
    wayland = lines[0].strip()
    number = lines[1].strip() if len(lines) > 1 else ""
    if not wayland or not number.isdigit():
        end_process(proc, group=True)
        auth.unlink(missing_ok=True)
        tail = "\n  ".join(Path(logfile).read_text(errors="replace")
                           .strip().splitlines()[-3:])
        die("the GPU display did not start." + (f"\n  {tail}" if tail else ""))

    display = f":{number}"
    added = subprocess.run(["xauth", "-f", str(auth), "add", display,
                            "MIT-MAGIC-COOKIE-1", secrets.token_hex(16)],
                           capture_output=True, text=True, check=False)
    if added.returncode != 0:
        end_process(proc, group=True)
        auth.unlink(missing_ok=True)
        die("could not write the display's auth cookie."
            + (f"\n  {added.stderr.strip()}" if added.stderr.strip() else ""))

    locked = dict(os.environ, DISPLAY=display, XAUTHORITY=str(auth))
    stranger = dict(os.environ, DISPLAY=display, XAUTHORITY=os.devnull)
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while time.monotonic() < deadline:
        if (xdotool(stranger, "getdisplaygeometry").returncode != 0
                and xdotool(locked, "getdisplaygeometry").returncode == 0):
            return proc, display, auth, wayland
        time.sleep(0.1)
    end_process(proc, group=True)
    auth.unlink(missing_ok=True)
    die("the GPU display did not lock: a client without its auth cookie "
        "could still connect, or none could.")
    return None  # unreachable; die() exits


def xdotool(env, *args, check=False, stdin_text=None):
    """stdin_text feeds `type --file -`, which is how text stays out of the
    process list; every other call leaves stdin alone.

    Every call is bounded (DEMO-0079). A display that stops answering used to
    hang the run for good, because the startup deadline is checked between
    calls and nothing bounded one call.
    """
    timeout = CALL_TIMEOUT + TYPE_SECONDS_PER_CHAR * len(stdin_text or "")
    try:
        return subprocess.run(["xdotool", *[str(a) for a in args]], env=env,
                              input=stdin_text, capture_output=True, text=True,
                              check=check, timeout=timeout)
    except subprocess.TimeoutExpired:
        die(f"the private display {env.get('DISPLAY')} stopped answering: "
            f"`xdotool {args[0]}` did not return within {timeout:g}s.")


def window_geometry(env, wid):
    """(x, y, width, height), or None if the window vanished before the query."""
    out = xdotool(env, "getwindowgeometry", "--shell", wid).stdout
    dims = dict(line.split("=", 1) for line in out.split() if "=" in line)
    try:
        return tuple(int(dims[k]) for k in ("X", "Y", "WIDTH", "HEIGHT"))
    except (KeyError, ValueError):
        return None


def window_area(env, wid):
    geometry = window_geometry(env, wid)
    return geometry[2] * geometry[3] if geometry else 0


def window_off_frame(env, window, width, height):
    """Say how the window no longer fills the frame, or return None if it does.

    demoreel sizes the window once, before recording. An app that then sets
    its own size records cropped or off to one side, and the picture is not
    flat, so the blank check passes it (DEMO-0099). This is checked beside
    each blank sample, and it warns rather than fails: a window that moved is
    still a video of the app.
    """
    geometry = window_geometry(env, window)
    if geometry is None or geometry == (0, 0, width, height):
        return None
    x, y, w, h = geometry
    return (f"the app resized its window to {w}x{h} at {x},{y}, so it no longer "
            f"fills the {width}x{height} frame and part of the video is cropped "
            f"or empty.\n  Record at the app's own size with -s {w}x{h}.")


# A --gpu video whose frames changed less often than this is noted. Measured
# with changed_share on 2026-09-26: Vestige's fly-through 48%, vkcube 96%
# (DEMO-0109).
CHANGED_NOTE_BELOW = 0.7
CHANGED_WINDOW = 10


def changed_share(output, framerate):
    """The share of frames that differ from the one before, over a window from
    the middle of the video; None if it could not be measured.

    On --gpu a moving app that draws few frames records as runs of repeated
    ones, and nothing else notices. It was written when the X side's stale
    picture caused exactly that (DEMO-0109); record --gpu now captures the
    compositor's, so what is left is the app's own rate. A still app repeats
    frames too, which is why this only ever produces a note. One window, not the
    whole video: decoding a long recording to count would add most of its
    length.
    """
    try:
        probe = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "csv=p=0", str(output)],
            capture_output=True, text=True, timeout=CALL_TIMEOUT, check=True)
        duration = float(probe.stdout.strip())
        window = min(CHANGED_WINDOW, duration)
        count = subprocess.run(
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
             "-ss", f"{(duration - window) / 2:.3f}", "-t", f"{window:.3f}",
             # Any 8x8 block changing by more than 256 counts the frame as
             # new. The defaults count near-repeats as repeats, which scored
             # a smooth test pattern 50%; at 256 it scores 100%, a 3 fps
             # pattern stored at 30 scores 12%, and a still one 0%.
             "-i", str(output), "-vf", "mpdecimate=hi=256:lo=256:frac=0",
             "-f", "null", "-",
             "-progress", "pipe:1", "-nostats"],
            capture_output=True, text=True, timeout=6 * CALL_TIMEOUT, check=True)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    kept = [ln for ln in count.stdout.splitlines() if ln.startswith("frame=")]
    frames = window * framerate
    if not kept or frames < framerate:
        return None
    return min(1.0, int(kept[-1].split("=", 1)[1]) / frames)


def named_windows(env):
    """The visible windows that carry a title, under either title property.

    `search --name .` reads only the old WM_NAME, and some apps set nothing but
    _NET_WM_NAME -- vkcube among them, so its window was never found and every
    run waited out the whole startup timeout (DEMO-0043). getwindowname reads
    both. The unfiltered list is no substitute: it also holds a nameless
    window the size of the display, which is not the app and would win on
    size. Two xdotool spawns per window, at about 2ms each, measured.
    """
    ids = xdotool(env, "search", "--onlyvisible", "").stdout.split()
    return [wid for wid in ids if xdotool(env, "getwindowname", wid).stdout.strip()]


def wait_for_window(env, app, timeout):
    """Return the id of the app's main window, or None if it never showed one.

    Biggest window wins. An app that opens a modal dialog at startup has two,
    and picking by search order gets the dialog about as often as not — which
    then gets stretched to fill the frame while the real window is left alone
    behind it. Size is the one signal that separates them without knowing
    anything about the app.
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        ids = named_windows(env)
        if ids:
            return max(ids, key=lambda wid: window_area(env, wid))
        if app.poll() is not None:
            if app.returncode == 0:
                # The first line is what happened; the rest is a guess, and is
                # written as one. The hand-over is the common case here, but a
                # command that legitimately does its work and exits looks
                # identical from the outside, and so does one that failed for
                # its own reasons and still returned 0.
                die("the app exited immediately (status 0) without opening a window.\n"
                    "  The likely cause is a single-instance app: it finds a copy already\n"
                    "  running on your real desktop, hands the request over to it and exits\n"
                    "  successfully. If a copy is running, close it and try again.\n"
                    "  If not, the command may simply have finished without needing a\n"
                    "  window — in which case there is nothing to record.")
            die(f"the app exited with status {app.returncode} before opening a window.")
        # About 2ms of CPU per xdotool spawn, measured, so a tight poll costs
        # nothing and a loose one costs up to its whole interval in wall time.
        time.sleep(0.05)
    return None


def wait_for_size(env, window, area, timeout=2.0):
    """Wait until a resize has landed, rather than sleeping a guessed interval.

    No window manager runs here, so the request is applied directly and this
    normally returns on the first check. The timeout is only for an app that
    refuses the size; recording goes ahead either way, as it always has.
    """
    deadline = time.monotonic() + timeout
    while window_area(env, window) != area and time.monotonic() < deadline:
        time.sleep(0.05)


def run_action(spec, env):
    """One scripted step: wait / click / move / type / key."""
    # `type` takes the rest of the step exactly, after the verb and one space:
    # it is text to type, not arguments. Splitting it like a shell command
    # dropped its quotes, collapsed its spaces and died on an apostrophe
    # (DEMO-0101). The other verbs take short arguments, and keep the split.
    head, text = re.match(r"(\S*)\s?(.*)\Z", spec.lstrip(), re.DOTALL).groups()
    if head == "type":
        parts = [head]
    else:
        try:
            parts = shlex.split(spec)
        except ValueError as e:
            die(f"cannot read the step {spec!r}: {e}.")
    if not parts:
        return
    verb, args = parts[0], parts[1:]
    if verb == "wait":
        time.sleep(float(args[0]))
    elif verb == "move":
        xdotool(env, "mousemove", "--sync", args[0], args[1])
    elif verb == "click":
        if len(args) >= 2:
            xdotool(env, "mousemove", "--sync", args[0], args[1])
        xdotool(env, "click", "1")
    elif verb == "type":
        # --file - takes the text on stdin. As an argument it sits in the
        # process list, readable by any other local user, for as long as the
        # typing lasts — and at 60ms a keystroke that is seconds. A demo that
        # types into a login form is the obvious thing to script.
        xdotool(env, "type", "--delay", "60", "--file", "-",
                stdin_text=text)
    elif verb == "key":
        xdotool(env, "key", *args)
    else:
        die(f"unknown action {verb!r}. Use: wait, move, click, type, key.")


def start_ffmpeg(env, display, width, height, framerate, output, logfile, cursor):
    """Record the display. env matters: the GPU backend's Xwayland wants an
    auth cookie, and ffmpeg is as much a client of that display as xdotool."""
    cmd = [
        "ffmpeg", "-hide_banner", "-loglevel", "warning",
        "-progress", "pipe:1", "-stats_period", "0.05",
        "-f", "x11grab", "-framerate", str(framerate),
        "-draw_mouse", "1" if cursor else "0",
        "-video_size", f"{width}x{height}", "-i", f"{display}.0",
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "23",
        "-pix_fmt", "yuv420p", "-movflags", "+faststart",
        "-y", str(output),
    ]
    # Deliberate: the handle is owned by the ffmpeg process and closed in
    # record()'s finally block, so it must outlive this statement.
    log = open(logfile, "wb")  # noqa: SIM115
    proc = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=log)
    # Return when ffmpeg is actually capturing, not after a guessed interval.
    # The first progress report is that signal: it arrives once the input is
    # open and frames are flowing. The duration is counted from here, so a
    # blind sleep in its place was recorded into every video (DEMO-0012).
    # The frame count in those reports is no use as the signal -- it counts
    # ENCODED frames and sits at 0 for most of a second while x264 fills its
    # look-ahead.
    ready = select.select([proc.stdout], [], [], DISPLAY_READY_TIMEOUT)[0]
    if not ready or not proc.stdout.readline():
        proc.kill()
        proc.wait()
        log.close()
        tail = Path(logfile).read_text(errors="replace").strip()
        die("ffmpeg could not start recording." + (f"\n  {tail}" if tail else ""))
    # Keep draining the reports, or ffmpeg blocks once the pipe fills.
    threading.Thread(target=proc.stdout.read, daemon=True).start()
    return proc, log


def partial_video(output):
    """Where record --gpu's recorder writes before finish_gpu_video: beside
    the output, on its disk, and not in the state directory, which is RAM."""
    return output.with_name(f".{output.stem}.demoreel-part.mp4")


def start_wf_recorder(env, wayland, framerate, output, logfile):
    """Record cage's own output, for record --gpu (DEMO-0111).

    Under a busy 3D app the X side's copy of the picture goes stale, so x11grab
    records a slideshow: 156 new frames of 588 where this got 643 of 643, over
    the same run (DEMO-0109). -D asks for every frame rather than only changed
    ones, without which SIGINT is also ignored while the screen is still, and
    -y stops it prompting before an overwrite. The encoder settings match
    start_ffmpeg's, so the two backends hand back the same kind of file.

    It prints no progress reports, so the start signal is the line announcing
    its output, printed once the encoder has its first frame. The countdown is
    counted from there, as start_ffmpeg's is from its first report (DEMO-0012).
    """
    part = partial_video(output)
    cmd = ["wf-recorder", "-D", "-y", "-r", str(framerate),
           "-c", "libx264", "-p", "preset=veryfast", "-p", "crf=23",
           "-x", "yuv420p", "-f", str(part)]
    # Deliberate: closed in record()'s finally block, as start_ffmpeg's is.
    log = open(logfile, "wb")  # noqa: SIM115
    # Unbuffered, or a readline that pulls in several lines leaves the rest in
    # Python's buffer, where select cannot see them: the start line sat there
    # unread until the deadline and the run failed, one run in three.
    proc = subprocess.Popen(cmd, env=dict(env, WAYLAND_DISPLAY=wayland),
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT, bufsize=0)
    deadline = time.monotonic() + DISPLAY_READY_TIMEOUT
    while True:
        remaining = deadline - time.monotonic()
        line = (proc.stdout.readline()
                if remaining > 0 and select.select([proc.stdout], [], [], remaining)[0]
                else b"")
        log.write(line)
        if line.startswith(b"Output #0"):
            break
        if not line:
            proc.kill()
            proc.wait()
            log.close()
            part.unlink(missing_ok=True)
            tail = Path(logfile).read_text(errors="replace").strip()
            die("wf-recorder could not start recording."
                + (f"\n  {tail}" if tail else ""))
    # Keep copying its output to the log, or it blocks once the pipe fills.
    threading.Thread(target=lambda: log.write(proc.stdout.read()),
                     daemon=True).start()
    return proc, log


def finish_gpu_video(output, logfile):
    """Give record --gpu's file the +faststart the Xvfb path's has.

    wf-recorder has no option for muxer flags, so a stream copy moves the index
    to the front. Nothing is re-encoded. The partial file is kept if the copy
    fails, and the message names it.
    """
    part = partial_video(output)
    if not part.exists():
        return
    copy = subprocess.run(  # noqa: PLW1510 - a failed copy is handled below
        ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
         "-i", str(part), "-c", "copy", "-movflags", "+faststart",
         "-y", str(output)],
        capture_output=True, timeout=6 * CALL_TIMEOUT)
    if copy.returncode != 0:
        with open(logfile, "ab") as log:
            log.write(copy.stderr)
        die(f"could not finish the video; the recording is kept in {part}. "
            f"See {logfile}")
    part.unlink()


class SampleError(Exception):
    """The display could not be sampled, so whether it is blank is unknown."""


def display_is_blank(env, display, width, height):
    """True if the display is one flat colour, i.e. nothing is drawn on it.

    Silently recording nothing is the worst failure this tool has: valid file,
    exit 0, black picture, every signal saying success. So grab one frame and
    measure how much of it is a single grey level. Measured here: an empty Xvfb
    is 0.99994, and a window as small as 200x100 on a 1280x800 display already
    drops it to 0.98 — so the threshold has room on both sides.

    Raises SampleError when no frame comes back. That is the third answer,
    "could not tell", and it must not collapse into either of the other two:
    reading it as "not blank" is how this guard used to pass everything the
    moment its own measurement broke (DEMO-0033). A grab that does not return
    in time is that answer too (DEMO-0079): the display stopped answering.
    """
    try:
        grab = subprocess.run(  # noqa: PLW1510 - a failed grab is handled below
            ["ffmpeg", "-hide_banner", "-loglevel", "error",
             "-f", "x11grab", "-video_size", f"{width}x{height}",
             "-i", f"{display}.0", "-frames:v", "1",
             "-pix_fmt", "gray", "-f", "rawvideo", "-"],
            env=env, capture_output=True, timeout=CALL_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise SampleError(f"the display did not give up a frame within "
                          f"{CALL_TIMEOUT}s; it has stopped answering") from None
    if grab.returncode != 0 or len(grab.stdout) != width * height:
        lines = [ln for ln in grab.stderr.decode(errors="replace").splitlines()
                 if ln.strip()]
        raise SampleError("\n  ".join(lines[-3:])
                          or f"ffmpeg exited {grab.returncode} with no frame")
    return frame_is_flat(grab.stdout)


def video_is_blank(output, at, width, height):
    """True if the finished video is one flat colour at `at` seconds in, or in
    its last half second when `at` is None.

    display_is_blank reads the X side, and on record --gpu the video comes from
    the compositor instead, so a recorder writing black under a drawn display
    would pass it. This asks the file the same question, at the moments the
    display was asked, with the same test. Raises SampleError, as that does.
    """
    seek = ["-sseof", "-0.5"] if at is None else ["-ss", f"{at:.3f}"]
    try:
        grab = subprocess.run(  # noqa: PLW1510 - a failed read is handled below
            ["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
             *seek, "-i", str(output), "-frames:v", "1",
             "-pix_fmt", "gray", "-f", "rawvideo", "-"],
            capture_output=True, timeout=CALL_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise SampleError(f"reading a frame of {output} took over "
                          f"{CALL_TIMEOUT}s") from None
    if grab.returncode != 0 or len(grab.stdout) != width * height:
        lines = [ln for ln in grab.stderr.decode(errors="replace").splitlines()
                 if ln.strip()]
        raise SampleError("\n  ".join(lines[-3:])
                          or f"no frame of {output} could be read")
    return frame_is_flat(grab.stdout)


def dominant_fraction(frame):
    """The share of a raw grey frame taken by its commonest byte value.

    One pass per distinct byte value, which looks worse than Counter's single
    pass and is not. Measured on a 1600x1000 frame: on a blank display, one
    distinct value, this form is about five times faster; on a busy screen with
    every value present it is about twice as slow. The case it wins is what
    wait_until_drawn polls against, and the case it loses is sampled once at the
    end of a run. Do not tidy it into Counter.most_common.
    """
    return max(frame.count(v) for v in set(frame)) / len(frame)


def frame_is_flat(frame):
    """True if the frame is one flat colour by BLANK_THRESHOLD's measure.

    The threshold AND its comparator live here together, because splitting them
    is what let a copy drift: a frame measuring exactly the threshold would pass
    one side and fail the other.
    """
    return dominant_fraction(frame) > BLANK_THRESHOLD


def wait_until_drawn(env, display, width, height, timeout):
    """Hold the recorder until the app has actually drawn something.

    A GPU app can spend seconds on a black screen while it builds acceleration
    structures, and recording that means the caller trims the head off
    afterwards — which is the post-production this tool deliberately does not
    do. Same uniform-frame test as the end-of-run check, used here as a gate
    rather than as an assertion.
    """
    # Back the poll off as the wait lengthens. Each sample spawns an ffmpeg and
    # moves a whole frame across a process boundary -- about 112ms of CPU on a
    # 1600x1000 display -- so a fixed quarter-second poll burns most of a core.
    # --settle exists for apps that spend seconds building GPU acceleration
    # structures, which means the sampler was competing for the machine with
    # the very work it was waiting for.
    #
    # Starting tighter than the old fixed interval and widening to a ceiling
    # answers a fast-drawing app sooner and a slow one far more cheaply. The
    # ceiling is what it costs: up to that long between the app drawing and the
    # recorder noticing. That is the right trade here, because the alternative
    # is taking CPU from the app to find out a second earlier.
    #
    # A smaller frame is NOT the lever, and was measured: decimating to a
    # hundredth of the data gives an all but identical answer and saves about
    # 10%, because the cost is the process spawn and the capture, not the data.
    interval, ceiling = 0.1, 1.0
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not display_is_blank(env, display, width, height):
            return True
        time.sleep(min(interval, max(0.0, deadline - time.monotonic())))
        interval = min(interval * 1.5, ceiling)
    return False


def stop_recorder(proc):
    """Ask the recorder to finish so the file gets its index written; a killed
    recorder leaves an mp4 that most players refuse to open. ffmpeg takes `q`
    on its stdin, wf-recorder takes SIGINT."""
    if proc.poll() is not None:
        return
    try:
        if proc.args[0] == "wf-recorder":
            proc.send_signal(signal.SIGINT)
        else:
            proc.stdin.write(b"q")
            proc.stdin.flush()
            proc.stdin.close()
    except OSError:
        proc.terminate()
    try:
        proc.wait(timeout=15)
    except subprocess.TimeoutExpired:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()


def end_process(proc, group=False):
    if proc is None or proc.poll() is not None:
        return
    try:
        if group:
            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        else:
            proc.terminate()
        proc.wait(timeout=5)
    except (subprocess.TimeoutExpired, ProcessLookupError, PermissionError):
        try:
            if group:
                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            else:
                proc.kill()
        except (ProcessLookupError, PermissionError):
            pass


FLATPAK_FLAGS = ("--socket=x11", "--nosocket=wayland", "--filesystem=/tmp/.X11-unix")


def warn_if_flatpak_underflagged(command):
    """Say up front when a Flatpak target is missing the flags it needs.

    Without them the app renders on the user's real compositor, the virtual
    display stays empty, and the run fails the blank check with a message
    listing two possible causes. We can tell which one it is before spending
    the recording on it.

    A warning, not an error: a manifest with no wayland socket does not need
    --nosocket=wayland, and refusing would break an invocation that works. This
    reads the caller's own command line and knows nothing about any
    application, which is what keeps it out of per-app profile territory.
    """
    if Path(command[0]).name != "flatpak" or "run" not in command:
        return
    missing = [f for f in FLATPAK_FLAGS
               if not any(arg.startswith(f) for arg in command)]
    if missing:
        note(f"this is a Flatpak target and the command is missing: "
             f"{', '.join(missing)}")
        note("  A missing one can send it to your real compositor instead, "
             "leaving this")
        note("  recording empty. README.md says what each flag is for.")


def prepare(a, suffix):
    """What `record` and `shot` both check before starting anything: the tools,
    the app command, the size, and where the output and the app log go."""
    recording = suffix == ".mp4"
    required = ["ffmpeg", "xdotool", "xauth"]
    if a.gpu:
        required += ["cage", "Xwayland", "wlr-randr"]
        required += ["wf-recorder"] if recording else []
    else:
        required.append("Xvfb")
    missing = [t for t in required if shutil.which(t) is None]
    if missing:
        die(f"missing required program(s): {', '.join(missing)}")
    if recording and a.gpu and a.cursor:
        die("--cursor is not available with record --gpu: that backend records "
            "the compositor's picture, which never has the pointer in it.")

    command = list(a.command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        die(f"give the app to run after `--`, e.g. demoreel {a.cmd} -- xclock")
    warn_if_flatpak_underflagged(command)

    match = SIZE_RE.match(a.size)
    if not match:
        die(f"--size must look like 1600x1000, not {a.size!r}")
    width, height = int(match[1]), int(match[2])
    if suffix == ".mp4" and (width % 2 or height % 2):
        die("--size needs even numbers; H.264 cannot encode an odd width or height.")

    if a.output:
        output = Path(a.output).expanduser().resolve()
    else:
        stem = re.sub(r"[^A-Za-z0-9._-]", "_", Path(command[0]).name) or "demo"
        output = Path.cwd() / f"{stem}-{time.strftime('%Y%m%d-%H%M%S')}{suffix}"
    output.parent.mkdir(parents=True, exist_ok=True)

    applog = Path(a.app_log).expanduser().resolve() if a.app_log else None
    if applog:
        applog.parent.mkdir(parents=True, exist_ok=True)
    return command, width, height, output, applog


def park_pointer(env, width, height):
    """Put the pointer in the bottom-right corner. A fresh display starts it
    at the centre, where it lights up whatever the app draws under it before
    any step runs, drawn pointer or not (DEMO-0103)."""
    xdotool(env, "mousemove", width - 1, height - 1)


def launch(a, command, width, height, base, displaylog, appout):
    """Start the private display and the app on it.

    Returns (server, app, display, auth, env, wayland). server is Xvfb, or on
    --gpu the cage that holds Xwayland, and ends with end_server. wayland is
    cage's socket name on --gpu, which only the recorder uses, and None on
    Xvfb. Both backends start the app afterwards, so the pointer is parked
    before the app first sees it. Nothing is left running if the app cannot
    be started.
    """
    if a.gpu:
        server, display, auth, wayland = start_gpu_display(width, height, base,
                                                           displaylog)
    else:
        server, display, auth = start_xvfb(width, height, base, displaylog)
        wayland = None
    env = dict(os.environ, DISPLAY=display, WAYLAND_DISPLAY=NO_WAYLAND,
               XAUTHORITY=str(auth))
    park_pointer(env, width, height)
    try:
        app = subprocess.Popen(command, env=env, start_new_session=True,
                               stdout=appout, stderr=subprocess.STDOUT)
    except (FileNotFoundError, PermissionError) as exc:
        end_server(server)
        auth.unlink(missing_ok=True)
        die(f"could not run {command[0]!r}: {exc.strerror}.")
    return server, app, display, auth, env, wayland


def end_server(server):
    """End the display. On --gpu that is cage, in a session of its own, and
    the group goes so Xwayland goes with it; Xvfb shares ours and must not."""
    if server is not None:
        end_process(server, group=server.args[0] == "cage")


def place_window(env, app, a, width, height, going_on):
    """Find the app's window and make it fill the frame; None if none appeared."""
    window = wait_for_window(env, app, a.startup_timeout)
    if window is None:
        note(f"no window appeared within {a.startup_timeout}s; {going_on} anyway.")
    else:
        # No window manager runs here, so no windowactivate: the only
        # window already has focus.
        xdotool(env, "windowmove", window, 0, 0)
        xdotool(env, "windowsize", window, width, height)
        wait_for_size(env, window, width * height)
    return window


def blank_causes(gpu):
    """What usually made the display blank, for the backend that ran. On
    --gpu the first Xvfb cause cannot apply, and telling that run to use
    --gpu was advice to do what it had just done (DEMO-0110)."""
    first = ("  - It had not drawn yet. A GPU app can spend seconds on a black\n"
             "    screen while it starts: --settle waits for the first picture.\n"
             if gpu else
             "  - It needs the GPU, and Xvfb has none. An OpenGL or Vulkan app\n"
             "    cannot render on it at all: record it with --gpu instead.\n")
    return ("  The app ran but drew nothing here. Two causes account for most of it:\n"
            + first
            + "  - It rendered somewhere else. A Flatpak needs --nosocket=wayland on\n"
            "    its command line; see README.md.")


def cmd_record(a):
    command, width, height, output, applog = prepare(a, ".mp4")

    for sig in (signal.SIGUSR1, signal.SIGINT, signal.SIGTERM):
        signal.signal(sig, _request_stop)

    # The run is addressable from here, before anything slow happens, so a
    # `stop` issued straight after launching it finds it (DEMO-0034). Holding
    # the name makes any state file already there a dead run's, so it is
    # simply replaced. "recording" flips to true once ffmpeg has its first
    # frame; `stop` waits for that rather than ending a run with no video.
    # "result" is written as "ok" just before the path is printed, and the
    # file is left in place so `stop` can read it after this process has gone
    # (DEMO-0047). A run that fails never writes it.
    claim_name(a.name)
    statefile = state_dir() / f"{a.name}.json"
    state = {"name": a.name, "pid": os.getpid(),
             "starttime": proc_starttime(os.getpid()),
             "output": str(output), "recording": False}

    logpath = state_dir() / f"{a.name}.ffmpeg.log"
    displaylog = state_dir() / f"{a.name}.display.log"
    # The app's own output goes to our stderr, or to --app-log, but never to
    # our stdout: this command prints the finished path and nothing else, and a
    # caller writing `out=$(demoreel record ...)` must not collect the app's
    # chatter along with it. Worth keeping somewhere when the app says whether
    # what it drew was the real thing — a wrong-but-not-blank recording passes
    # every check this tool can make.
    # Deliberate: as above - closed in the finally block, not here.
    appout = open(applog, "wb") if applog else sys.stderr  # noqa: SIM115
    server = app = recorder = log = auth = None
    blank = None  # when the display was found blank: "halfway" or "at the end"
    unsampled = None
    # When each display sample was taken, as (when, seconds into the video):
    # record --gpu asks the finished file the same question at the same
    # moments, so the skips that decided whether a sample was taken carry
    # over. None means the end of the video.
    sampled = []
    moved = None  # how the window stopped filling the frame, said once
    try:
        write_state(statefile, state)
        server, app, display, auth, env, wayland = launch(
            a, command, width, height, state_dir() / a.name, displaylog, appout)
        window = place_window(env, app, a, width, height, "recording")

        try:
            drawn = not a.settle or wait_until_drawn(env, display, width,
                                                     height, a.settle)
        except SampleError as exc:
            die(f"--settle could not sample the display, so it cannot tell "
                f"when the app has drawn.\n  {exc}")
        if not drawn:
            note(f"nothing was drawn within {a.settle}s; recording anyway.")

        if a.gpu:
            recorder, log = start_wf_recorder(env, wayland, a.framerate,
                                              output, logpath)
        else:
            recorder, log = start_ffmpeg(env, display, width, height,
                                         a.framerate, output, logpath, a.cursor)
        started = time.monotonic()
        write_state(statefile, dict(state, display=display, recording=True))
        note(f"recording {display} to {output} "
             f"({'until stopped' if a.duration == 0 else f'{a.duration}s'})")

        for action in a.action:
            if _stop:
                break
            run_action(action, env)

        deadline = time.monotonic() + a.duration if a.duration else None
        # A second look, halfway through the countdown (DEMO-0008). The end
        # sample alone passes an app that draws only in the final moments,
        # which is a video mostly empty. Blank at halfway means at least half
        # of the countdown is empty, and the run fails there rather than
        # recording the rest. A -d 0 run has no halfway point.
        halfway = deadline - a.duration / 2 if deadline else None
        while not _stop:
            now = time.monotonic()
            if deadline and now >= deadline:
                break
            if halfway and now >= halfway:
                halfway = None
                if app.poll() is None:
                    if window is not None:
                        moved = window_off_frame(env, window, width, height)
                        if moved:
                            note(moved)
                    sampled.append(("halfway", now - started))
                    try:
                        if display_is_blank(env, display, width, height):
                            blank = "halfway"
                            break
                    except SampleError as exc:
                        unsampled = str(exc)
                        break
            if recorder.poll() is not None:
                note(f"the recorder stopped early; see {logpath}")
                break
            if app.poll() is not None:
                note("the app closed; ending the recording.")
                break
            # Never sleep past the deadline: a fixed interval here added up to
            # its own length to every video.
            time.sleep(0.2 if deadline is None
                       else max(0.0, min(0.2, deadline - time.monotonic())))

        # Stop recording before sampling. The display does not change when the
        # recorder stops, and sampling first put a third of a second of
        # overshoot into every video (DEMO-0012).
        stop_recorder(recorder)
        # Only meaningful while the app is still up: one that closed itself
        # mid-run leaves an empty display behind, and that video is fine.
        if moved is None and window is not None and app.poll() is None:
            moved = window_off_frame(env, window, width, height)
            if moved:
                note(moved)
        if blank is None and unsampled is None and app.poll() is None:
            sampled.append(("at the end", None))
            try:
                if display_is_blank(env, display, width, height):
                    blank = "at the end"
            except SampleError as exc:
                unsampled = str(exc)
    finally:
        # Order matters: finish the video before the app and display go away,
        # or the last frames catch a half-dead app.
        if recorder is not None:
            stop_recorder(recorder)
        if log is not None:
            log.close()
        if appout is not sys.stderr:
            appout.close()
        end_process(app, group=True)
        end_server(server)
        if auth is not None:
            auth.unlink(missing_ok=True)
        if a.gpu:
            finish_gpu_video(output, logpath)

    if not output.exists() or output.stat().st_size == 0:
        die(f"no video was written to {output}. See {logpath}")
    if blank:
        what = ("so at least half of it is a flat colour" if blank == "halfway"
                else "so it ends on a flat colour")
        die(f"the virtual display was blank {blank}, {what}: {output}\n"
            + blank_causes(a.gpu))
    if unsampled is not None:
        die(f"could not sample the virtual display to check {output} is not blank,\n"
            f"  so this run cannot vouch for it.\n  {unsampled}")
    if a.gpu:
        for when, at in sampled:
            try:
                flat = video_is_blank(output, at, width, height)
            except SampleError as exc:
                die(f"could not read {output} back to check it is not blank,\n"
                    f"  so this run cannot vouch for it.\n  {exc}")
            if flat:
                die(f"the video is a flat colour {when}, though the private "
                    f"screen was not: {output}\n  The recorder captured "
                    f"something other than the screen. See {logpath}")
        share = changed_share(output, a.framerate)
        if share is not None and share < CHANGED_NOTE_BELOW:
            note(f"only {share:.0%} of the frames in the middle of {output} "
                 f"changed from the one before.\n  If the app was moving the "
                 f"whole time, it drew that few new frames itself: the video "
                 f"has every frame it drew.")
    for stale in (logpath, displaylog):
        stale.unlink(missing_ok=True)  # only worth keeping when something failed
    write_state(statefile, dict(state, result="ok"))
    print(output)


def take_picture(env, display, width, height, cursor, output, gpu):
    """Save one PNG of the display and check it; the reason it failed, or None.

    The check reads the saved file back rather than grabbing a second frame, so
    the picture judged is the picture handed over. The test is frame_is_flat,
    the same one that judges a recording.
    """
    grab = subprocess.run(  # noqa: PLW1510 - a failed grab is handled below
        ["ffmpeg", "-hide_banner", "-loglevel", "error",
         "-f", "x11grab", "-draw_mouse", "1" if cursor else "0",
         "-video_size", f"{width}x{height}", "-i", f"{display}.0",
         "-frames:v", "1", "-y", str(output)],
        env=env, capture_output=True, timeout=CALL_TIMEOUT)
    if grab.returncode != 0 or not output.exists():
        tail = grab.stderr.decode(errors="replace").strip().splitlines()[-3:]
        return "could not take the picture.\n  " + "\n  ".join(tail)
    gray = subprocess.run(  # noqa: PLW1510 - a failed read is handled below
        ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", str(output),
         "-pix_fmt", "gray", "-f", "rawvideo", "-"],
        capture_output=True, timeout=CALL_TIMEOUT)
    if gray.returncode != 0 or len(gray.stdout) != width * height:
        return f"could not read back {output} to check it is not blank."
    if frame_is_flat(gray.stdout):
        return f"the picture is one flat colour: {output}\n" + blank_causes(gpu)
    return None


def cmd_shot(a):
    """One picture of the app, on the same private display `record` uses.

    No name and no state file: there is nothing to stop, so a shot keeps its
    files in a folder of its own and `stop` never sees it. The folder goes when
    the shot succeeds and is kept, and named, when it fails.
    """
    command, width, height, output, applog = prepare(a, ".png")
    rundir = Path(tempfile.mkdtemp(prefix="shot-", dir=state_dir()))
    displaylog = rundir / "display.log"
    # Deliberate: closed in the finally block, as in cmd_record.
    appout = open(applog, "wb") if applog else sys.stderr  # noqa: SIM115
    server = app = auth = None
    try:
        server, app, display, auth, env, _ = launch(a, command, width, height,
                                                    rundir / "shot", displaylog,
                                                    appout)
        window = place_window(env, app, a, width, height, "taking the picture")
        try:
            drawn = wait_until_drawn(env, display, width, height, a.settle)
        except SampleError as exc:
            die(f"--settle could not sample the display, so it cannot tell "
                f"when the app has drawn.\n  {exc}")
        if not drawn:
            note(f"nothing was drawn within {a.settle}s; taking the picture anyway.")
        for action in a.action:
            run_action(action, env)
        if window is not None:
            moved = window_off_frame(env, window, width, height)
            if moved:
                note(moved)
        failed = take_picture(env, display, width, height, a.cursor, output,
                              a.gpu)
    except subprocess.TimeoutExpired:
        failed = (f"could not take the picture: the display did not answer "
                  f"within {CALL_TIMEOUT}s.")
    except SystemExit as exc:
        # Every die() above lands here, so every failure names the folder it
        # keeps -- which is in RAM, under /run/user (DEMO-0107).
        raise SystemExit(f"{exc.code}\n  Its display log is kept in {rundir}") from None
    finally:
        if appout is not sys.stderr:
            appout.close()
        end_process(app, group=True)
        end_server(server)
        if auth is not None:
            auth.unlink(missing_ok=True)
    if failed:
        die(f"{failed}\n  Its display log is kept in {rundir}")
    shutil.rmtree(rundir, ignore_errors=True)
    print(output)


# How long `stop` looks for a run before saying there is none. A run registers
# itself before anything slow, but not before Python has started, so a stop
# launched on the very next line of a script can still arrive first -- measured
# on the second of ten back-to-back tries. A second is far more than that
# startup, and it is only ever spent when the answer is going to be "none".
STOP_GRACE = 1.0


def live_runs():
    """Every run whose state file names a process that is still that run.

    A dead run's file is left where it is. The next run of that name replaces
    it under the name lock, and removing it here could race that run and
    delete the file it has just written.
    """
    live = []
    for f in sorted(state_dir().glob("*.json")):
        try:
            entry = json.loads(f.read_text())
        except (OSError, ValueError):
            continue  # gone since the glob, or not ours to read
        if isinstance(entry, dict) and is_our_run(entry):
            live.append(entry)
    return live


def cmd_stop(a):
    deadline = time.monotonic() + STOP_GRACE
    while True:
        live = live_runs()
        if a.name:
            live = [e for e in live if e.get("name") == a.name]
        if live or time.monotonic() >= deadline:
            break
        time.sleep(0.05)

    if a.name:
        if not live:
            die(f"no recording named {a.name!r} is running.")
    elif not live:
        die("no recording is running.")
    elif len(live) > 1:
        names = ", ".join(sorted(e["name"] for e in live))
        die(f"{len(live)} recordings are running: {names}.\n"
            f"  Name the one to stop, e.g. demoreel stop {min(e['name'] for e in live)}")

    for found in live:
        entry = wait_until_recording(found)
        os.kill(entry["pid"], signal.SIGUSR1)
        if not run_succeeded(entry):
            die("the recording failed after it was stopped, so there is no "
                "video to hand back.\n  Its own error message says why.")
        print(entry["output"])


def run_succeeded(entry):
    """Wait for a stopped run to exit, then say whether it succeeded.

    A stopped run still has work to do: finish the video, then check the
    display was not blank. Printing its path before that handed the caller a
    half-written file, or a path for a run that went on to fail (DEMO-0047).
    The run writes "result": "ok" to its state file just before it prints its
    own path. Anything else -- a failure, a kill, the file already replaced by
    a later run of the same name -- is not a success.
    """
    pid = entry["pid"]
    # A zombie keeps its pid and start time until whatever started it reaps
    # it, which may be the same script that is waiting on this stop.
    while is_our_run(entry) and proc_stat(pid, 3) != "Z":
        time.sleep(0.05)
    try:
        final = json.loads((state_dir() / f"{entry['name']}.json").read_text())
    except (OSError, ValueError):
        return False
    return (isinstance(final, dict) and final.get("pid") == pid
            and final.get("starttime") == entry.get("starttime")
            and final.get("result") == "ok")


def wait_until_recording(entry):
    """Hold a stop aimed at a run that is still starting, until it records.

    A run is addressable from its first moment, but stopping it before ffmpeg
    has a frame would leave no video at all -- and stop's one line of stdout
    is a video path. So wait, and stop it the moment it is recording. That
    gives a very short video rather than none (DEMO-0034).

    No timeout of its own: the run has its own startup timeouts, and it
    either starts recording or exits. A run that exits first is reported as
    such, since there is no path to print.
    """
    statefile = state_dir() / f"{entry['name']}.json"
    pid = entry["pid"]
    # A file written by 0.1.x has no "recording" key, and existed only once
    # that run was already recording.
    while not entry.get("recording", True):
        time.sleep(0.05)
        try:
            entry = json.loads(statefile.read_text())
        except (OSError, ValueError):
            entry = {}
        # Same pid, or a new run that took the name after this one died would
        # be stopped in its place.
        if (not isinstance(entry, dict) or entry.get("pid") != pid
                or not is_our_run(entry)):
            die("the recording ended before it started recording, so there "
                "is no video to stop.")
    return entry


def main():
    parser = argparse.ArgumentParser(
        prog="demoreel",
        description="Record a GUI app on a private virtual display, so nothing "
                    "of your real desktop is in frame.")
    parser.add_argument("--version", action="version",
                        version=f"demoreel {__version__}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    rec = sub.add_parser("record", help="record an app and write a video file")
    rec.add_argument("-o", "--output",
                     help="video file to write (default: "
                          "./<app>-<timestamp>.mp4)")
    rec.add_argument("-d", "--duration", type=float, default=30,
                     help="seconds to record; 0 means until `demoreel stop` "
                          "(default: 30)")
    rec.add_argument("-s", "--size", default="1600x1000",
                     help="virtual display size, even numbers (default: 1600x1000)")
    rec.add_argument("-r", "--framerate", type=int, default=30,
                     help="frames per second (default: 30)")
    rec.add_argument("-n", "--name", default="default",
                     help="name for this run, so `demoreel stop` can find it "
                          "(default: default)")
    rec.add_argument("-a", "--action", action="append", default=[], metavar="ACTION",
                     help="scripted step, repeatable and run in order: "
                          "'wait 2', 'move X Y', 'click [X Y]', 'type some text', "
                          "'key Return'")
    rec.add_argument("--app-log", metavar="PATH",
                     help="keep the app's own output in PATH; otherwise it goes "
                          "to this terminal's stderr. Useful when the app prints "
                          "whether it drew the real thing, which no recording "
                          "check here can tell")
    rec.add_argument("--settle", type=float, default=0, metavar="SECONDS",
                     help="wait up to SECONDS for the app to draw its first "
                          "frame before recording starts, instead of filming "
                          "its startup black screen (default: 0, don't wait)")
    rec.add_argument("--gpu", action="store_true",
                     help="for an app that needs the graphics card (OpenGL, "
                          "Vulkan): record it on a headless compositor instead "
                          "of Xvfb, which has no GPU. Needs cage, Xwayland, "
                          "wlr-randr and wf-recorder; not with --cursor")
    rec.add_argument("--cursor", action="store_true",
                     help="show the mouse pointer; off by default, since with no "
                          "actions it just sits in the corner")
    rec.add_argument("--startup-timeout", type=float, default=20, metavar="SECONDS",
                     help="how long to wait for the app's window (default: 20)")
    rec.add_argument("command", nargs=argparse.REMAINDER,
                     help="-- followed by the command that starts the app")
    rec.set_defaults(func=cmd_record)

    # The options `record` takes, less the ones about time and names: a shot
    # has no duration, no frame rate and nothing to stop (README, Taking a
    # picture). --settle defaults to 10 here, since a picture of a startup
    # screen is never what anyone wanted.
    shot = sub.add_parser("shot", help="take one picture of an app and write a PNG")
    shot.add_argument("-o", "--output",
                      help="picture file to write (default: "
                           "./<app>-<timestamp>.png)")
    shot.add_argument("-s", "--size", default="1600x1000",
                      help="virtual display size (default: 1600x1000)")
    shot.add_argument("-a", "--action", action="append", default=[],
                      metavar="ACTION",
                      help="scripted step run before the picture, repeatable: "
                           "'wait 2', 'move X Y', 'click [X Y]', "
                           "'type some text', 'key Return'")
    shot.add_argument("--app-log", metavar="PATH",
                      help="keep the app's own output in PATH; otherwise it "
                           "goes to this terminal's stderr")
    shot.add_argument("--settle", type=float, default=10, metavar="SECONDS",
                      help="wait up to SECONDS for the app to draw before the "
                           "steps and the picture (default: 10)")
    shot.add_argument("--gpu", action="store_true",
                      help="for an app that needs the graphics card: use a "
                           "headless compositor instead of Xvfb. Needs "
                           "cage, Xwayland and wlr-randr")
    shot.add_argument("--cursor", action="store_true",
                      help="show the mouse pointer in the picture")
    shot.add_argument("--startup-timeout", type=float, default=20,
                      metavar="SECONDS",
                      help="how long to wait for the app's window (default: 20)")
    shot.add_argument("command", nargs=argparse.REMAINDER,
                      help="-- followed by the command that starts the app")
    shot.set_defaults(func=cmd_shot)

    stop = sub.add_parser("stop", help="end a running recording early")
    stop.add_argument("name", nargs="?", help="which run to stop (default: the "
                                              "only one running)")
    stop.set_defaults(func=cmd_stop)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
