msgstr "зберегти один кадр відео як зображення."

#. argparse formats this text with %
msgid "picture file to write, ending in .png or .jpg (default: ./<input>-<timestamp>{ending})"
msgstr "файл зображення для запису, із закінченням .png або .jpg (типово: ./<input>-<timestamp>{ending})"

#. argparse formats this text with %
