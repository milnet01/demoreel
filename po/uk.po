msgstr "який запуск зупинити (типово: єдиний, що виконується)"

#. argparse formats this text with %
msgid "video file to write, ending in .mp4 (default: ./<input>-<timestamp>.mp4)"
msgstr "відеофайл для запису, із закінченням .mp4 (типово: ./<input>-<timestamp>.mp4)"

#. argparse formats this text with %
