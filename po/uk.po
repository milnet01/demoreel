msgstr "відео, з якого треба взяти кадр"

#. argparse formats this text with %
msgid "which moment to save"
msgstr "який момент зберегти"

msgid "--region takes x,y,w,h in whole pixels, with w and h above 0, like 0,0,640,400, not {region}."
msgstr "--region приймає x,y,w,h у цілих пікселях, де w і h більші за 0, наприклад 0,0,640,400, а не {region}."

