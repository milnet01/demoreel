msgstr "середній рівень музики, у dB (типово: {level})"

#. argparse formats this text with %
msgid "the music arrives over SECONDS (default: {seconds})"
msgstr "музика наростає протягом SECONDS (типово: {seconds})"

#. argparse formats this text with %
