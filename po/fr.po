msgstr "passer de chaque vidéo à la suivante en fondu sur SECONDS (par défaut : une coupe simple)"

#. argparse formats this text with %
msgid "make a clip from a picture, or from text"
msgstr "créer un clip à partir d'une image ou d'un texte"

#. argparse formats this text with %
msgid "make a clip from a picture, or from text."
msgstr "créer un clip à partir d'une image ou d'un texte."

#. argparse formats this text with %
msgid "a picture to show; a .gif or an animated .png plays"
msgstr "une image à afficher ; un .gif ou un .png animé est joué"

#. argparse formats this text with %
msgid "how many seconds the card lasts"
msgstr "durée du carton en secondes"

#. argparse formats this text with %
msgid "one line of text"
msgstr "une ligne de texte"

#. argparse formats this text with %
msgid "the text's height, as a percentage of the frame's (default: {size})"
msgstr "la hauteur du texte, en pourcentage de celle de l'image (par défaut : {size})"

#. argparse formats this text with %
msgid "the background colour (default: {colour})"
msgstr "la couleur de fond (par défaut : {colour})"

#. argparse formats this text with %
msgid "take the size and frame rate from this video"
msgstr "prendre la taille et la fréquence d'images de cette vidéo"

#. argparse formats this text with %
msgid "the picture size, like 1280x800 (default: 1600x1000)"
msgstr "la taille de l'image, comme 1280x800 (par défaut : 1600x1000)"

#. argparse formats this text with %
msgid "report how smooth a video is and where it stands still"
msgstr "indiquer la fluidité d'une vidéo et où elle reste figée"

#. argparse formats this text with %
msgid "report how smooth a video is and where it stands still."
msgstr "indiquer la fluidité d'une vidéo et où elle reste figée."

#. argparse formats this text with %
msgid "the video to look at"
msgstr "la vidéo à examiner"

#. argparse formats this text with %
msgid "look from here (default: the start)"
msgstr "examiner à partir d'ici (par défaut : le début)"

#. argparse formats this text with %
msgid "look up to here (default: the end)"
msgstr "examiner jusqu'ici (par défaut : la fin)"

#. argparse formats this text with %
msgid "report a stretch with no change longer than this (default: 1)"
msgstr "signaler un passage sans changement plus long que ceci (par défaut : 1)"

#. argparse formats this text with %
