msgstr "de video om te knippen"

#. argparse formats this text with %
msgid "where the kept part starts (default: the start)"
msgstr "waar het bewaarde deel begint (standaard: het begin)"

#. argparse formats this text with %
msgid "the last moment kept (default: the end)"
msgstr "het laatste moment dat bewaard blijft (standaard: het einde)"

#. argparse formats this text with %
msgid "fade to black and back around this moment; repeatable"
msgstr "rond dit moment naar zwart en terug vervagen; herhaalbaar"

#. argparse formats this text with %
msgid "how long each half of a --fade-at takes (default: {seconds})"
msgstr "hoe lang elke helft van een --fade-at duurt (standaard: {seconds})"

#. argparse formats this text with %
msgid "put text over part of a video"
msgstr "tekst over een deel van een video zetten"

#. argparse formats this text with %
